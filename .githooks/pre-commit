#!/usr/bin/env sh
set -e

if [ "${SKIP_VERSION_BUMP:-0}" = "1" ]; then
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
if [ "$BRANCH" = "main" ]; then
  if ! node scripts/bump-version.mjs --check-staged >/dev/null 2>&1; then
    echo "[pre-commit] Stage a package.json version bump before committing to main:" >&2
    echo "  npm run version:bump                       # patch: fixes and small changes" >&2
    echo "  npm run version:bump -- --minor            # substantial content changes" >&2
    echo "  git add package.json" >&2
    exit 1
  fi
fi
