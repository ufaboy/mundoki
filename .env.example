# GEMINI_API_KEY: Required if Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Local development: http://localhost:3333 (or leave MY_APP_URL to use the request origin).
APP_URL="MY_APP_URL"
BETTER_AUTH_URL="http://localhost:3333"

# BETTER_AUTH_SECRET: Secret key for session token signing
BETTER_AUTH_SECRET="dev-secret-replace-in-production"

# OAuth 2.0 Providers (Google, Facebook & Apple)
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/<google|facebook|apple>
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""
APPLE_APP_BUNDLE_IDENTIFIER=""

# Magic Link Email Delivery (Resend API)
# When RESEND_API_KEY is empty, Magic Links are shown in the labeled Development Email Outbox.
RESEND_API_KEY=""
EMAIL_FROM="Mundoki <no-reply@mundoki.app>"

# Mercado Pago Recurring Subscription Configuration (Argentina - ARS)
# When MP_ACCESS_TOKEN is not set, Mundoki uses the explicitly labeled Development Sandbox Mock Provider.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
PREMIUM_MONTHLY_ARS="9999"

# Personal promotions: administrative access is stored in users.role, never in public configuration.
# Can reduce the allowed duration; the code and database enforce an absolute six-month cap.
PROMO_MAX_MONTHS="6"
# Enable only after testing the Mercado Pago promo schedule and price transition in your account.
PROMO_LIVE_BILLING_ENABLED="false"
