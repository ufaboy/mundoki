---
import AppLayout from '../../layouts/AppLayout.astro';
import LoginPortal from '../../components/shared/LoginPortal.astro';
import { buildLoginUrl, normalizeUrlLocale } from '../../i18n/routes';
import { redirectIfAuthenticated } from '../../lib/server/authGuard';

export const prerender = false;

const locale = normalizeUrlLocale(Astro.params.locale);
const otherLocale = locale === 'es-AR' ? 'en-US' : 'es-AR';

const redirectTarget = await redirectIfAuthenticated(Astro.request, Astro.url, locale);
if (redirectTarget) {
  return Astro.redirect(redirectTarget, 302);
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<AppLayout
  title={locale === 'es-AR' ? 'Entrar' : 'Sign in'}
  locale={locale}
  activeNav="account"
  switchLocaleHref={buildLoginUrl(otherLocale)}
>
  <LoginPortal locale={locale} />
</AppLayout>
