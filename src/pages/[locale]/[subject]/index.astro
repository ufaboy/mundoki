---
import AppLayout from '../../../layouts/AppLayout.astro';
import TomiCharacter from '../../../components/learn/TomiCharacter.astro';
import { buildCatalogUrl, buildGradeUrl, buildLearnTopicUrl, buildPlayUrl, normalizeUrlLocale } from '../../../i18n/routes';
import { GRADES_CATALOG } from '../../../math/curriculum';
import { TOPICS_CATALOG } from '../../../math/topics/generators';
export const prerender = true;
export function getStaticPaths() {
 return [{params:{locale:'es-ar',subject:'matematicas'}},{params:{locale:'en-us',subject:'mathematics'}}];
}
const locale=normalizeUrlLocale(Astro.params.locale);
const es=locale==='es-AR';
const primary=GRADES_CATALOG.filter(g=>g.gradeNumber<=7);
const secondary=GRADES_CATALOG.filter(g=>g.gradeNumber>=8);
const names=[
 ['Un día con Tomi','A day with Tomi'],
 ['Seis amigos y un mago','Six friends and a wizard'],
 ['Construí tu ciudad','Build your city'],
 ['La isla de los inventores','Island of Inventors'],
 ['Expedición lunar','Moon Expedition'],
 ['Carreras de matemática','Math Racing'],
 ['Parque del Futuro','Park of the Future'],
];
const descriptions=[
 ['Salí a jugar y ayudá a Tomi.','Go out to play and help Tomi.'],
 ['Resolvé desafíos y liberá a tus amigos.','Solve challenges and free your friends.'],
 ['Creá un barrio y ayudá a sus vecinos.','Create a neighborhood and help its people.'],
 ['Construí una base y explorá la isla.','Build a base and explore the island.'],
 ['Construí tu cohete y viajá a la Luna.','Build your rocket and fly to the Moon.'],
 ['Pilotá a Chispa y ganá la Copa.','Drive Chispa and win the Copa.'],
 ['Diseñá un parque y abrí la gran feria.','Design a park and open the grand fair.'],
];
const symbols=['','','🏘','🏝','🚀','🤿','🎡'];
---
<AppLayout legacyContent title={es?'Elegí tu aventura matemática':'Choose your math adventure'} description={es?'Elegí tu grado para jugar, explorar y aprender matemática.':'Choose your grade to play, explore, and learn math.'} locale={locale} activeNav="learn" switchLocaleHref={buildCatalogUrl(es?'en-US':'es-AR')}>
 <div class="math-welcome">
  <header class="math-welcome-hero"><div><p class="math-welcome-eyebrow">{es?'UN POCO DE CURIOSIDAD. MUCHAS IDEAS.':'A LITTLE CURIOSITY. LOTS TO DISCOVER.'}</p><h1>{es?'¿Jugamos con la matemática?':'Let’s play with math!'}</h1><p>{es?'Elegí tu grado. Hay algo nuevo por descubrir.':'Choose your grade. There’s something new to discover.'}</p></div><div class="math-welcome-doodles" aria-hidden="true"><span>2 + 3</span><span>★</span><span>△</span><span>5</span></div></header>
  <section class="math-primary" aria-labelledby="math-choose-grade"><div class="math-welcome-section"><h2 id="math-choose-grade">{es?'¿En qué grado estás?':'Which grade are you in?'}</h2><span>{es?'Primaria · 1.º a 7.º':'Primary · Grades 1–7'}</span></div>
   <nav class="math-grade-shortcuts" aria-label={es?'Abrir mi grado':'Open my grade'}>{primary.map(grade=><a href={buildGradeUrl(locale,grade.id)} aria-label={es?`Abrir ${grade.gradeNumber}.º grado`:`Open Grade ${grade.gradeNumber}`} data-math-shortcut={grade.id}>{grade.gradeNumber}</a>)}</nav>
   <div class="math-grade-cards">{primary.map((grade,i)=><a href={buildGradeUrl(locale,grade.id)} class:list={['math-grade-card',`math-grade-${i+1}`,{'math-grade-featured':i<2}]} data-math-grade={grade.id}>
    <div class="math-grade-card-top"><span class="math-grade-number">{grade.gradeNumber}</span><span>{es?`${grade.gradeNumber}.º grado`:`Grade ${grade.gradeNumber}`}</span>{i<7 && <span class="math-adventure-label">{es?'Aventura':'Adventure'}</span>}</div>
    {i<2 ? <div class="math-grade-art" aria-hidden="true">{i===0?<><span class="math-tomi-sun"></span><span class="math-tomi-tree">🌳</span><TomiCharacter/><span class="math-tomi-ball">⚽</span></>:<><span class="math-quest-tower">🏰</span><span class="math-quest-wizard">🧙</span><span class="math-quest-friends">🐿️ 🦫 🦉 🐾 🦌 🐉</span></>}</div>:<div class="math-grade-symbol" aria-hidden="true">{symbols[i]}<span>✦</span></div>}
    <h3>{names[i][es?0:1]}</h3><p>{descriptions[i][es?0:1]}</p><span class="math-grade-open">{i<7?(es?'¡Vamos a jugar!':'Let’s play!'):(es?'Explorar':'Explore')} <span aria-hidden="true">→</span></span>
   </a>)}</div>
   <p class="math-welcome-note">{es?'Podés volver a un grado anterior para practicar. Aprendé a tu ritmo.':'You can revisit an earlier grade to practice. Learn at your own pace.'}</p>
  </section>
  <details class="math-more" id="secondary"><summary><span><strong>{es?'¿Ya estás en secundaria?':'Already in secondary school?'}</strong><span>{es?'Elegí tu año':'Choose your year'}</span></span><span aria-hidden="true">↓</span></summary><div class="math-secondary-links">{secondary.map(grade=><a href={buildGradeUrl(locale,grade.id)} data-math-grade={grade.id}><b>{grade.gradeNumber-7}</b><span>{es?`${grade.gradeNumber-7}.º año`:`Year ${grade.gradeNumber-7}`}</span><span aria-hidden="true">→</span></a>)}</div></details>
  <details class="math-more" id="topics"><summary><span><strong>{es?'Quiero practicar un tema':'I want to practice a topic'}</strong><span>{es?'Sumas, fracciones y más':'Addition, fractions, and more'}</span></span><span aria-hidden="true">↓</span></summary><ul class="math-topic-links">{TOPICS_CATALOG.map(topic=><li><strong>{topic.title[locale]}</strong><div><a href={buildLearnTopicUrl(locale,topic.id)}>{es?'Ver ejemplo':'See an example'}</a><a href={buildPlayUrl(locale,topic.id)}>{es?'Practicar':'Practice'} →</a></div></li>)}</ul></details>
  <details class="math-family" id="families"><summary>{es?'Para familias y docentes':'For families and teachers'}</summary><p>{es?'Elijan el grado escolar o repasen un grado anterior. Los siete grados de primaria tienen aventuras: desde un día con amigos hasta la construcción de un parque. Secundaria ofrece lecciones, modelos y práctica.':'Choose the school grade or review an earlier grade. All seven primary grades have adventures, from a day with friends to building a park. Secondary years offer lessons, models, and practice.'}</p><p>{es?'La organización usa la estructura de CABA: siete grados de primaria y cinco años de secundaria en el trayecto común. Las dos versiones de idioma muestran el mismo curso.':'The organization uses the CABA structure: seven primary grades and five secondary years in the standard track. Both language versions show the same course.'}</p></details>
 </div>
</AppLayout>
