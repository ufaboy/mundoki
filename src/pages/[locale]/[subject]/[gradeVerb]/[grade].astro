---
import ParkMap from '../../../../components/learn/ParkMap.astro';
import OceanMap from '../../../../components/learn/OceanMap.astro';
import MoonMap from '../../../../components/learn/MoonMap.astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SchoolCourseCatalog from '../../../../components/learn/SchoolCourseCatalog.astro';
import IslandMap from '../../../../components/learn/IslandMap.astro';
import CityMap from '../../../../components/learn/CityMap.astro';
import RoadTripMap from '../../../../components/learn/RoadTripMap.astro';
import DayMap from '../../../../components/learn/DayMap.astro';
import GradeHub from '../../../../components/learn/GradeHub.astro';
import MascotSvg from '../../../../components/play/MascotSvg.astro';
import { SCHOOL_COURSES } from '../../../../content/schoolCourses';
import { t } from '../../../../i18n/translations';
import { buildGradeUrl, buildLearnTopicUrl, buildPlayUrl, normalizeUrlLocale } from '../../../../i18n/routes';
import { getBlockById, GRADES_CATALOG, resolveGradeFromSlug } from '../../../../math/curriculum';

export const prerender = true;

export function getStaticPaths() {
  const paths: {
    params: { locale: string; subject: string; gradeVerb: string; grade: string };
  }[] = [];

  for (const grade of GRADES_CATALOG) {
    // Canonical localized grade slug routes
    paths.push({
      params: {
        locale: 'es-ar',
        subject: 'matematicas',
        gradeVerb: 'grado',
        grade: grade.slugEs,
      },
    });
    paths.push({
      params: {
        locale: 'en-us',
        subject: 'mathematics',
        gradeVerb: 'grade',
        grade: grade.slugEn,
      },
    });

    // Numeric shorthand routes (/es-ar/matematicas/grado/1/ and /en-us/mathematics/grade/1/)
    paths.push({
      params: {
        locale: 'es-ar',
        subject: 'matematicas',
        gradeVerb: 'grado',
        grade: `${grade.gradeNumber}`,
      },
    });
    paths.push({
      params: {
        locale: 'en-us',
        subject: 'mathematics',
        gradeVerb: 'grade',
        grade: `${grade.gradeNumber}`,
      },
    });
  }

  return paths;
}

const locale = normalizeUrlLocale(Astro.params.locale);
const currentGrade = resolveGradeFromSlug(Astro.params.grade || '');
const currentBlock = getBlockById(currentGrade.stage);
const course = SCHOOL_COURSES.find((c) => c.gradeId === currentGrade.id);
const otherLocale = locale === 'es-AR' ? 'en-US' : 'es-AR';
const switchHref = buildGradeUrl(otherLocale, currentGrade.id);
const n = currentGrade.gradeNumber;

// Pages already on the design system: grade 1 (a day with the hero), grade 3 (city world) and every grade
// without a world of its own (secundaria), which share the topic template.
// The other worlds still render their legacy pages until they are moved.
const onSystem = n === 1 || n === 3 || (n > 7 && !course);
const gradeLabel = currentGrade.labelShort[locale].replace('.°', '.º');
const gradeTheme = currentGrade.title[locale].split('·')[1]?.trim() || currentGrade.summary[locale];
---

<BaseLayout
  title={`${currentGrade.title[locale]} · ${currentBlock.title[locale]}`}
  description={currentGrade.summary[locale]}
  locale={locale}
  activeNav="learn"
  switchLocaleHref={switchHref}
  system={onSystem}
>
  {n === 1 ? <DayMap locale={locale} /> : n === 2 ? <RoadTripMap locale={locale} /> : n === 3 ? <CityMap locale={locale} /> : n === 4 ? <IslandMap locale={locale} /> : n === 5 ? <MoonMap locale={locale} /> : n === 6 ? <OceanMap locale={locale} /> : n === 7 ? <ParkMap locale={locale} /> : course ? <SchoolCourseCatalog locale={locale} course={course} /> : (
    <GradeHub
      locale={locale}
      gradeId={currentGrade.id}
      gradeLabel={gradeLabel}
      accent="var(--mk-grape)"
      title={gradeLabel}
      intro={gradeTheme}
      startHref={buildLearnTopicUrl(locale, currentGrade.primaryTopicId)}
      startLabel={t(locale, 'gradeStart')}
    >
      <MascotSvg slot="art" mood="happy" size={180} idPrefix="grade-atomo" />
      {currentGrade.lessons.map((unit, index) => (
        <article class="mk-card mk-unit">
          <span class="mk-mission__num" aria-hidden="true">{index + 1}</span>
          <div class="mk-stack mk-stack--tight">
            <h3 class="mk-heading">{unit.title[locale]}</h3>
            {unit.accessLevel !== 'free' && <span class="mk-chip mk-chip--grape" style="align-self:flex-start;">{t(locale, 'badgePremium')}</span>}
          </div>
          <div class="mk-unit__actions">
            <a class="mk-btn" href={buildLearnTopicUrl(locale, unit.linkedTopicId)}>{t(locale, 'gradeLearn')}</a>
            <a class="mk-btn" href={buildPlayUrl(locale, unit.linkedTopicId)}>
              <svg class="mk-icon mk-icon--fill" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
              {t(locale, 'gradePractice')}
            </a>
          </div>
        </article>
      ))}
    </GradeHub>
  )}
</BaseLayout>
