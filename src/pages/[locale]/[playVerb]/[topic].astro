---
import { buildTrainHubUrl, normalizeUrlLocale } from '../../../i18n/routes';
import { TOPICS_CATALOG } from '../../../math/topics/generators';

export const prerender = true;

export function getStaticPaths() {
  const paths: { params: { locale: string; playVerb: string; topic: string } }[] = [];
  for (const topic of TOPICS_CATALOG) {
    paths.push({ params: { locale: 'es-ar', playVerb: 'jugar', topic: topic.slugEs } });
    paths.push({ params: { locale: 'en-us', playVerb: 'play', topic: topic.slugEn } });
    if (topic.slugEs !== topic.id) {
      paths.push({ params: { locale: 'es-ar', playVerb: 'jugar', topic: topic.id } });
    }
  }
  return paths;
}

const locale = normalizeUrlLocale(Astro.params.locale);
return Astro.redirect(buildTrainHubUrl(locale), 301);
---
