---
import AppLayout from '../../../layouts/AppLayout.astro';
import PlayWorkspace from '../../../components/play/PlayWorkspace.astro';
import {
  buildPlayUrl,
  normalizeUrlLocale,
  resolveTopicFromSlug,
} from '../../../i18n/routes';
import { TOPICS_CATALOG } from '../../../math/topics/generators';

export const prerender = true;

export function getStaticPaths() {
  const paths: { params: { locale: string; playVerb: string; topic: string } }[] = [];
  for (const item of TOPICS_CATALOG) {
    paths.push({
      params: { locale: 'es-ar', playVerb: 'jugar', topic: item.slugEs },
    });
    paths.push({
      params: { locale: 'en-us', playVerb: 'play', topic: item.slugEn },
    });
    if (item.slugEs !== item.id) {
      paths.push({
        params: { locale: 'es-ar', playVerb: 'jugar', topic: item.id },
      });
    }
  }
  return paths;
}

const locale = normalizeUrlLocale(Astro.params.locale);
const topicId = resolveTopicFromSlug(Astro.params.topic || '');
const otherLocale = locale === 'es-AR' ? 'en-US' : 'es-AR';
const switchHref = buildPlayUrl(otherLocale, topicId);
const topicMeta = TOPICS_CATALOG.find((t) => t.id === topicId) || TOPICS_CATALOG[0];
---

<AppLayout legacyContent
  title={`${topicMeta.title[locale]} · ${locale === 'es-AR' ? 'Aventura' : 'Adventure'}`}
  locale={locale}
  activeNav="play"
  switchLocaleHref={switchHref}
>
  <PlayWorkspace locale={locale} topicId={topicId} />
</AppLayout>
