---
import AppLayout from '../../layouts/AppLayout.astro';
import AccountPortal from '../../components/shared/AccountPortal.astro';
import { buildAccountUrl, normalizeUrlLocale } from '../../i18n/routes';

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { locale: 'es-ar' } }, { params: { locale: 'en-us' } }];
}

const locale = normalizeUrlLocale(Astro.params.locale);
const otherLocale = locale === 'es-AR' ? 'en-US' : 'es-AR';
---

<AppLayout
  title={locale === 'es-AR' ? 'Cuenta de la familia' : 'Family account'}
  locale={locale}
  activeNav="account"
  switchLocaleHref={buildAccountUrl(otherLocale)}
>
  <AccountPortal locale={locale} />
</AppLayout>
