---
import AppLayout from '../../../layouts/AppLayout.astro';
import { buildLoginUrl, normalizeUrlLocale } from '../../../i18n/routes';
import { promoText } from '../../../i18n/promos';
import { requireAdminAccount } from '../../../lib/server/authGuard';

export const prerender = false;

const locale = normalizeUrlLocale(Astro.params.locale);
const auth = await requireAdminAccount(Astro.request, locale);
if ('redirect' in auth) {
  return Astro.redirect(auth.redirect, 302);
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
const tr = (key: string) => promoText(locale, key);
---
<AppLayout title={tr('title')} locale={locale} switchLocaleHref={`/${locale === 'es-AR' ? 'en-us' : 'es-ar'}/admin/promos`} legacyContent>
  <div id="promo-admin" data-locale={locale} class="article-container stack-lg">
    <header class="card stack-sm"><div class="kicker">Mundoki · Admin</div><h1>{tr('title')}</h1><p>{tr('intro')}</p></header>
    <p id="promo-admin-message" role="status" aria-live="polite"></p>
    <a id="promo-admin-signin" href={buildLoginUrl(locale)}>{tr('sign_in')}</a>
    <div id="promo-admin-content" hidden class="stack-lg">
      <p id="promo-billing-warning" class="callout callout-amber" hidden>{tr('previewOnly')}</p>
      <form id="promo-create" class="card stack-md">
        <label>{tr('email')}<input class="input-field" name="recipientEmail" type="email" required maxlength="254" autocomplete="off" /></label>
        <label>{tr('label')}<input class="input-field" name="label" maxlength="120" /></label>
        <div class="promo-form-grid">
          <label>{tr('discount')}<input class="input-field" name="discountPercent" type="number" min="10" max="100" step="1" value="50" list="promo-discount-presets" required /></label>
          <datalist id="promo-discount-presets">
            <option value="10" />
            <option value="15" />
            <option value="20" />
            <option value="25" />
            <option value="30" />
            <option value="50" />
            <option value="75" />
            <option value="100" />
          </datalist>
          <label>{tr('months')}<input class="input-field" name="durationMonths" type="number" min="1" max="6" step="1" value="1" required /></label>
          <label>{tr('expires')}<input class="input-field" name="expiresAt" type="datetime-local" required /></label>
        </div>
        <label class="flex-row"><input name="newCustomersOnly" type="checkbox" checked />{tr('newOnly')}</label>
        <p class="text-sm text-muted">{tr('terms')}</p>
        <button class="btn btn-primary" type="submit">{tr('create')}</button>
      </form>
      <div class="card" style="overflow-x:auto"><table class="promo-table"><thead><tr>
        <th>{tr('email')}</th><th>{tr('offer')}</th><th>{tr('expires')}</th><th>{tr('end')}</th><th>{tr('status')}</th><th></th>
      </tr></thead><tbody id="promo-invite-list"></tbody></table></div>
      <section id="promo-history" class="card" hidden><h2>{tr('history')}</h2><ul id="promo-history-events"></ul></section>
    </div>
  </div>
  <script>import { initPromoAdmin } from '../../../scripts/promoAdmin'; initPromoAdmin();</script>
</AppLayout>
