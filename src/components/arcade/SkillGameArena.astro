---
import { buildTrainHubUrl, buildTrainSkillUrl } from '../../i18n/routes';
import {
  getSkillGameMeta,
  SKILL_GAMES_META,
  type SkillGameId,
} from '../../math/arcade/skillGames';
import type { Locale } from '../../math/core/types';

interface Props {
  locale: Locale;
  skill: SkillGameId;
}

const { locale, skill } = Astro.props;
const es = locale === 'es-AR';
const meta = getSkillGameMeta(skill);
const isXY = meta.inputMode === 'xy';
---

<div
  id="skill-game-root"
  data-locale={locale}
  data-skill={skill}
  data-input-mode={meta.inputMode ?? 'single'}
  class="mk-stack"
>
  <!-- Top Bar: Back + Skill Switcher + Stats -->
  <div class="mk-card mk-row mk-row--between mk-skill-top">
    <div class="mk-stack mk-stack--tight">
      <div class="mk-row" style="gap: 8px; flex-wrap: wrap;">
        <a href={buildTrainHubUrl(locale)} class="mk-btn">
          ← {es ? 'Todos los juegos' : 'All games'}
        </a>
        {SKILL_GAMES_META.map((item) => (
          <a
            href={buildTrainSkillUrl(locale, item.id)}
            class:list={['mk-btn', { 'mk-btn--primary': item.id === skill }]}
            aria-current={item.id === skill ? 'page' : undefined}
          >
            {item.id === 'addition' && (es ? 'Suma' : 'Addition')}
            {item.id === 'subtraction' && (es ? 'Resta' : 'Subtraction')}
            {item.id === 'multiplication' && (es ? 'Multiplicación' : 'Multiplication')}
            {item.id === 'division' && (es ? 'División' : 'Division')}
            {item.id === 'sea-cannon' && (es ? 'Batalla Naval' : 'Sea Cannon')}
            {item.id === 'chain-ops' && (es ? 'Combinadas' : 'Combined')}
          </a>
        ))}
      </div>
      <h1 class="mk-title" style="margin: 0;">{meta.title[locale]}</h1>
      <p class="mk-text" style="margin: 0;">{meta.subtitle[locale]}</p>
    </div>

    <div class="mk-row" style="gap: 10px; flex-wrap: wrap;">
      <div class="mk-skill-stat">
        <span class="mk-skill-stat__label">{es ? 'Puntos' : 'Score'}</span>
        <strong id="skill-score" class="mk-skill-stat__val">0</strong>
      </div>
      <div class="mk-skill-stat">
        <span class="mk-skill-stat__label">{es ? 'Racha' : 'Streak'}</span>
        <strong id="skill-streak" class="mk-skill-stat__val">0</strong>
      </div>
      <button type="button" id="skill-motion-btn" class="mk-btn" aria-pressed="false">
        {es ? 'Movimiento reducido: No' : 'Reduced motion: Off'}
      </button>
    </div>
  </div>

  <!-- Game Stage + Controls -->
  <div class="mk-skill-grid">
    <!-- Left / Main: Animated Canvas Stage -->
    <section class="mk-card mk-skill-stage" aria-label={meta.title[locale]}>
      <div class="mk-skill-canvas-wrap">
        <canvas
          id="skill-game-canvas"
          width="840"
          height="440"
          class="mk-skill-canvas"
        ></canvas>
      </div>
      <p id="skill-prompt" class="mk-text mk-skill-prompt"></p>
    </section>

    <!-- Bottom: Full-width Horizontal Controls Panel -->
    <aside class="mk-card mk-skill-panel">
      <div class="mk-stack mk-skill-panel__main">
        <div class="mk-row mk-row--between" style="flex-wrap: wrap; gap: 8px;">
          <span class="mk-text" style="font-weight: 800; margin: 0;">
            {es ? 'Nivel' : 'Level'}
          </span>
          <div class="mk-row" style="gap: 6px;">
            <button type="button" class="mk-btn mk-btn--primary" data-skill-diff="1" aria-pressed="true">1 ★</button>
            <button type="button" class="mk-btn" data-skill-diff="2" aria-pressed="false">2 ★★</button>
            <button type="button" class="mk-btn" data-skill-diff="3" aria-pressed="false">3 ★★★</button>
          </div>
        </div>

        <form id="skill-answer-form" class="mk-stack mk-stack--tight">
          {isXY ? (
            <div id="skill-equation" class="mk-skill-eq mk-skill-eq--xy" aria-live="polite">
              <label class="mk-skill-eq-row" for="skill-answer-x">
                <span class="mk-skill-axis mk-skill-axis--x">X</span>
                <span id="skill-eq-x" class="mk-skill-eq-expr"></span>
                <input
                  id="skill-answer-x"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder="?"
                  class="mk-skill-input mk-skill-input--inline"
                  aria-label="X"
                />
              </label>
              <label class="mk-skill-eq-row" for="skill-answer-y">
                <span class="mk-skill-axis mk-skill-axis--y">Y</span>
                <span id="skill-eq-y" class="mk-skill-eq-expr"></span>
                <input
                  id="skill-answer-y"
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  placeholder="?"
                  class="mk-skill-input mk-skill-input--inline"
                  aria-label="Y"
                />
              </label>
            </div>
          ) : (
            <label class="mk-skill-eq mk-skill-eq--inline" for="skill-answer-input" aria-live="polite">
              <span id="skill-equation" class="mk-skill-eq-expr"></span>
              <input
                id="skill-answer-input"
                type="text"
                inputmode="numeric"
                autocomplete="off"
                placeholder="?"
                class="mk-skill-input mk-skill-input--inline"
              />
            </label>
          )}

          <div class="mk-row" style="flex-wrap: wrap; gap: 10px; align-items: center;">
            <button type="submit" id="skill-submit-btn" class="mk-btn mk-btn--primary mk-skill-go">
              {meta.actionLabel[locale]}
            </button>
            <button type="button" id="skill-next-btn" class="mk-btn mk-btn--go" hidden>
              {es ? 'Siguiente desafío →' : 'Next challenge →'}
            </button>
          </div>
          <p class="mk-text" style="margin: 0; font-weight: 700;">
            {meta.howToPlay[locale]}
          </p>
        </form>

        <div id="skill-feedback" class="mk-skill-feedback" aria-live="polite" data-tone="neutral"></div>
      </div>

      <!-- Touch-friendly Keypad -->
      <div class="mk-skill-keypad" role="group" aria-label={es ? 'Teclado numérico' : 'Number pad'}>
        {['1', '2', '3', '4', '5', '6', '7', '8', '9', 'clear', '0', 'back'].map((k) => (
          <button type="button" class="mk-btn mk-skill-key" data-keypad={k}>
            {k === 'clear' ? 'C' : k === 'back' ? '⌫' : k}
          </button>
        ))}
      </div>
    </aside>
  </div>
</div>

<script>
  import '../../scripts/arcade/skillGameClient';
</script>

<style>
  .mk-skill-top {
    gap: var(--mk-s4);
    flex-wrap: wrap;
    align-items: center;
  }

  .mk-skill-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--mk-s2) var(--mk-s4);
    border-radius: 14px;
    background: var(--mk-sunk);
    border: var(--mk-border) solid var(--mk-line);
    min-width: 82px;
  }

  .mk-skill-stat__label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--mk-ink-soft);
  }

  .mk-skill-stat__val {
    font-size: 1.45rem;
    font-weight: 900;
    color: var(--mk-ink);
  }

  .mk-skill-grid {
    display: grid;
    gap: var(--mk-s4);
    grid-template-columns: 1fr;
  }

  .mk-skill-panel {
    display: grid;
    gap: var(--mk-s4);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 760px) {
    .mk-skill-panel {
      grid-template-columns: 1fr 240px;
      align-items: center;
    }
  }

  .mk-skill-panel__main {
    min-width: 0;
  }

  .mk-skill-stage {
    padding: var(--mk-s3);
    display: flex;
    flex-direction: column;
    gap: var(--mk-s3);
  }

  .mk-skill-canvas-wrap {
    width: 100%;
    aspect-ratio: 840 / 440;
    border-radius: 16px;
    overflow: hidden;
    border: var(--mk-border) solid var(--mk-line);
    background: #eaf6ff;
  }

  .mk-skill-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .mk-skill-prompt {
    margin: 0;
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--mk-ink);
  }

  .mk-skill-eq {
    font-family: var(--mk-font-math);
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 900;
    text-align: center;
    padding: var(--mk-s3);
    border-radius: 14px;
    background: var(--mk-sky-tint);
    color: var(--mk-ink);
    border: var(--mk-border) solid var(--mk-sky);
  }

  .mk-skill-eq--xy {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    text-align: left;
    padding: var(--mk-s3);
  }

  @media (min-width: 640px) {
    .mk-skill-eq--xy {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .mk-skill-eq--inline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    flex-wrap: nowrap;
  }

  .mk-skill-eq-row {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
    background: var(--mk-surface);
    padding: 8px 10px;
    border-radius: 10px;
    border: 1.5px solid var(--mk-line);
    cursor: text;
    box-sizing: border-box;
  }

  .mk-skill-eq-expr {
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    font-weight: 900;
    white-space: nowrap;
  }

  .mk-skill-axis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 900;
    flex-shrink: 0;
  }

  .mk-skill-axis--x {
    background: #075A94;
  }

  .mk-skill-axis--y {
    background: #C2410C;
  }

  .mk-skill-input {
    box-sizing: border-box;
    width: 110px;
    min-height: 52px;
    font-size: 1.5rem;
    font-weight: 900;
    text-align: center;
    border-radius: 14px;
    border: var(--mk-border) solid var(--mk-line-strong);
    background: var(--mk-surface);
    color: var(--mk-ink);
    padding: 0 var(--mk-s2);
  }

  .mk-skill-input--inline {
    width: 72px;
    min-height: 44px;
    font-size: 1.3rem;
    margin-left: auto;
    flex-shrink: 0;
  }

  .mk-skill-input:focus {
    outline: 3px solid var(--mk-sky);
    outline-offset: 2px;
  }

  .mk-skill-go {
    flex: 1;
    min-height: 52px;
    justify-content: center;
  }

  .mk-skill-feedback {
    min-height: 28px;
    font-weight: 800;
    font-size: 1rem;
  }

  .mk-skill-feedback[data-tone='ok'] {
    color: var(--mk-leaf);
  }

  .mk-skill-feedback[data-tone='retry'] {
    color: var(--mk-coral);
  }

  .mk-skill-keypad {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .mk-skill-key {
    min-height: 46px;
    font-size: 1.2rem;
    font-weight: 800;
    justify-content: center;
  }
</style>
