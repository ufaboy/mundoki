---
import MascotSvg from './MascotSvg.astro';
import { t } from '../../i18n/translations';
import { buildGradeUrl, buildLearnTopicUrl, buildPlayUrl } from '../../i18n/routes';
import { Locale, TopicId } from '../../math/core/types';
import { getGradeById, GRADES_CATALOG, SCHOOL_BLOCKS } from '../../math/curriculum';
import { generateMathExercise, TOPICS_CATALOG } from '../../math/topics/generators';

interface Props {
  locale: Locale;
  topicId: TopicId;
}

const { locale, topicId } = Astro.props;
const topicMeta = TOPICS_CATALOG.find((item) => item.id === topicId) || TOPICS_CATALOG[0];
const gradeMeta = getGradeById(topicMeta.gradeId);
const initialEx = generateMathExercise(topicId, 1, 104);
---

<div id="play-adventure-root" data-locale={locale} data-topic-id={topicId} class="stack-lg">
  <!-- Top Mission & Topic Selector Bar -->
  <div class="card flex-between">
    <div>
      <div class="kicker">
        {t(locale, 'playMissionHeader')} · {gradeMeta.labelShort[locale]}
      </div>
      <h1 style="font-size:1.55rem;margin:0;">
        🪐 {topicMeta.planetName[locale]} · {topicMeta.title[locale]}
      </h1>
    </div>

    <div class="flex-row">
      <a href={buildGradeUrl(locale, gradeMeta.id)} class="btn btn-outline btn-sm">
        📋 {gradeMeta.labelShort[locale]}
      </a>
      <a href={buildLearnTopicUrl(locale, topicId)} class="btn btn-outline btn-sm">
        📖 {t(locale, 'actionLearn')}
      </a>
      <button type="button" class="btn btn-outline btn-sm" id="btn-toggle-motion">
        {t(locale, 'playReducedMotionOff')}
      </button>
    </div>
  </div>

  <!-- Trainer Switcher by Block & Topic -->
  <div class="card-subtle stack-sm">
    <div class="flex-between text-xs text-mono">
      <strong>
        {locale === 'es-AR'
          ? 'Seleccionar Entrenador por Tema o ir a Página de Grado:'
          : 'Select Trainer by Topic or Open Grade Page:'}
      </strong>
      <div class="flex-row" style="gap:6px;">
        {SCHOOL_BLOCKS.map((b) => {
          const firstGrade = GRADES_CATALOG.find((g) => g.stage === b.id)!;
          return (
            <a href={buildGradeUrl(locale, firstGrade.id)} class="grade-pill">
              {b.title[locale]} ({b.gradeNumbers[0]}–{b.gradeNumbers[b.gradeNumbers.length - 1]})
            </a>
          );
        })}
      </div>
    </div>
    <div class="flex-row">
      {TOPICS_CATALOG.map((item) => (
        <a
          href={buildPlayUrl(locale, item.id)}
          class:list={[
            'btn',
            'btn-sm',
            item.id === topicId ? 'btn-primary' : 'btn-outline',
          ]}
        >
          [{locale === 'es-AR' ? `${item.gradeNumber}.°` : `G${item.gradeNumber}`}] {item.title[locale]}
        </a>
      ))}
    </div>
  </div>

  <!-- Main Adventure Split: Exercise Console + Mascot Scene -->
  <div class="hero-split" style="align-items:stretch;">
    <!-- Left Column: Mathematical Challenge Console -->
    <section class="card stack-md">
      <div class="flex-between">
        <span class="text-xs text-mono text-muted">
          {locale === 'es-AR' ? 'Nivel de Dificultad:' : 'Difficulty Level:'}
        </span>
        <div class="flex-row">
          <button type="button" class="btn btn-primary btn-sm" data-diff-btn="1">1 ★</button>
          <button type="button" class="btn btn-outline btn-sm" data-diff-btn="2">2 ★★</button>
          <button type="button" class="btn btn-outline btn-sm" data-diff-btn="3">3 ★★★</button>
        </div>
      </div>

      <p id="play-prompt-text" style="font-size:1.08rem;font-weight:600;margin:0;">
        {initialEx.prompt[locale]}
      </p>

      <div
        id="play-expression-box"
        class="card-subtle text-mono"
        style="font-size:1.5rem;font-weight:800;text-align:center;color:var(--accent-primary);"
      >
        {initialEx.expressionLatex}
      </div>

      <form id="play-answer-form" class="stack-sm">
        <label class="form-label" for="play-answer-input">
          <span>
            {locale === 'es-AR'
              ? 'Tu respuesta matemática (entero, decimal o fracción ej. 3/4):'
              : 'Your mathematical answer (integer, decimal, or fraction e.g. 3/4):'}
          </span>
        </label>
        <div class="flex-row">
          <input
            id="play-answer-input"
            type="text"
            inputmode="text"
            autocomplete="off"
            required
            class="input-field input-mono"
            style="flex:1;"
            placeholder={topicId === 'fractions' ? '1/4' : '42'}
          />
          <button type="submit" class="btn btn-primary">
            {t(locale, 'playCheckAnswer')}
          </button>
          <button type="button" class="btn btn-outline" id="btn-next-challenge">
            {t(locale, 'playNextChallenge')} →
          </button>
        </div>
      </form>

      <!-- Feedback Box -->
      <div id="play-feedback-box" style="display:none;" role="status" aria-live="polite"></div>

      <!-- Hint & Step-by-Step Solution Controls -->
      <div class="flex-row">
        <button type="button" class="btn btn-outline btn-sm" id="btn-request-hint">
          💡 {t(locale, 'playRequestHint')}
        </button>
        <button type="button" class="btn btn-outline btn-sm" id="btn-show-steps">
          📐 {t(locale, 'playShowSteps')}
        </button>
      </div>

      <div id="play-hint-box" class="callout text-sm" style="display:none;"></div>
      <div id="play-steps-box" class="card-subtle text-sm" style="display:none;"></div>
    </section>

    <!-- Right Column: Mascot Átomo & Space Telemetry -->
    <aside class="space-panel stack-md">
      <div class="flex-between">
        <div>
          <div class="text-xs text-mono" style="color:#94A3B8;">
            {locale === 'es-AR' ? 'Nave Activa' : 'Active Spacecraft'} ·{' '}
            <span id="play-vehicle-tier" style="color:#38BDF8;">Nivel 1</span>
          </div>
          <strong id="play-vehicle-title" style="font-size:1.1rem;color:#fff;">
            {locale === 'es-AR' ? 'Cápsula Exploradora M-1' : 'Scout Pod M-1'}
          </strong>
        </div>

        <div class="flex-row text-mono text-sm">
          <span style="color:#FBBF24;font-weight:700;" id="play-energy-val">20⚡</span>
          <span style="color:#34D399;font-weight:700;" id="play-stars-val">1★</span>
        </div>
      </div>

      <div style="display:flex;justify-content:center;padding:6px 0;">
        <MascotSvg
          idPrefix="play-atomo"
          mood="idle"
          equippedHat="hat-astro-helmet"
          size={175}
        />
      </div>

      <!-- Spacecraft & Guardian Progress Bars -->
      <div class="space-subcard stack-sm">
        <div class="flex-between text-xs">
          <span>{locale === 'es-AR' ? 'Energía de Mejora de Nave' : 'Spacecraft Upgrade Energy'}</span>
          <span class="text-mono" id="play-vehicle-pct" style="color:#38BDF8;">20%</span>
        </div>
        <div class="progress-track progress-track-dark">
          <div class="progress-fill" id="play-vehicle-bar" style="width:20%;"></div>
        </div>
      </div>

      <div class="space-subcard stack-sm">
        <div class="flex-between text-xs">
          <span>
            {locale === 'es-AR' ? 'Guardián:' : 'Guardian:'}{' '}
            <strong id="play-guardian-name" style="color:#fff;">
              {topicMeta.guardianName[locale]}
            </strong>
          </span>
          <span class="text-mono" id="play-guardian-count" style="color:#34D399;">0/3</span>
        </div>
        <div class="progress-track progress-track-dark">
          <div class="progress-fill progress-fill-emerald" id="play-guardian-bar" style="width:0%;"></div>
        </div>
      </div>

      <!-- Batched Server Sync Control -->
      <div class="flex-between text-xs">
        <span id="play-sync-status" style="color:#CBD5E1;">
          {locale === 'es-AR' ? 'Intentos locales en cola: 0' : 'Queued local attempts: 0'}
        </span>
        <button type="button" class="btn btn-emerald btn-sm" id="btn-sync-server">
          ☁ {t(locale, 'playSyncNow')}
        </button>
      </div>
    </aside>
  </div>

  <!-- Interactive Star Map SVG -->
  <section class="space-panel stack-md">
    <div class="flex-between">
      <h2 style="color:#fff;font-size:1.2rem;margin:0;">{t(locale, 'playStarMap')}</h2>
      <span class="text-xs" style="color:#94A3B8;">
        {locale === 'es-AR'
          ? 'Hacé clic en cualquier planeta para viajar a su misión matemática'
          : 'Click any planet to travel to its mathematical mission'}
      </span>
    </div>
    <svg
      id="play-starmap-svg"
      viewBox="0 0 680 185"
      style="width:100%;height:auto;background:#070B19;border:1px solid var(--space-border);border-radius:10px;"
      role="img"
      aria-label={locale === 'es-AR' ? 'Mapa estelar de 6 planetas' : 'Star map of 6 planets'}
    ></svg>
  </section>

  <!-- Mascot Wardrobe & Customization -->
  <section class="card stack-md">
    <h2 class="section-title" style="margin:0;">{t(locale, 'playWardrobe')}</h2>
    <div id="play-wardrobe-grid" class="grid-3"></div>
  </section>
</div>

<script>
  import { initPlayAdventure } from '../../scripts/playClient';
  initPlayAdventure();
</script>
