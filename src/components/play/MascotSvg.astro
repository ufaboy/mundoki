---
import { MascotMood } from '../../game/core/gameState';

interface Props {
  mood?: MascotMood;
  equippedHat?: string | null;
  equippedSuit?: string | null;
  equippedAccessory?: string | null;
  reducedMotion?: boolean;
  size?: number;
  idPrefix?: string;
}

const {
  mood = 'idle',
  equippedHat = 'hat-astro-helmet',
  equippedSuit = null,
  equippedAccessory = null,
  reducedMotion = false,
  size = 180,
  idPrefix = 'atomo',
} = Astro.props;

const bodyColor =
  equippedSuit === 'suit-quantum-vest'
    ? '#D97706'
    : equippedSuit === 'suit-explorer'
      ? '#0284C7'
      : '#334155';

const chestAccent =
  equippedSuit === 'suit-quantum-vest'
    ? '#FEF3C7'
    : equippedSuit === 'suit-explorer'
      ? '#E0F2FE'
      : '#94A3B8';

const chestSymbol =
  mood === 'celebrating' || mood === 'happy'
    ? '+★'
    : mood === 'thinking'
      ? '=?'
      : 'π';
---

<svg
  id={`${idPrefix}-svg`}
  width={size}
  height={size}
  viewBox="0 0 200 200"
  class:list={[{ 'mascot-animated': !reducedMotion }]}
  role="img"
  aria-label={`Mascot Átomo (${mood})`}
  data-mood={mood}
  data-hat={equippedHat || ''}
  data-suit={equippedSuit || ''}
  data-accessory={equippedAccessory || ''}
>
  <!-- Cosmic aura ring -->
  <circle
    id={`${idPrefix}-aura`}
    cx="100"
    cy="108"
    r="76"
    fill="#F0F9FF"
    stroke="#BAE6FD"
    stroke-width="2"
  />

  <!-- Fox-Bot Ears -->
  <polygon points="56,64 44,24 82,48" fill="#F97316" stroke="#0F172A" stroke-width="3" />
  <polygon points="144,64 156,24 118,48" fill="#F97316" stroke="#0F172A" stroke-width="3" />
  <polygon points="58,58 50,32 76,48" fill="#FDE68A" />
  <polygon points="142,58 150,32 124,48" fill="#FDE68A" />

  <!-- Torso / Suit Layer -->
  <rect
    id={`${idPrefix}-torso`}
    x="64"
    y="112"
    width="72"
    height="54"
    rx="20"
    fill={bodyColor}
    stroke="#0F172A"
    stroke-width="3"
  />

  <!-- Chest math core -->
  <rect
    id={`${idPrefix}-chest`}
    x="82"
    y="124"
    width="36"
    height="26"
    rx="6"
    fill={chestAccent}
    stroke="#0F172A"
    stroke-width="2"
  />
  <text
    id={`${idPrefix}-symbol`}
    x="100"
    y="142"
    text-anchor="middle"
    font-family="monospace"
    font-size="13"
    font-weight="700"
    fill="#0F172A"
  >
    {chestSymbol}
  </text>

  <!-- Arms -->
  <path
    id={`${idPrefix}-arm-left`}
    d={mood === 'celebrating' ? 'M 64 124 Q 36 96 42 76' : 'M 64 124 Q 44 138 48 152'}
    fill="none"
    stroke={bodyColor}
    stroke-width="12"
    stroke-linecap="round"
  />
  <path
    id={`${idPrefix}-arm-right`}
    d={mood === 'celebrating' ? 'M 136 124 Q 164 96 158 76' : 'M 136 124 Q 156 138 152 152'}
    fill="none"
    stroke={bodyColor}
    stroke-width="12"
    stroke-linecap="round"
  />

  <!-- Head -->
  <rect
    x="52"
    y="46"
    width="96"
    height="72"
    rx="28"
    fill="#FB923C"
    stroke="#0F172A"
    stroke-width="3"
  />
  <!-- Face screen -->
  <rect x="64" y="58" width="72" height="46" rx="16" fill="#0F172A" />

  <!-- Eyes & mouth (idle/default) -->
  <g id={`${idPrefix}-face-idle`} style={mood === 'happy' || mood === 'celebrating' || mood === 'thinking' ? 'display:none' : ''}>
    <circle cx="84" cy="77" r="5.5" fill="#38BDF8" />
    <circle cx="116" cy="77" r="5.5" fill="#38BDF8" />
    <path d="M 90 92 Q 100 98 110 92" fill="none" stroke="#38BDF8" stroke-width="3" stroke-linecap="round" />
  </g>

  <!-- Eyes & mouth (happy/celebrating) -->
  <g id={`${idPrefix}-face-happy`} style={mood === 'happy' || mood === 'celebrating' ? '' : 'display:none'}>
    <path d="M 76 78 Q 84 68 92 78" fill="none" stroke="#38BDF8" stroke-width="3.5" stroke-linecap="round" />
    <path d="M 108 78 Q 116 68 124 78" fill="none" stroke="#38BDF8" stroke-width="3.5" stroke-linecap="round" />
    <path d="M 88 92 Q 100 102 112 92" fill="none" stroke="#34D399" stroke-width="3" stroke-linecap="round" />
  </g>

  <!-- Eyes & mouth (thinking) -->
  <g id={`${idPrefix}-face-thinking`} style={mood === 'thinking' ? '' : 'display:none'}>
    <circle cx="84" cy="76" r="5" fill="#38BDF8" />
    <line x1="108" y1="76" x2="122" y2="76" stroke="#38BDF8" stroke-width="3.5" stroke-linecap="round" />
    <line x1="90" y1="92" x2="110" y2="92" stroke="#FBBF24" stroke-width="3" stroke-linecap="round" />
  </g>

  <!-- Accessory Layer: Algebraic Balance Visor -->
  <g id={`${idPrefix}-acc-visor`} style={equippedAccessory === 'acc-math-visor' ? '' : 'display:none'}>
    <rect
      x="60"
      y="64"
      width="80"
      height="22"
      rx="8"
      fill="rgba(16, 185, 129, 0.35)"
      stroke="#10B981"
      stroke-width="2.5"
    />
    <line x1="96" y1="75" x2="104" y2="75" stroke="#A7F3D0" stroke-width="2" />
  </g>

  <!-- Accessory Layer: Boots -->
  <g>
    <rect
      id={`${idPrefix}-boot-left`}
      x="70"
      y="164"
      width="24"
      height="16"
      rx="6"
      fill={equippedAccessory === 'acc-gravity-boots' ? '#D97706' : '#475569'}
      stroke="#0F172A"
      stroke-width="2.5"
    />
    <rect
      id={`${idPrefix}-boot-right`}
      x="106"
      y="164"
      width="24"
      height="16"
      rx="6"
      fill={equippedAccessory === 'acc-gravity-boots' ? '#D97706' : '#475569'}
      stroke="#0F172A"
      stroke-width="2.5"
    />
  </g>

  <!-- Hat Layer 1: Cadet Solar Helmet -->
  <g id={`${idPrefix}-hat-helmet`} style={equippedHat === 'hat-astro-helmet' ? '' : 'display:none'}>
    <ellipse
      cx="100"
      cy="78"
      rx="56"
      ry="48"
      fill="rgba(186, 230, 253, 0.22)"
      stroke="#0284C7"
      stroke-width="3"
    />
    <path
      d="M 65 48 Q 100 32 135 48"
      fill="none"
      stroke="#FFFFFF"
      stroke-width="2.5"
      stroke-linecap="round"
    />
  </g>

  <!-- Hat Layer 2: Thermal Polar Crest -->
  <g id={`${idPrefix}-hat-crown`} style={equippedHat === 'hat-solar-crown' ? '' : 'display:none'}>
    <line x1="100" y1="45" x2="100" y2="18" stroke="#0F172A" stroke-width="4" />
    <circle cx="100" cy="16" r="8" fill="#F59E0B" stroke="#0F172A" stroke-width="2.5" />
    <polygon points="82,46 100,30 118,46" fill="#0EA5E9" stroke="#0F172A" stroke-width="2" />
  </g>
</svg>
