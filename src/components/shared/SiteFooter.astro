---
// The one site footer, shared by every page. The language switch lives here:
// it is a choice for adults, not something a child needs in the header.
import type { Locale } from '../../math/core/types';
import { t } from '../../i18n/translations';
import { buildAboutUrl, buildHomeUrl, buildPrivacyUrl, buildTermsUrl } from '../../i18n/routes';

interface Props {
  locale: Locale;
  switchLocaleHref?: string;
}

const { locale, switchLocaleHref } = Astro.props;
const es = locale === 'es-AR';
const otherLocale: Locale = es ? 'en-US' : 'es-AR';
const otherHref = switchLocaleHref || buildHomeUrl(otherLocale);
---

<footer class="mk-ui mk-footer">
  <span>Mundoki · {t(locale, 'footerNoAds')}</span>
  <span class="mk-row" style="flex-wrap: wrap; gap: 14px;">
    <a href={buildAboutUrl(locale)}>{es ? 'Acerca de' : 'About'}</a>
    <a href={buildPrivacyUrl(locale)}>{es ? 'Privacidad' : 'Privacy Policy'}</a>
    <a href={buildTermsUrl(locale)}>{es ? 'Términos' : 'Terms'}</a>
    <a href={otherHref} hreflang={otherLocale} lang={otherLocale}>{otherLocale === 'en-US' ? 'English' : 'Español'}</a>
  </span>
</footer>
