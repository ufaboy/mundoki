---
import { buildPremiumUrl } from '../../i18n/routes';
import type { Locale } from '../../math/core/types';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const L = (es: string, en: string) => (locale === 'es-AR' ? es : en);
const icons = {
  mail: 'M3 6.5h18v11H3zM3 7l9 6.5L21 7',
  lock: 'M6 11h12v9H6zM8.5 11V8a3.5 3.5 0 0 1 7 0v3',
  exit: 'M14 4h5v16h-5M10 8l-4 4 4 4M6 12h10',
};
---

<div id="account-page-root" data-locale={locale} class="mk-account">
  <!-- Messages for every step of the page (sign-in errors, sent link, 2FA changes) -->
  <div id="account-status-banner" class="mk-feedback" role="status" aria-live="polite" hidden>
    <span class="mk-feedback__text"></span>
  </div>

  <!-- 1. Signed out: sign in or create an account -->
  <section id="account-guest-view" class="mk-card mk-stack mk-account__auth" aria-labelledby="account-auth-title">
    <div class="mk-stack mk-stack--tight">
      <h1 class="mk-title" id="account-auth-title">{L('Cuenta de la familia', 'Family account')}</h1>
      <p class="mk-text">
        {L(
          'Entrá para guardar el avance de tus hijos y verlo en cualquier dispositivo. Para jugar no hace falta cuenta.',
          'Sign in to save your children’s progress and see it on any device. Playing does not need an account.'
        )}
      </p>
    </div>

    <div class="mk-tabs mk-account__mode" role="group" aria-label={L('Qué querés hacer', 'What do you want to do')}>
      <button type="button" data-auth-tab="signin" aria-pressed="true">{L('Entrar', 'Sign in')}</button>
      <button type="button" data-auth-tab="signup" aria-pressed="false">{L('Crear cuenta', 'Create account')}</button>
    </div>

    <form id="form-password-auth" class="mk-stack" novalidate>
      <div id="auth-name-group" class="mk-field" hidden>
        <label for="input-auth-name">{L('Tu nombre', 'Your name')}</label>
        <input id="input-auth-name" name="name" class="mk-input" type="text" autocomplete="name" maxlength="60" />
      </div>

      <div class="mk-field">
        <label for="input-auth-email">{L('Correo electrónico', 'Email')}</label>
        <input
          id="input-auth-email"
          name="email"
          class="mk-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          autocapitalize="off"
          spellcheck="false"
          required
          aria-describedby="auth-email-error"
          placeholder={L('nombre@correo.com', 'name@email.com')}
        />
        <p class="mk-field__error" id="auth-email-error" hidden></p>
      </div>

      <div class="mk-field">
        <label id="label-auth-password" for="input-auth-password">{L('Contraseña', 'Password')}</label>
        <div class="mk-account__secret">
          <input
            id="input-auth-password"
            name="password"
            class="mk-input"
            type="password"
            autocomplete="current-password"
            minlength="6"
            required
            aria-describedby="auth-password-hint auth-password-error"
          />
          <input
            id="input-auth-signup-password"
            name="password"
            class="mk-input"
            type="password"
            autocomplete="new-password"
            minlength="6"
            required
            hidden
            disabled
            aria-describedby="auth-password-hint auth-password-error"
          />
          <button type="button" class="mk-btn mk-btn--quiet" id="btn-toggle-password" aria-pressed="false">
            {L('Mostrar', 'Show')}
          </button>
        </div>
        <p class="mk-label" id="auth-password-hint" hidden>{L('6 letras o números como mínimo.', 'At least 6 letters or numbers.')}</p>
        <p class="mk-field__error" id="auth-password-error" hidden></p>
      </div>

      <button type="submit" class="mk-btn mk-btn--primary mk-btn--wide" id="btn-submit-password-auth">
        {L('Entrar', 'Sign in')}
      </button>
    </form>

    <!-- Passwordless shortcut for existing accounts: uses the email typed above -->
    <div id="auth-magic-block" class="mk-stack mk-stack--tight">
      <p class="mk-account__or"><span>{L('o', 'or')}</span></p>
      <button type="button" class="mk-btn mk-btn--wide" id="btn-send-magic-link">
        <svg class="mk-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.mail} /></svg>
        {L('Pedir un enlace', 'Email me a link')}
      </button>
      <p class="mk-label mk-account__center">{L('Sin contraseña: te mandamos un enlace para entrar.', 'No password needed: we send you a link to sign in.')}</p>
    </div>

    <!-- Local development only: the server returns the link because no email provider is set up -->
    <div id="magic-dev-outbox" class="mk-card mk-card--sunk mk-stack mk-stack--tight" hidden>
      <p class="mk-label">{L('Modo desarrollo: no hay servicio de correo. Abrí el enlace acá.', 'Development mode: no email service. Open the link here.')}</p>
      <button type="button" class="mk-btn mk-btn--go" id="btn-verify-magic-now">{L('Abrir el enlace', 'Open the link')}</button>
    </div>

    <!-- OAuth providers stay hidden until their credentials are configured -->
    <div id="oauth-section" class="mk-stack mk-stack--tight" hidden>
      <button type="button" class="mk-btn mk-btn--wide" data-oauth-provider="google">Google</button>
      <button type="button" class="mk-btn mk-btn--wide" data-oauth-provider="facebook">Facebook</button>
      <button type="button" class="mk-btn mk-btn--wide" data-oauth-provider="apple">Apple</button>
      <div id="oauth-dev-sandbox" class="mk-card mk-card--sunk mk-stack mk-stack--tight" hidden>
        <p class="mk-label" id="oauth-sandbox-provider-label">Google</p>
        <div class="mk-field">
          <label for="input-dev-oauth-email">{L('Correo de prueba', 'Test email')}</label>
          <input id="input-dev-oauth-email" class="mk-input" type="email" value="explorador.oauth@mundoki.edu.ar" />
        </div>
        <button type="button" class="mk-btn" id="btn-confirm-dev-oauth">{L('Simular acceso', 'Simulate sign-in')}</button>
      </div>
    </div>
  </section>

  <!-- 2. Second step for accounts with two-step verification -->
  <section id="account-2fa-challenge-view" class="mk-card mk-stack mk-account__auth" aria-labelledby="account-2fa-title" hidden>
    <div class="mk-stack mk-stack--tight">
      <h1 class="mk-title" id="account-2fa-title">{L('Un paso más', 'One more step')}</h1>
      <p class="mk-text">
        {L('Escribí el código de 6 números de tu app de verificación para', 'Enter the 6-digit code from your authenticator app for')}
        {' '}<strong id="challenge-2fa-email"></strong>.
      </p>
    </div>
    <p id="challenge-2fa-dev-totp" class="mk-label" hidden></p>
    <form id="form-2fa-challenge" class="mk-stack">
      <div class="mk-field">
        <label for="input-2fa-challenge-code">{L('Código', 'Code')}</label>
        <input
          id="input-2fa-challenge-code"
          class="mk-input mk-account__code"
          type="text"
          inputmode="text"
          autocomplete="one-time-code"
          autocapitalize="characters"
          spellcheck="false"
          required
        />
        <p class="mk-label">{L('¿Perdiste el teléfono? Usá uno de tus códigos de respaldo.', 'Lost your phone? Use one of your backup codes.')}</p>
      </div>
      <button type="submit" class="mk-btn mk-btn--primary mk-btn--wide">{L('Entrar', 'Sign in')}</button>
      <button type="button" class="mk-btn mk-btn--quiet" id="btn-cancel-2fa-challenge">{L('Volver', 'Back')}</button>
    </form>
  </section>

  <!-- 3. Signed in -->
  <div id="account-loggedin-view" class="mk-stack" hidden>
    <section class="mk-row mk-row--between mk-account__hello" aria-labelledby="user-profile-name">
      <div class="mk-stack mk-stack--tight">
        <p class="mk-label">{L('Cuenta de la familia', 'Family account')}</p>
        <h1 class="mk-title" id="user-profile-name"></h1>
        <p class="mk-text mk-account__email" id="user-profile-email"></p>
      </div>
      <button type="button" class="mk-btn" id="btn-sign-out">
        <svg class="mk-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.exit} /></svg>
        {L('Salir', 'Sign out')}
      </button>
    </section>

    <div class="mk-row" id="account-extra-links">
      <a id="account-return-next" class="mk-btn mk-btn--go" href="#" hidden>{L('Volver a la misión', 'Back to the mission')}</a>
      <a id="account-return-promo" class="mk-btn mk-btn--primary" href={buildPremiumUrl(locale)} hidden>{L('Volver a mi invitación', 'Return to my invitation')}</a>
      <a id="account-admin-promos" class="mk-btn" href={`/${locale.toLowerCase()}/admin/promos`} hidden>{L('Administrar invitaciones', 'Manage invitations')}</a>
    </div>

    <div class="mk-grid">
      <section class="mk-card mk-stack" aria-labelledby="account-plan-title">
        <h2 class="mk-heading" id="account-plan-title">{L('Suscripción', 'Subscription')}</h2>
        <p><span class="mk-chip" id="user-profile-tier"></span></p>
        <p class="mk-text" id="user-profile-tier-text"></p>
        <a class="mk-btn mk-btn--premium" id="user-profile-tier-link" href={buildPremiumUrl(locale)}></a>
      </section>

      <section class="mk-card mk-stack" aria-labelledby="account-security-title">
        <h2 class="mk-heading" id="account-security-title">{L('Seguridad', 'Security')}</h2>
        <p class="mk-text">
          {L('Verificación en dos pasos:', 'Two-step verification:')}
          {' '}<span class="mk-chip" id="user-2fa-status-badge"></span>
        </p>
        <p class="mk-label">
          {L(
            'Al entrar, además de la contraseña, se pide un código de una app del teléfono (Google Authenticator, Authy y otras).',
            'When you sign in, besides the password you are asked for a code from a phone app (Google Authenticator, Authy and others).'
          )}
        </p>
        <button type="button" class="mk-btn" id="btn-start-2fa-setup">
          <svg class="mk-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={icons.lock} /></svg>
          {L('Activar', 'Turn on')}
        </button>

        <!-- Turning it off needs a current code, so a stolen session cannot remove it -->
        <form id="form-disable-2fa" class="mk-stack mk-stack--tight" hidden>
          <div class="mk-field">
            <label for="input-2fa-disable-code">{L('Código de la app para desactivar', 'App code to turn it off')}</label>
            <input id="input-2fa-disable-code" class="mk-input mk-account__code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
          </div>
          <button type="submit" class="mk-btn" id="btn-disable-2fa">{L('Desactivar', 'Turn off')}</button>
        </form>
      </section>
    </div>

    <!-- Setup steps, shown after "Turn on" -->
    <section id="panel-2fa-setup" class="mk-card mk-stack" aria-labelledby="account-2fa-setup-title" hidden>
      <h2 class="mk-heading" id="account-2fa-setup-title">{L('Activar la verificación en dos pasos', 'Turn on two-step verification')}</h2>
      <ol class="mk-account__steps">
        <li class="mk-stack mk-stack--tight">
          <p class="mk-text">{L('En la app del teléfono, agregá una cuenta nueva con esta clave:', 'In the phone app, add a new account with this key:')}</p>
          <code id="totp-setup-secret" class="mk-account__key"></code>
          <a id="totp-setup-uri" class="mk-btn mk-btn--quiet" href="#">{L('Abrir en la app de este teléfono', 'Open in the app on this phone')}</a>
        </li>
        <li class="mk-stack mk-stack--tight">
          <p class="mk-text">{L('Guardá estos códigos de respaldo en un lugar seguro. Cada uno sirve una sola vez si perdés el teléfono.', 'Keep these backup codes somewhere safe. Each works once if you lose your phone.')}</p>
          <ul id="totp-backup-codes-list" class="mk-account__codes"></ul>
        </li>
        <li>
          <form id="form-enable-2fa" class="mk-stack mk-stack--tight">
            <div class="mk-field">
              <label for="input-totp-verify-code">{L('Escribí el código de 6 números que muestra la app', 'Enter the 6-digit code the app shows')}</label>
              <input id="input-totp-verify-code" class="mk-input mk-account__code" type="text" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required />
            </div>
            <p class="mk-label" id="totp-setup-dev-code" hidden></p>
            <button type="submit" class="mk-btn mk-btn--go">{L('Confirmar y activar', 'Confirm and turn on')}</button>
          </form>
        </li>
      </ol>
    </section>
  </div>
</div>

<script>
  import { initAccountPage } from '../../scripts/accountClient';
  initAccountPage();
</script>
