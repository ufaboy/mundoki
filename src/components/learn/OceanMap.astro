---
import type {Locale} from '../../math/core/types';
import {OCEAN_CHAPTERS,OCEAN_MISSIONS} from '../../content/grade6/oceanAdventure';
import {GRADE_SIX_LESSONS,GRADE_SIX_PROJECT} from '../../content/grade6';
import {buildCatalogUrl,buildSchoolLessonUrl} from '../../i18n/routes';
import OceanScene from './OceanScene.astro';
import OceanChoices from './OceanChoices.astro';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<div class="city-adventure city-map ocean-adventure" data-ocean-root data-ocean-map data-locale={locale}>
<nav class="city-top"><a href={buildCatalogUrl(locale)}>← {es?'Todos los grados':'All grades'}</a><span>{es?'6.º GRADO':'GRADE 6'}</span><a href="#ocean-families">{es?'Para familias':'For families'}</a></nav>
<header class="city-map-hero"><div><p class="city-kicker">{es?'UNA EXPEDICIÓN LLENA DE IDEAS':'AN EXPEDITION FULL OF IDEAS'}</p><h1>{es?'Expedición oceánica':'Ocean Expedition'}</h1><p>{es?'Descubrí una estación sumergida y recuperá sus secretos.':'Discover a sunken station and recover its secrets.'}</p><a class="city-primary" href={buildSchoolLessonUrl(locale,'grade-6',OCEAN_MISSIONS[0].id)}>{es?'¡Abrir el archivo!':'Open the archive!'} →</a><a class="city-pick" href="#ocean-missions">{es?'Elegir una misión ↓':'Choose a mission ↓'}</a></div><div class="city-map-preview"><span>{es?'Tu próxima aventura':'Your next adventure'}</span><OceanScene kind="sub" preview/></div></header>
<OceanChoices locale={locale}/>
<section id="ocean-missions"><div class="city-map-section"><h2 data-ocean-name-display>{es?'Mi expedición':'My expedition'}</h2><span>{OCEAN_MISSIONS.length} {es?'misiones · todas disponibles':'missions · all available'}</span></div>
{OCEAN_CHAPTERS.map((chapter,i)=><details class="city-district" id={chapter.id.toLowerCase()} open={i===0}><summary><span class="city-district-icon" aria-hidden="true">{chapter.icon}</span><span><span class="city-kicker">{es?'ETAPA':'CHAPTER'} {i+1}</span><strong>{chapter.title[locale]}</strong></span><span class="city-district-arrow" aria-hidden="true">⌄</span></summary><ol class="city-mission-list" start={OCEAN_MISSIONS.indexOf(chapter.missions[0])+1}>{chapter.missions.map(mission=><li><a data-ocean-mission-link={mission.id} href={buildSchoolLessonUrl(locale,'grade-6',mission.id)}><span class="city-mission-number">{OCEAN_MISSIONS.indexOf(mission)+1}</span><strong>{mission.title[locale]}</strong><span class="city-mission-play">{es?'Jugar':'Play'} →</span></a></li>)}</ol></details>)}
</section>
<aside class="city-map-finale"><span aria-hidden="true">🚢 🤿 🌿</span><div><h2>{es?'¡Compartamos el descubrimiento!':'Share the discovery!'}</h2><p>{es?'Volvé a la costa y abrí un parque de investigación.':'Return to shore and open a research park.'}</p></div></aside>
<details class="city-notebook" id="ocean-families"><summary>{es?'Para familias: qué aprendemos':'For families: what we learn'}</summary><div><p>{es?'Números grandes, operaciones, fracciones, decimales, medidas, geometría y datos. Cada misión conserva los ejemplos, modelos y explicaciones del curso.':'Large numbers, operations, fractions, decimals, measurement, geometry, and data. Every mission keeps the course examples, models, and explanations.'}</p><p>{es?'Todas las misiones están disponibles. Las escenas representan etapas de la historia, no un historial guardado. Las respuestas no se guardan ni otorgan puntos de dominio. Solo el nombre, el color y el emblema se recuerdan en este navegador.':'All missions are available. Scenes show story stages, not saved completion history. Answers are not saved and do not award mastery points. Only the name, color, and emblem are remembered in this browser.'}</p><ul>{OCEAN_CHAPTERS.map(chapter=><li><a href={buildSchoolLessonUrl(locale,'grade-6',chapter.missions[0].id)}>{GRADE_SIX_LESSONS.find(l=>l.packageId===chapter.id)!.objective[locale]}</a></li>)}</ul><section id="project"><h2>{GRADE_SIX_PROJECT.title[locale]}</h2><p>{GRADE_SIX_PROJECT.introduction[locale]}</p><ol>{GRADE_SIX_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es?'Cómo acompañar':'How to help'}</summary><ul>{GRADE_SIX_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>import '../../scripts/oceanAdventure';</script>
