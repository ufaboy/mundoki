---
import type { Locale } from '../../math/core/types';
const { locale, lessonId } = Astro.props as { locale: Locale; lessonId: string };
const es = locale === 'es-AR';
---
{lessonId==='G07-06-L02'&&<figure data-park-worked-diagram><figcaption>{es?'Una diagonal forma dos triángulos: 180° + 180° = 360°.':'One diagonal makes two triangles: 180° + 180° = 360°.'}</figcaption><svg viewBox="0 0 380 220" role="img" aria-label={es?'Cuadrilátero convexo dividido por una diagonal en dos triángulos.':'Convex quadrilateral split by a diagonal into two triangles.'}><path d="M60 170 L100 40 L300 65 Z" fill="#d9eeec"/><path d="M60 170 L300 65 L330 180 Z" fill="#f6deb0"/><path d="M60 170 L100 40 L300 65 L330 180 Z" fill="none" stroke="#263c49" stroke-width="3"/><path d="M60 170 L300 65" stroke="#263c49" stroke-dasharray="6 4"/><text x="145" y="100">180°</text><text x="220" y="158">180°</text></svg><p>{es?'Convexo significa que no tiene una esquina hundida hacia adentro. La línea punteada une dos vértices no vecinos.':'Convex means it has no corner pointing inward. The dashed line joins two nonadjacent vertices.'}</p></figure>}
{lessonId==='G07-06-L03'&&<figure data-park-worked-diagram><figcaption>{es?'Base AB = 5 cm; arcos con centro en A y B.':'Base AB = 5 cm; arcs centered at A and B.'}</figcaption><svg viewBox="0 0 400 280" role="img" aria-label={es?'Triángulo ABC: AB mide 5 cm, AC 3 cm y BC 4 cm. C está en la intersección de los arcos.':'Triangle ABC: AB is 5 cm, AC is 3 cm, and BC is 4 cm. C lies at the intersection of the arcs.'}><path d="M200 210 A120 120 0 0 0 80 90 M120 210 A160 160 0 0 1 280 50" fill="none" stroke="#267c78" stroke-width="2" stroke-dasharray="6 4"/><path d="M80 210 L152 114 L280 210 Z" fill="none" stroke="#263c49" stroke-width="3"/>{[[80,210,'A'],[280,210,'B'],[152,114,'C']].map(([x,y,label])=><g><circle cx={x} cy={y} r="4" fill="#263c49"/><text x={Number(x)-6} y={Number(y)-12}>{label}</text></g>)}<text x="165" y="240">5 cm</text><text x="73" y="153">3 cm</text><text x="225" y="153">4 cm</text></svg><p>{es?'Abrí el compás a 3 cm desde A y a 4 cm desde B. Uní el cruce C con A y B. La imagen es un esquema: construí las medidas con tus instrumentos.':'Set the compass to 3 cm from A and 4 cm from B. Join intersection C to A and B. This is a schematic: use your tools to construct the stated lengths.'}</p></figure>}
{lessonId==='G07-08-L01'&&<figure data-park-worked-diagram><figcaption>{es?'Una posible red o desarrollo plano de un cubo':'One possible flat net of a cube'}</figcaption><svg viewBox="0 0 380 260" role="img" aria-label={es?'Cuatro cuadrados en fila y uno arriba y otro abajo del segundo. Caras opuestas: A y C, B y D, E y F.':'Four squares in a row, with one above and one below the second. Opposite faces: A and C, B and D, E and F.'}>{[[0,1,'A'],[1,1,'B'],[2,1,'C'],[3,1,'D'],[1,0,'E'],[1,2,'F']].map(([x,y,label])=><g><rect x={40+Number(x)*70} y={20+Number(y)*70} width="70" height="70" fill="#d9eeec" stroke="#263c49" stroke-dasharray="5 3"/><text x={75+Number(x)*70} y={62+Number(y)*70} text-anchor="middle">{label}</text></g>)}</svg><p>{es?'Dibujá seis cuadrados iguales. Recortá solo el contorno exterior y plegá las líneas compartidas. Quedan enfrentadas A con C, B con D y E con F. Este cubo es un ejemplo distinto de la caja rectangular de 2 × 3 × 4 cm.':'Draw six equal squares. Cut only the outer outline and fold along shared edges. A faces C, B faces D, and E faces F. This cube is a different example from the 2 × 3 × 4 cm rectangular box.'}</p></figure>}
{lessonId==='G07-09-L01'&&<figure data-park-worked-diagram><figcaption>{es?'Las mismas respuestas, dos escalas. Leé los números de los ejes.':'The same responses, two scales. Read the axis numbers.'}</figcaption><div class="chart-pair">{[0,5].map(base=><svg viewBox="0 0 340 280" role="img" aria-label={es?`Ajedrez 8, dibujo 6, música 6. Eje desde ${base}.`:`Chess 8, drawing 6, music 6. Axis starts at ${base}.`}><text x="170" y="23" text-anchor="middle">{es?'Estudiantes · eje desde':'Students · axis from'} {base}</text>{(base===0?[0,2,4,6,8]:[5,6,7,8]).map(v=><g><path d={`M40 ${210-(v-base)*(base===0?20:50)} H320`} stroke="#ccd5da"/><text x="32" y={215-(v-base)*(base===0?20:50)} text-anchor="end">{v}</text></g>)}{[8,6,6].map((v,i)=><g><rect x={60+90*i} y={210-(v-base)*(base===0?20:50)} width="50" height={(v-base)*(base===0?20:50)} fill="#267c78"/><text x={85+90*i} y={202-(v-base)*(base===0?20:50)} text-anchor="middle">{v}</text><text x={85+90*i} y="238" text-anchor="middle">{(es?['Ajedrez','Dibujo','Música']:['Chess','Drawing','Music'])[i]}</text></g>)}<path d="M40 45 V210 H320" fill="none" stroke="#263c49"/>{base===5&&<><path d="M35 216 l10 4 l-10 4 l10 4" fill="none" stroke="#263c49"/><text x="170" y="269" text-anchor="middle">{es?'Se omite de 0 a 5':'0 to 5 is omitted'}</text></>}</svg>)}</div><p>{es?'A la izquierda cada intervalo vale 2 estudiantes; a la derecha vale 1. Desde 5, los tramos visibles son 3, 1 y 1. Pero 8 no es el triple de 6: los datos no cambiaron.':'Each interval on the left is 2 students; on the right it is 1. Above 5, the visible portions are 3, 1, and 1. But 8 is not three times 6: the data have not changed.'}</p></figure>}
<style>
figure{margin:1rem 0}figcaption{font-weight:700}svg{display:block;width:100%;max-width:440px;height:auto;margin:1rem auto;background:white;border-radius:8px}text{font:15px sans-serif;fill:#20313d}.chart-pair{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem}
</style>
