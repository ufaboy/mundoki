---
import type {ParkScene} from '../../content/grade7/parkAdventure';
const {kind,preview=false}=Astro.props as {kind:ParkScene;preview?:boolean};
---
<div class="park-stage" data-park-stage data-kind={kind} data-phase={preview?'complete':'start'} aria-hidden="true">
<svg viewBox="0 0 900 380" xmlns="http://www.w3.org/2000/svg">
 <rect width="900" height="380" fill="#edf0e9"/><circle cx="765" cy="72" r="35" fill="#efc773"/>
 <path d="M0 260Q160 190 310 260T600 250T900 225V380H0Z" fill="#b8c8ab"/>
 <path d="M0 335L900 305" stroke="#faf7ef" stroke-width="55"/>
 <g fill="#f8f3e8" stroke="#344f50" stroke-width="5" stroke-linejoin="round">
 {kind==='archive'&&<g><rect x="210" y="75" width="480" height="220" rx="15"/><path d="M240 105H660V260H240Z" fill="#344f50"/><g class="park-built" fill="#f6db8a"><circle cx="230" cy="95" r="12"/><circle cx="670" cy="95" r="12"/></g><g class="park-done"><path d="M360 265L295 125H610L540 265Z" fill="#d3e5c2" stroke="none"/><rect x="325" y="145" width="85" height="55" fill="#8cb7b0"/><path d="M440 220V160H560V220Z" fill="#edc474"/><path d="M335 225L570 135" stroke="#faf7ef" stroke-width="12"/></g><rect x="395" y="250" width="110" height="45" rx="10" fill="var(--park-paint)"/></g>}
 {kind==='delivery'&&<g><path d="M590 160H790V290H590Z"/><path d="M570 160L690 95L810 160Z" fill="var(--park-paint)"/><g class="park-truck"><path d="M100 210H250L290 245V295H100Z" fill="var(--park-paint)"/><rect x="115" y="165" width="115" height="95"/><circle cx="140" cy="295" r="23" fill="#344f50"/><circle cx="260" cy="295" r="23" fill="#344f50"/></g><g class="park-done" fill="#deb678"><rect x="610" y="240" width="60" height="50"/><rect x="680" y="210" width="65" height="80"/></g></g>}
 {kind==='plan'&&<g><path d="M155 260H745M210 260V320M690 260V320" stroke-width="14"/><g class="park-built"><path d="M200 235L280 130H640L710 235Z" fill="#d3e5e6"/><path d="M285 205L330 150H440V205Z"/><path d="M485 205V155H610L650 205Z"/></g><g class="park-done" fill="var(--park-paint)"><path d="M310 200V130L390 110L440 145V200Z"/><path d="M505 200V150L560 125L620 155V200Z"/></g></g>}
 {kind==='modules'&&<g fill="none" stroke="var(--park-paint)" stroke-width="12"><path d="M200 270H700" stroke="#839581" stroke-dasharray="12 12"/><path class="park-built" d="M220 270V170H320V270H220"/><path class="park-done" d="M320 170H620V270H320M420 170V270M520 170V270"/></g>}
 {(kind==='formula'||kind==='chance')&&<g><path d="M230 270H680M270 270V320M640 270V320" stroke-width="14"/><g class="park-built"><rect x="280" y="140" width="170" height="125" rx="10" fill="var(--park-paint)"/>{kind==='formula'?<path d="M305 220V170H425V220Z"/>:<g fill="#edc474"><circle cx="320" cy="180" r="14"/><circle cx="365" cy="220" r="14"/><circle cx="410" cy="180" r="14"/></g>}</g><g class="park-done"><path d="M450 245H500V190" fill="none"/><rect x="490" y="120" width="150" height="125" rx="10" fill="#344f50"/><path d="M515 210L545 180L570 190L615 145" fill="none" stroke="#b4d7ac"/></g></g>}
 {kind==='geometry'&&<g><path d="M230 300H670"/><path class="park-built" d="M280 295V190M620 295V190" stroke-width="18"/><path class="park-roof park-done" d="M240 190L450 65L660 190Z" fill="var(--park-paint)"/><path class="park-done" d="M450 65V190M345 128L450 190L555 128" fill="none"/></g>}
 {kind==='paving'&&<g><path d="M200 280L325 140H730L605 280Z" fill="#b8c8ab" stroke-dasharray="10 10"/><path class="park-built" d="M200 280L325 140H730L605 280Z" fill="none" stroke-width="12"/><g class="park-done" fill="#e5c696"><path d="M200 280L325 140H730L605 280Z"/>{[1,2,3].map(i=><path d={`M${200+i*101} 280L${325+i*101} 140`} fill="none"/>)}<path d="M240 235H645M282 188H687"/></g></g>}
 {kind==='pavilion'&&<g><path d="M300 300H600L690 240H390Z" fill="#8d9f91"/><g class="park-built"><path d="M300 300V160H600V300Z" fill="var(--park-paint)"/><path d="M600 300L690 240V105L600 160Z" fill="#7caaa2"/></g><g class="park-done"><path d="M300 160L390 105H690L600 160Z" fill="#efc773"/><rect x="415" y="205" width="70" height="95"/><rect x="330" y="195" width="55" height="55" fill="#d3e5e6"/><rect x="515" y="195" width="55" height="55" fill="#d3e5e6"/></g></g>}
 {kind==='trials'&&<g><rect x="400" y="95" width="300" height="190" rx="12" fill="#344f50"/><g class="park-built" stroke="#a8d1bc" stroke-width="12"><path d="M440 245V195M490 245V155M540 245V185M590 245V135M640 245V165"/></g><g class="park-visitors park-done">{[0,1,2].map(i=><g transform={`translate(${90+i*65},220)`}><circle cy="-20" r="17" fill="#e5bc91"/><path d="M-15 5H15V55H-15Z" fill="var(--park-paint)"/></g>)}</g></g>}
 {kind==='opening'&&<g><g class="park-built">{[0,1,2,3].map(i=><g transform={`translate(${210+i*135},150)`}><rect y="30" width="105" height="100" fill="#faf7ef"/><path d="M-10 30L52 -10L115 30Z" fill={i%2?'#edc474':'var(--park-paint)'}/>{i===0?<circle cx="52" cy="68" r="18" fill="#b8c8ab"/>:i===1?<path d="M35 95V50H70V95Z" fill="#d3e5e6"/>:i===2?<path d="M35 95V65L52 40L70 65V95Z" fill="#d3e5e6"/>:<path d="M20 75Q35 50 50 75T80 75" fill="none"/>}</g>)}</g><path d="M140 320V125M770 320V125M140 125Q450 0 770 125" fill="none" stroke-width="14"/><path class="park-gate" d="M145 315V235H450V315" fill="var(--park-paint)"/><g class="park-done park-visitors">{[0,1,2,3,4].map(i=><g transform={`translate(${260+i*80},290)`}><circle cy="-17" r="14" fill="#e5bc91"/><path d="M-12 3H12V40H-12Z" fill={i%2?'#edc474':'var(--park-paint)'}/></g>)}</g></g>}
 </g>
</svg></div>
