---
import type { Locale } from '../../math/core/types';
import type { AdventureStep } from '../../content/grade1/adventures';
interface Props { step: AdventureStep; locale: Locale; lessonId: string; stepIndex: number }
const { step, locale, lessonId, stepIndex } = Astro.props;
const es = locale === 'es-AR';
const { kind } = step;
const start = lessonId === 'G01-06-L03' && stepIndex === 0 ? 2 : lessonId === 'G01-08-L02' ? 3 : lessonId === 'G01-03-L02' ? 1 : 0;
const direction = lessonId === 'G01-06-L03' && stepIndex === 0 ? -1 : 1;
const showTransform = !!step.after;
const interactiveLabel = es ? 'Tocá los objetos para marcarlos. Podés explorar antes de elegir tu respuesta.' : 'Tap objects to mark them. You can explore before choosing your answer.';
---
<div class:list={['story-model', `story-model-${kind}`]} data-story-model data-kind={kind} data-target={lessonId === 'G01-03-L02' ? (stepIndex === 0 ? 2 : 1) : undefined} data-start={start} data-direction={direction} data-step-index={stepIndex}>
  <p class="story-model-instruction">{interactiveLabel}</p>
  {[step.rows, ...(step.after ? [step.after] : [])].map((rows, version) => <div data-story-view={version} hidden={version === 1}>
    {rows.map((row, rowIndex) => <div class="story-model-row">
      <p class="story-row-label">{row.label[locale]}</p>
      <div class:list={['story-items', { 'story-ten-frame': kind === 'groups' && row.items.length === 10, 'story-map': kind === 'route', 'story-timeline': kind === 'track', 'story-week': kind === 'calendar', 'story-ruler': kind === 'measure' || kind === 'lengths' }]} data-story-items>
        {row.items.length === 0 && <span class="story-empty">{es ? 'Ninguna · 0' : 'None · 0'}</span>}
        {row.items.map((item, index) => <button type="button" class:list={['story-item', { 'story-item-ten': kind === 'tens' && item[locale] === '10', 'story-person': kind === 'people', 'story-item-small': kind === 'sorting' && (version === 1 ? (stepIndex === 1 ? rowIndex === 0 : index === 0) : (stepIndex === 1 ? index === 0 || index === 3 : index < 2)) }]} data-story-item data-item-index={index} data-row-index={rowIndex} data-item-value={item[locale]} aria-pressed="false" aria-label={`${row.label[locale]} · ${index + 1}: ${item[locale]}`}>
          {kind === 'people' && <svg class="story-person-art" viewBox="0 0 64 82" aria-hidden="true"><circle cx="32" cy="24" r="17" fill={index % 2 ? '#bc8764' : '#e6b88e'}/><path d="M15 24q-8-25 18-24 25 2 15 27l-5-17q-10 12-27 6z" fill={index % 2 ? '#493a32' : '#79553b'}/><path d="M9 77V56q23-25 46 0v21" fill={['#bd8872','#7d9f96','#dbb65d','#9c97b7','#9eaf7b'][index % 5]}/><circle cx="25" cy="25" r="2"/><circle cx="39" cy="25" r="2"/><path d="M26 34q6 5 12 0" fill="none" stroke="#754c38" stroke-width="2"/></svg>}
          {kind === 'tens' && item[locale] === '10' ? <><span class="story-ten-dots" aria-hidden="true">{Array.from({length:10}, () => <i></i>)}</span><span>10</span></> : kind === 'solids' ? <>
            <svg class="story-solid-art" viewBox="0 0 100 100" aria-hidden="true">
              {['Ball','Pelota'].includes(item[locale]) ? <><circle cx="50" cy="50" r="35" fill="#d9ac5f"/><ellipse cx="40" cy="39" rx="20" ry="21" fill="#eccb85"/><path d="M21 56q29 22 57-1M49 15q-19 35 0 70" fill="none" stroke="#a98442" stroke-width="3"/></> : ['Square','Cuadrado'].includes(item[locale]) ? <rect x="20" y="20" width="60" height="60" fill="#9bbab0" stroke="#557970" stroke-width="3"/> : ['Can','Lata'].includes(item[locale]) ? <><path d="M22 25v52q28 20 56 0V25" fill="#c58b72"/><ellipse cx="50" cy="25" rx="28" ry="12" fill="#e1b294"/><path d="M22 77q28 20 56 0" fill="none" stroke="#90674e" stroke-width="3"/></> : <><path d="m15 30 35-17 35 17-35 17z" fill="#c1d5b8"/><path d="m15 30 35 17v40L15 67z" fill="#8eaf92"/><path d="m50 47 35-17v37L50 87z" fill="#618e78"/><circle cx="32" cy="58" r="4" fill="#f9f7e8"/></>}
            </svg><span>{item[locale]}</span>
          </> : <span class:list={['story-item-content', { 'story-square': kind === 'shapes' && item[locale] === '□' }]}>{item[locale]}</span>}
          <span class="story-item-mark" aria-hidden="true">✓</span>
          {kind === 'track' && <span class="story-track-marker" aria-hidden="true">●</span>}
        </button>)}
      </div>
    </div>)}
  </div>)}
  <div class="story-explore-controls">
    {showTransform && <button type="button" data-story-transform>{es ? 'Ver el cambio ↔' : 'See the change ↔'}</button>}
    {kind === 'track' && <button type="button" data-story-hop>{es ? 'Mover un paso' : 'Move one step'} {direction === -1 ? '←' : '→'}</button>}
    {kind === 'route' && <div class="story-directions" role="group" aria-label={es ? 'Mover en el mapa' : 'Move on the map'}>{[['up','↑',es?'Arriba':'Up'],['left','←',es?'Izquierda':'Left'],['down','↓',es?'Abajo':'Down'],['right','→',es?'Derecha':'Right']].map(([value, arrow, label]) => <button type="button" data-story-direction={value} aria-label={label}>{arrow}</button>)}</div>}
    {kind === 'shapes' && stepIndex === 1 && <button type="button" data-story-rotate>{es ? 'Girar el cuadrado ↻' : 'Turn the square ↻'}</button>}
    {kind === 'lengths' && stepIndex === 1 && <button type="button" data-story-align>{es ? 'Mover / alinear los comienzos' : 'Move / align the starting ends'}</button>}
    {kind === 'measure' && stepIndex === 1 && <button type="button" data-story-gaps>{es ? 'Separar / juntar las unidades' : 'Separate / join the units'}</button>}
    {kind === 'plant' && <button type="button" data-story-sequence>{es ? 'Ver el siguiente paso →' : 'See the next step →'}</button>}
    <button type="button" data-story-scene-reset>{es ? 'Reiniciar la escena' : 'Reset the scene'}</button>
  </div>
  <p class="story-explore-status" data-story-explore-status role="status" aria-live="polite"></p>
</div>
