---
import type {OceanScene} from '../../content/grade6/oceanAdventure';
const {kind='archive',preview=false}=Astro.props as {kind?:OceanScene;preview?:boolean};
const shore=['archive','kits','supplies','market','park'].includes(kind);
---
<div class="ocean-stage" data-ocean-stage data-kind={kind} data-phase={preview?'complete':'start'} aria-hidden="true"><svg viewBox="0 0 900 380" xmlns="http://www.w3.org/2000/svg">
<rect width="900" height="380" rx="24" fill={shore?'#dceeed':'#163e58'}/>
{shore?<><circle cx="760" cy="65" r="32" fill="#efd08c"/><path d="M0 270Q150 250 300 270T600 270T900 270V380H0Z" fill="#79b6bd"/><path d="M0 315H900V380H0Z" fill="#dcc9a4"/></>:<><path d="M100 0l180 320H140L40 0m520 0 120 320h-45L500 0" fill="#28647a" opacity=".4"/><path d="M0 330Q220 285 450 330T900 320V380H0Z" fill="#426e77"/>{[90,160,780,835].map(x=><path d={`M${x} 340q-30-35 0-70t0-50`} fill="none" stroke="#75a997" stroke-width="10" stroke-linecap="round"/>)}<path d="M695 100l35-15 22 15-22 15zM180 140l25-10 20 10-20 10z" fill="#c4c59a"/></>}
{kind==='archive'&&<><rect x="210" y="110" width="90" height="100" rx="12" fill="#526b75"/><circle cx="290" cy="155" r="18" fill="#c3dbe2"/><path class="ocean-built" d="M310 150L610 80V270Z" fill="#f7e7ab" opacity=".6"/><rect x="550" y="70" width="225" height="220" rx="8" fill="#f5e7c8" stroke="#7a8273" stroke-width="6"/><g class="ocean-done"><path d="M580 240q35-100 80-45t75-85" fill="none" stroke="#5b9695" stroke-width="7" stroke-dasharray="12 8"/><path d="M680 125h45v35h-45z" fill="var(--ocean-paint,#378d8b)"/><circle cx="700" cy="144" r="8" fill="#e9d49c"/></g><path d="M190 220h150m-120 0v90m100-90v90" stroke="#997b5a" stroke-width="12"/></>}
{kind==='kits'&&<><path d="M230 250h440m-410 0v70m380-70v70" stroke="#8f785e" stroke-width="13"/><g class="ocean-built"><path d="M320 225v-60m-16 10 16 15 16-15m70 50v-45h36v45" fill="none" stroke="#506c80" stroke-width="10"/></g><g class="ocean-done" fill="var(--ocean-paint,#378d8b)" stroke="#294e61" stroke-width="4"><rect x="280" y="195" width="140" height="55" rx="8"/><rect x="460" y="195" width="140" height="55" rx="8"/><path d="M280 205h140m40 0h140"/></g></>}
{kind==='beacons'&&<><path d="M260 320V180h50v140m280 0V180h50v140" fill="#c5bd9b"/><circle cx="285" cy="165" r="27" fill="#44697b"/><circle cx="615" cy="165" r="27" fill="#44697b"/><g class="ocean-built"><circle cx="285" cy="165" r="24" fill="#f4d68b"/><path d="M305 160l120-70v150z" fill="#f4d68b" opacity=".3"/></g><g class="ocean-done"><circle cx="615" cy="165" r="24" fill="#f4d68b"/><path d="M595 160l-120-70v150z" fill="#f4d68b" opacity=".3"/><path d="M410 320h80v-65h-80" fill="#a2c7b3"/></g></>}
{kind==='supplies'&&<g class="ocean-ship"><path d="M150 260h310l-45 62H205z" fill="#375c70"/><path d="M280 260v-70h100v70" fill="#e9e1c8"/><path d="M295 205h65v30h-65z" fill="#8bb9c7"/><g class="ocean-built"><rect x="200" y="220" width="55" height="40" rx="4" fill="#d5a674"/><rect x="390" y="220" width="45" height="40" rx="4" fill="#d5a674"/></g></g>}
{kind==='sub'&&<g class="ocean-sub"><rect x="270" y="175" width="300" height="100" rx="50" fill="var(--ocean-paint,#378d8b)"/><path d="M280 195l-35-25v110l35-25" fill="#d9b579"/><g class="ocean-built"><path d="M375 175v-38h95v38" fill="#c7ddd8"/><circle cx="475" cy="225" r="30" fill="#b7dbea" stroke="#ecd4a1" stroke-width="8"/><path d="M415 137v-35h35" fill="none" stroke="#a6c6ca" stroke-width="10"/></g><path class="ocean-done" d="M570 220l165-55v120z" fill="#f1dfa6" opacity=".3"/></g>}
{['workshop','robots','floor'].includes(kind)&&<><path d="M290 310V145q150-90 300 0v165z" fill="#638f9a" stroke="#a9c5c9" stroke-width="7"/>
{kind==='workshop'&&<><rect class="ocean-built" x="370" y="200" width="140" height="95" rx="10" fill="var(--ocean-paint,#378d8b)"/><path class="ocean-done" d="M435 180l-23 46h26l-12 38 38-53h-25l16-31" fill="#f4d68b"/></>}
{kind==='robots'&&<><path d="M330 220h85m60 0h70" stroke="#b1c9c9" stroke-width="18"/><path class="ocean-done" d="M410 220h70" stroke="#dfbe7c" stroke-width="18"/><g class="ocean-robot"><rect x="200" y="270" width="65" height="45" rx="12" fill="#e4bc78"/><path d="M260 280l40-35 30 10" fill="none" stroke="#aec8cc" stroke-width="8"/><circle cx="220" cy="315" r="12" fill="#233e50"/><circle cx="250" cy="315" r="12" fill="#233e50"/></g></>}
{kind==='floor'&&<><path class="ocean-built" d="M320 305v-95h240v95z" fill="none" stroke="#e4c48d" stroke-width="8"/><g class="ocean-done"><path d="M320 265h240v40H320z" fill="#a4cbb6"/><path d="M360 265v40m40-40v40m40-40v40m40-40v40m40-40v40" stroke="#577f84" stroke-width="3"/></g></>}
</>}
{kind==='market'&&<><path d="M220 300v-150h240v150" fill="#f1dfb8" stroke="#668589" stroke-width="6"/><path d="M200 150l45-55h190l45 55z" fill="var(--ocean-paint,#378d8b)"/><g class="ocean-order ocean-built"><rect x="300" y="240" width="80" height="60" rx="8" fill="#bd9160"/><path d="M340 240v60" stroke="#e9c995" stroke-width="8"/></g><rect x="645" y="235" width="120" height="70" rx="10" fill="#b7d3cf"/></>}
{kind==='chart'&&<><rect x="220" y="90" width="460" height="230" rx="15" fill="#e0dbc0"/><path d="M270 280l110-100 110 40 120-90" fill="none" stroke="#859c94" stroke-width="4" stroke-dasharray="9 9"/><path class="ocean-built" d="M270 280l110-100 110 40 120-90" fill="none" stroke="#b77d4f" stroke-width="7"/><g class="ocean-marker"><circle cx="270" cy="280" r="16" fill="var(--ocean-paint,#378d8b)"/><path d="M260 280h20m-10-10v20" stroke="#fff" stroke-width="3"/></g></>}
{kind==='report'&&<><rect x="260" y="155" width="280" height="145" rx="18" fill="#93b1b5"/><rect x="280" y="175" width="240" height="100" rx="10" fill="#213f56"/><g class="ocean-built" stroke="#b6d2bd" stroke-width="7"><path d="M305 200h185m-185 23h150m-150 23h165"/></g><path d="M630 310v-100m-40-60q40 70 80 0" fill="none" stroke="#a5c3c9" stroke-width="10"/><path class="ocean-done" d="M610 120q20-20 40 0m-55-20q35-35 70 0" fill="none" stroke="#e8cb88" stroke-width="6"/></>}
{kind==='park'&&<><path d="M230 320v-100h430v100" fill="#a0bdac" stroke="#72928c" stroke-width="5"/><path d="M440 320v-95" stroke="#e8d4a8" stroke-width="40"/><g class="ocean-built">{[290,350,535,595].map(x=><g><path d={`M${x} 290v-40`} stroke="#637e59" stroke-width="5"/><circle cx={x} cy="245" r="24" fill="#5b987d"/></g>)}</g><g class="ocean-done"><rect x="375" y="150" width="130" height="60" rx="8" fill="var(--ocean-paint,#378d8b)"/><path d="M390 190l25-15 22 12 30-20" fill="none" stroke="#f2d594" stroke-width="5"/>{[400,480].map(x=><g><circle cx={x} cy="290" r="11" fill="#dba77e"/><path d={`M${x} 305v30`} stroke="#36596c" stroke-width="13"/></g>)}</g></>}
</svg></div>
