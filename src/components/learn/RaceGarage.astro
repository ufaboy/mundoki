---
// Chispa's garage: the season's upgrade tree drawn on the car. Parts from
// earlier missions are already on the car; parts this mission installs light
// up when their challenge is solved (data-race-part-question). On the map
// (`tree`), every part is shown faint with the stage that installs it.
import type { Locale } from '../../math/core/types';
import { RACE_PARTS, RACE_PART_STAGE, type RacePart } from '../../content/grade6/racingAdventure';
interface Props { locale: Locale; installed?: RacePart[]; incoming?: { part: RacePart; question: number }[]; tree?: boolean }
const { locale, installed = [], incoming = [], tree = false } = Astro.props;
const es = locale === 'es-AR';
const parts = Object.keys(RACE_PARTS) as RacePart[];
const state = (part: RacePart) => installed.includes(part) ? 'installed' : incoming.some(i => i.part === part) ? 'incoming' : 'locked';
const question = (part: RacePart) => incoming.find(i => i.part === part)?.question;
const attrs = (part: RacePart) => ({ 'data-race-part': part, 'data-state': state(part), 'data-race-part-question': question(part) });
const count = installed.length;
---
<section class="race-garage" data-race-garage aria-label={es ? 'Garaje de Chispa' : 'Chispa’s garage'}>
 <div class="race-garage-head"><h2>🔧 {es ? 'Garaje de Chispa' : 'Chispa’s garage'}</h2>{!tree && <span><span data-race-garage-count>{count}</span> / {parts.length} {es ? 'mejoras' : 'upgrades'}</span>}</div>
 <svg viewBox="0 0 640 250" role="img" aria-label={es ? 'Chispa con sus mejoras' : 'Chispa with its upgrades'}>
  <rect width="640" height="250" rx="18" fill="#f1ece4"/><path d="M0 222H640" stroke="#cfc4b4" stroke-width="6"/>
  <path d="M80 190 110 150 250 140 300 112 380 112 400 140 540 150 560 176V190Z" fill="none" stroke="#a99b8b" stroke-width="3" stroke-dasharray="8 6"/>
  <g {...attrs('chassis')} class="race-part"><path d="M80 190 110 150 250 140 300 112 380 112 400 140 540 150 560 176V190Z" fill="var(--race-paint,#d4453b)" stroke="#5a1f1a" stroke-width="3"/></g>
  <g {...attrs('engine')} class="race-part"><rect x="125" y="150" width="80" height="28" rx="6" fill="#59616b"/><path d="M168 154l-12 12h10l-6 10 14-14h-10l6-8" fill="#f2c14e"/></g>
  <g {...attrs('cooling')} class="race-part"><rect x="410" y="152" width="70" height="28" rx="5" fill="#3a4a58"/>{[0,1,2,3,4].map(i => <path d={`M${418 + i * 13} 156v20`} stroke="#9fd3e8" stroke-width="4"/>)}</g>
  <g {...attrs('number')} class="race-part"><circle cx="255" cy="166" r="20" fill="#fff" stroke="#222" stroke-width="2"/><text x="255" y="173" text-anchor="middle" font-size="20" font-weight="800" fill="#222">23</text></g>
  <g {...attrs('wheel')} class="race-part"><circle cx="320" cy="122" r="11" fill="none" stroke="#222" stroke-width="5"/><path d="M320 111v22M309 122h22" stroke="#222" stroke-width="3"/></g>
  <g {...attrs('driver')} class="race-part"><circle cx="350" cy="100" r="20" fill="#f6d36b" stroke="#8a6b12" stroke-width="3"/><path d="M350 88l4 8 9 1-7 6 2 9-8-5-8 5 2-9-7-6 9-1z" fill="#d4453b"/></g>
  <g {...attrs('telemetry')} class="race-part"><path d="M392 112 402 58" stroke="#59616b" stroke-width="4"/><circle cx="403" cy="54" r="6" fill="#5aa0d8"/><path d="M412 46q8 8 0 16M420 40q14 14 0 28" fill="none" stroke="#5aa0d8" stroke-width="3"/></g>
  <g {...attrs('wing')} class="race-part"><path d="M548 178h72v12h-80z" fill="#2f3237"/><path d="M612 170v20" stroke="#2f3237" stroke-width="6"/></g>
  <g {...attrs('rearWing')} class="race-part"><path d="M100 150V100" stroke="#2f3237" stroke-width="7"/><rect x="58" y="88" width="90" height="16" rx="4" fill="#2f3237"/></g>
  {[170, 470].map(x => <>
   <circle cx={x} cy="192" r="32" fill="#1d1f22"/><circle cx={x} cy="192" r="14" fill="#9aa1a8"/>
   <g {...attrs('rainTires')} class="race-part"><circle cx={x} cy="192" r="25" fill="none" stroke="#5aa0d8" stroke-width="5" stroke-dasharray="7 7"/></g>
   <g {...attrs('brakes')} class="race-part"><circle cx={x} cy="192" r="11" fill="#d4453b"/></g>
   <g {...attrs('warmers')} class="race-part"><circle cx={x} cy="192" r="38" fill="none" stroke="#f08a3c" stroke-width="5" stroke-dasharray="10 6"/></g>
  </>)}
  <g {...attrs('spare')} class="race-part"><circle cx="30" cy="200" r="20" fill="#1d1f22"/><circle cx="30" cy="200" r="8" fill="#9aa1a8"/></g>
 </svg>
 <details class="race-garage-list"><summary>{tree ? (es ? 'Las mejoras de la temporada' : 'The season’s upgrades') : (es ? 'Ver todas las mejoras' : 'See all upgrades')}</summary><ul>{parts.map(part => <li data-race-part-item={part} data-state={tree ? 'locked' : state(part)}><span class="race-part-mark" aria-hidden="true"></span>{RACE_PARTS[part][locale]} <small>· {es ? 'Etapa' : 'Stage'} {RACE_PART_STAGE[part]}</small></li>)}</ul></details>
</section>
