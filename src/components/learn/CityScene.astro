---
import type { CitySceneKind } from '../../content/grade3/cityAdventure';
const {kind='build',preview=false}=Astro.props as {kind?:CitySceneKind;preview?:boolean};
---
<div class:list={['city-stage',`city-scene-${kind}`,{'city-stage-preview':preview}]} data-city-stage data-steps={preview?'2':'0'}>
 <svg class="city-world" viewBox="0 0 900 360" aria-hidden="true">
  <path d="M0 0h900v360H0z" fill="#e7f0eb"/><circle cx="777" cy="65" r="32" fill="#efd289"/><path d="M0 208q160-70 320-5t320 0 260 0v157H0z" fill="#d3dfbd"/><path d="M0 285h900v75H0z" fill="#d1c5a5"/><path d="M0 310h900" stroke="#faf1d6" stroke-width="5" stroke-dasharray="22 18"/>
  {Array.from({length:7},(_,i)=><g class="city-neighborhood" data-city-building={i+1} transform={`translate(${30+i*122} ${145+(i%2)*20})`} opacity={preview?1:.15}><rect x="0" y="25" width="85" height="90" rx="4" fill={['var(--city-paint,#ce9879)','#b9b983','#94b7ac'][i%3]}/><path d="m-6 25 48-33 49 33z" fill="#8a9d87"/><rect x="12" y="42" width="18" height="22" rx="2" fill="#f9edc8"/><rect x="54" y="42" width="18" height="22" rx="2" fill="#f9edc8"/><rect x="34" y="78" width="20" height="37" rx="5" fill="#7d8d75"/></g>)}
  {!preview && <>
   <path d="M180 282h550" stroke="#f7efd8" stroke-width="18" stroke-linecap="round"/>
   {kind==='build' && <><g class="city-crane"><path d="M260 275V60h220M240 275h40M243 65h60m-43 0 30 27-30 27 30 27-30 27 30 27-30 27" fill="none" stroke="#cb9b50" stroke-width="10"/><path d="M460 64v66" stroke="#65817b" stroke-width="4"/><path class="city-crane-hook" d="M448 130h24v15h-24z" fill="#7a9690"/></g><rect x="350" y="255" width="210" height="20" rx="3" fill="#a2aca0"/><g class="city-effect-one"><rect x="362" y="146" width="185" height="110" rx="5" fill="var(--city-paint,#ce9879)"/><rect x="390" y="177" width="35" height="40" rx="4" fill="#f7edc9"/><rect x="480" y="177" width="35" height="40" rx="4" fill="#f7edc9"/></g><g class="city-effect-two"><path d="m345 146 110-69 109 69z" fill="#748e7b"/><rect x="440" y="213" width="32" height="43" rx="7" fill="#6d8977"/></g></>}
   {kind==='delivery' && <><g class="city-moving-truck"><rect x="185" y="183" width="170" height="80" rx="6" fill="var(--city-paint,#ce9879)"/><path d="M355 211h63l28 34v18h-91z" fill="#b5c6a6"/><path d="M365 220h44l18 22h-62z" fill="#e0efea"/><circle cx="230" cy="267" r="22" fill="#526b62"/><circle cx="398" cy="267" r="22" fill="#526b62"/><path d="M206 196h125v50H206z" fill="#e6c895"/></g><g class="city-effect-one"><rect x="602" y="225" width="43" height="47" fill="#c5a476"/><path d="M623 225v47" stroke="#efe0b3" stroke-width="6"/></g><g class="city-effect-two"><rect x="652" y="225" width="43" height="47" fill="#bd9666"/><rect x="624" y="178" width="43" height="47" fill="#d6b889"/><path d="M645 178v47m28 0v47" stroke="#efe0b3" stroke-width="6"/></g></>}
   {kind==='bakery' && <><rect x="270" y="135" width="360" height="140" rx="10" fill="var(--city-paint,#ce9879)"/><path d="M260 135h380l-25-45H285z" fill="#ecd7ab"/><path d="M290 90v45m55-45v45m55-45v45m55-45v45m55-45v45m55-45v45m55-45v45" stroke="#bd8968" stroke-width="22"/><rect x="300" y="163" width="300" height="78" rx="7" fill="#fbf2d8"/><g class="city-effect-one"><path d="M315 224q0-45 45-45t45 45z" fill="#d4a45c"/><path d="m340 191 12 23m18-26 12 26" stroke="#f7df9c" stroke-width="6"/></g><g class="city-effect-two"><path d="M435 224q0-45 45-45t45 45z" fill="#c7934f"/><path d="m460 191 12 23m18-26 12 26" stroke="#f7df9c" stroke-width="6"/><circle cx="564" cy="207" r="18" fill="#e6c380"/></g></>}
   {kind==='bus' && <><path d="M680 270V140" stroke="#6d8d80" stroke-width="8"/><rect x="651" y="110" width="59" height="48" rx="10" fill="#edf3dd" stroke="#79978a" stroke-width="4"/><path d="M664 125h32v18h-32z" fill="#9fb4a0"/><g class="city-waiting-people"><circle cx="600" cy="213" r="12" fill="#bd9474"/><path d="M586 254v-22h28v22" fill="#a6ae7c"/><circle cx="638" cy="216" r="10" fill="#d3ad88"/><path d="M626 254v-18h24v18" fill="#b98c78"/></g><g class="city-moving-bus"><rect x="180" y="184" width="280" height="80" rx="14" fill="var(--city-paint,#ce9879)"/>{[202,256,310,364].map(x=><rect x={x} y="196" width="38" height="30" rx="5" fill="#e4f1e7"/>)}<circle cx="236" cy="267" r="22" fill="#506c61"/><circle cx="399" cy="267" r="22" fill="#506c61"/><path d="M191 239h256" stroke="#f1dfae" stroke-width="6"/><g class="city-effect-two"><circle cx="276" cy="215" r="8" fill="#bc9477"/><circle cx="330" cy="215" r="8" fill="#d3ad88"/></g></g></>}
   {kind==='park' && <><ellipse cx="458" cy="250" rx="135" ry="30" fill="#b7cba3"/><path d="M387 231h142l-20 31H406z" fill="#a3b9ae"/><path d="M458 231v-58" stroke="#7f9d91" stroke-width="15"/><g class="city-effect-one"><path d="M250 268v-80m-20 30 20 20 24-28" stroke="#9a8962" stroke-width="10"/><circle cx="251" cy="166" r="42" fill="#99b382"/><circle cx="231" cy="189" r="30" fill="#adc491"/><path d="M610 266v-70" stroke="#9a8962" stroke-width="9"/><circle cx="610" cy="181" r="40" fill="#a4bf8f"/></g><g class="city-effect-two city-fountain-water"><path d="M458 187q-45-80-74 28m74-28q45-80 74 28m-74-28v-60" fill="none" stroke="#75b6c1" stroke-width="8" stroke-linecap="round"/><ellipse cx="458" cy="235" rx="60" ry="10" fill="#9dced2"/></g></>}
   {kind==='repair' && <><path d="M245 280h415" stroke="#9cc6c8" stroke-width="35"/><path d="M225 254h100m250 0h100" stroke="#a68d68" stroke-width="20"/><path class="city-effect-one" d="M325 254h125" stroke="#c9ac7b" stroke-width="20"/><path class="city-effect-two" d="M450 254h125" stroke="#c9ac7b" stroke-width="20"/><g class="city-repair-barrier"><path d="M270 251v-60m-42 11h85" stroke="#a08658" stroke-width="9"/><path d="M228 201h85" stroke="#f1c778" stroke-width="17" stroke-dasharray="15 10"/></g></>}
   {kind==='festival' && <><rect x="340" y="222" width="225" height="50" rx="5" fill="#b79670"/><path d="M315 220h275" stroke="#e6cda0" stroke-width="12"/><g class="city-effect-one"><path d="M205 109q240 110 490 0" fill="none" stroke="#81977c" stroke-width="3"/>{[250,330,410,490,570,650].map((x,i)=><path d={`m${x} ${135+(i<3?i:5-i)*9} 24 6-17 30z`} fill={['#c98e72','#b1bc83','#87b2aa'][i%3]}/>)}</g><g class="city-effect-two"><path d="M250 268v-85m390 85v-85" stroke="#8b9c7a" stroke-width="2"/><ellipse cx="250" cy="160" rx="22" ry="30" fill="#d8a97c"/><ellipse cx="640" cy="160" rx="22" ry="30" fill="#98bbaa"/>{[380,440,500].map((x,i)=><g><circle cx={x} cy="196" r="12" fill={i%2?'#bd9474':'#d9ae87'}/><path d={`M${x-14} 244v-30h28v30`} fill={['#b0b781','#b88c78','#87a9a0'][i]}/></g>)}</g></>}
  </>}
 </svg>
</div>
