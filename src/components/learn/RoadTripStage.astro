---
import type { Locale } from '../../math/core/types';
import { roadSceneState } from '../../content/grade2/roadTrip';
import RoadTripCar from './RoadTripCar.astro';
const {locale,index}=Astro.props as {locale:Locale;index:number};
const es=locale==='es-AR';
const state=roadSceneState(index,0);
const labels={shop:es?'SALÓN DE AUTOS':'CAR SHOWROOM',repair:es?'TALLER DE REPARACIÓN':'REPAIR WORKSHOP',upgrade:es?'ESTUDIO DE MEJORAS':'UPGRADE STUDIO',harbor:es?'PUERTO':'HARBOR',ferry:es?'TRAVESÍA EN FERRY':'FERRY CROSSING',island:es?'ISLA':'ISLAND',bridge:es?'EL PUENTE':'THE BRIDGE',delivery:es?'GARAJE DE LA ISLA':'ISLAND GARAGE'};
---
<div class:list={['road-playfield',`road-stage-${state.scene}`,{'road-on-trip':state.driving,'road-at-sea':index>=30}]} data-road-stage data-steps="0" data-van-available={state.vanAvailable} style={`--road-distance:${state.distance}%;--ferry-progress:${state.ferryProgress}%`}>
 <div class="road-scenery" aria-hidden="true"><span class="road-sun"></span><span class="road-hill road-hill-a"></span><span class="road-hill road-hill-b"></span><div class="road-garage-wall"><span>01</span><span>02</span><span>03</span></div><span class="road-destination">{index>=30?'🏫':'🌴'}</span><div class="road-ground"></div></div>
 <div class="road-scene-label">{labels[state.scene]}</div>
 {state.scene==='shop' && <><div class="road-shop-banner">{es?'Elegir · revisar · comprar':'Choose · check · buy'}</div><div class="road-shop-key" aria-hidden="true">🔑</div><div class="road-shop-card"><span>{es?'Compra de juego':'Pretend purchase'}</span><span class="road-scene-stamps" aria-hidden="true"><b>✓</b><b>✓</b></span></div></>}
 {state.scene==='repair' && <><div class="road-lift" aria-hidden="true"><i></i><i></i><b></b></div><div class="road-repair-tools" aria-hidden="true">🔧<span>⚙</span></div><div class="road-repair-faults" aria-hidden="true"><i>!</i><i>!</i></div></>}
 {state.scene==='upgrade' && <div class="road-upgrade-board" aria-hidden="true"><span>🎨</span><span>✦</span><span>🧳</span></div>}
 {(state.scene==='ferry'||state.scene==='harbor') && <><div class="road-water" aria-hidden="true"></div><div class="road-dock road-dock-left" aria-hidden="true"></div><div class="road-dock road-dock-right" aria-hidden="true"></div><div class="road-port-cargo" aria-hidden="true"><span>📦</span><span>📦</span><span>📦</span></div><svg class="road-ferry-boat" viewBox="0 0 500 170" aria-hidden="true"><path d="M20 93h460l-44 58H73z" fill="#396d80"/><path d="M34 108h429" stroke="#f6c776" stroke-width="10"/><rect x="62" y="49" width="80" height="44" rx="7" fill="#fff6db"/><path d="M56 50h95" stroke="#b2cbd0" stroke-width="9"/><rect x="75" y="60" width="24" height="18" rx="3" fill="#91bdc8"/><rect x="107" y="60" width="24" height="18" rx="3" fill="#91bdc8"/><path d="M162 91h288m-280 0V70m55 21V70m55 21V70m55 21V70m55 21V70m55 21V70" stroke="#dae8dd" stroke-width="4"/><path class="road-ferry-ramp" d="m449 92 45-30" stroke="#b5c2b2" stroke-width="10"/><circle cx="110" cy="126" r="11" fill="#f6edca"/><circle cx="390" cy="126" r="11" fill="#f6edca"/></svg></>}
 {state.scene==='island' && <div class="road-island-gate" aria-hidden="true"><span>△</span><i></i><b></b></div>}
 {state.scene==='bridge' && <div class="road-bridge" aria-hidden="true"><span></span><i></i><i></i><span></span></div>}
 <div class="road-car-position" data-road-car><div data-road-car-art><RoadTripCar/></div><svg class="road-van" data-road-van-art hidden viewBox="0 0 560 290" aria-hidden="true"><ellipse cx="280" cy="255" rx="230" ry="15" fill="#203e4220"/><path d="M65 210V85q0-25 25-25h248q25 0 40 25l39 60h58q25 0 25 28v48H65z" fill="var(--car-paint,#e9ad56)" stroke="#6d7762" stroke-width="4"/><path d="M325 82h26l41 65h-67z" fill="#c6e4e7"/><rect x="94" y="87" width="191" height="99" rx="9" fill="#f7e7bf"/><path d="M190 88v97" stroke="#b5a987" stroke-width="4"/><path d="M339 171h22" stroke="#fff4ce" stroke-width="7"/><circle cx="142" cy="224" r="43" fill="#253e46"/><circle cx="422" cy="224" r="43" fill="#253e46"/><circle cx="142" cy="224" r="22" fill="#d4dfd6"/><circle cx="422" cy="224" r="22" fill="#d4dfd6"/><path d="m150 120 40-19 40 19-40 22z" fill="#c99460"/><path d="m150 120 40 22 40-22v35l-40 20-40-20z" fill="#ae8057"/><rect x="476" y="165" width="24" height="20" rx="5" fill="#fff0ad"/></svg></div>
 <div class="road-step-badges" aria-label={es?'Desafíos de la misión':'Mission challenges'}><span data-road-badge="0">1</span><span aria-hidden="true">—</span><span data-road-badge="1">2</span></div>
 <div class="road-reward" data-road-reward hidden role="status" aria-live="polite"><span aria-hidden="true">✦</span><p data-road-reward-text></p></div>
</div>
