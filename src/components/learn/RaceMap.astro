---
// Grade 6 Math Racing championship map: the season's stages and missions.
import type {Locale} from '../../math/core/types';
import {RACE_CHAPTERS,RACE_MISSIONS} from '../../content/grade6/racingAdventure';
import {GRADE_SIX_LESSONS,GRADE_SIX_PROJECT} from '../../content/grade6';
import {buildCatalogUrl,buildSchoolLessonUrl} from '../../i18n/routes';
import RaceScene from './RaceScene.astro';
import RaceChoices from './RaceChoices.astro';
import RaceGarage from './RaceGarage.astro';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<div class="city-adventure city-map race-adventure" data-race-root data-race-map data-locale={locale}>
<nav class="city-top"><a href={buildCatalogUrl(locale)}>← {es?'Todos los grados':'All grades'}</a><span>{es?'6.º GRADO':'GRADE 6'}</span><a href="#race-families">{es?'Para familias':'For families'}</a></nav>
<header class="city-map-hero"><div><p class="city-kicker">{es?'CARRERAS DE MATEMÁTICA':'MATH RACING'}</p><h1>{es?'La Copa Mundoki':'The Copa Mundoki'}</h1><p>{es?'Sé piloto de Chispa en un campeonato por toda la Argentina. Cada respuesta correcta da un acelerón, un turbo, una mejora o un atajo.':'Drive Chispa in a championship across Argentina. Every correct answer gives a boost, a turbo, an upgrade, or a shortcut.'}</p><a class="city-primary" href={buildSchoolLessonUrl(locale,'grade-6',RACE_MISSIONS[0].id)}>{es?'¡Al garaje!':'To the garage!'} →</a><a class="city-pick" href="#race-missions">{es?'Elegir una misión ↓':'Choose a mission ↓'}</a></div><div class="city-map-preview"><span>{es?'Tu próxima carrera':'Your next race'}</span><RaceScene kind="river" preview/></div></header>
<RaceChoices locale={locale}/>
<RaceGarage locale={locale} tree/>
<section id="race-missions"><div class="city-map-section"><h2 data-race-name-display>Escudería Pampa</h2><span>{RACE_MISSIONS.length} {es?'misiones · todas disponibles':'missions · all available'}</span></div>
{RACE_CHAPTERS.map((chapter,i)=><details class="city-district" id={`race-${chapter.id}`} open={i===0}><summary><span class="city-district-icon" aria-hidden="true">{chapter.icon}</span><span><span class="city-kicker">{es?'ETAPA':'STAGE'} {i+1}</span><strong>{chapter.title[locale]}</strong></span><span class="city-district-arrow" aria-hidden="true">⌄</span></summary><p class="race-chapter-opening">{chapter.opening[locale]}</p><ol class="city-mission-list" start={RACE_MISSIONS.indexOf(chapter.missions[0])+1}>{chapter.missions.map(mission=><li><a data-race-mission-link={mission.id} href={buildSchoolLessonUrl(locale,'grade-6',mission.id)}><span class="city-mission-number">{RACE_MISSIONS.indexOf(mission)+1}</span><strong>{mission.title[locale]}</strong><span class="city-mission-play">{es?'Jugar':'Play'} →</span></a></li>)}</ol></details>)}
</section>
<aside class="city-map-finale"><span aria-hidden="true">🏎️ 🏁 🏆</span><div><h2>{es?'¡A ganar la Copa!':'Win the Copa!'}</h2><p>{es?'Seis Grandes Premios y una final contra Nico Viento y su auto azul.':'Six Grands Prix and a final against Nico Viento and his blue car.'}</p></div></aside>
<details class="city-notebook" id="race-families"><summary>{es?'Para familias: qué aprendemos':'For families: what we learn'}</summary><div><p>{es?'Sistema decimal, divisibilidad, fracciones y decimales, proporcionalidad directa e inversa, porcentajes, perímetro y área, escala, gráficos y promedio. Cada desafío es una decisión de la carrera: sin cuenta correcta no hay acelerón.':'Decimal system, divisibility, fractions and decimals, direct and inverse proportionality, percentages, perimeter and area, scale, graphs, and the mean. Every challenge is a race decision: no correct calculation, no boost.'}</p><p>{es?'Todas las misiones están disponibles. Los resultados de las carreras son parte de la historia, no un puntaje; una respuesta incorrecta nunca causa un choque. Las respuestas no se guardan ni otorgan puntos de dominio. Solo el nombre de la escudería, el color y el emblema se recuerdan en este navegador.':'All missions are available. Race results are part of the story, not a score; a wrong answer never causes a crash. Answers are not saved and do not award mastery points. Only the team name, color, and emblem are remembered in this browser.'}</p><ul>{RACE_CHAPTERS.map(chapter=><li><a href={buildSchoolLessonUrl(locale,'grade-6',chapter.missions[0].id)}>{chapter.title[locale]}</a>: {chapter.packages.map(id=>GRADE_SIX_LESSONS.find(l=>l.packageId===id)!.objective[locale]).join(' ')}</li>)}</ul><section id="project"><h2>{GRADE_SIX_PROJECT.title[locale]}</h2><p>{GRADE_SIX_PROJECT.introduction[locale]}</p><ol>{GRADE_SIX_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es?'Cómo acompañar':'How to help'}</summary><ul>{GRADE_SIX_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>import '../../scripts/racingAdventure';</script>
