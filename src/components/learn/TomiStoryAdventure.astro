---
import type { Locale } from '../../math/core/types';
import { getGradeOneAdventure } from '../../content/grade1/adventures';
import { getGradeOneHints } from '../../content/grade1/hints';
import { GRADE_ONE_LESSONS, GRADE_ONE_PROJECT } from '../../content/grade1';
import { GRADE_ONE_ASSESSMENTS } from '../../content/grade1/assessments';
import { buildGradeOneLessonUrl, buildGradeUrl } from '../../i18n/routes';
import TomiCharacter from './TomiCharacter.astro';
import TomiRoomBackground from './TomiRoomBackground.astro';
import TomiAdventureScene from './TomiAdventureScene.astro';
import GradeOneChecks from './GradeOneChecks.astro';
const { locale, lessonId } = Astro.props as { locale: Locale; lessonId: string };
const lesson = GRADE_ONE_LESSONS.find(item => item.id === lessonId);
if (!lesson) throw new Error(`Missing lesson: ${lessonId}`);
const adventure = getGradeOneAdventure(lesson.id);
if (!adventure) throw new Error(`Missing adventure: ${lesson.id}`);
const es = locale === 'es-AR';
const hints = getGradeOneHints(lesson.id);
const position = GRADE_ONE_LESSONS.findIndex(item => item.id === lesson.id);
const previous = GRADE_ONE_LESSONS[position - 1];
const next = GRADE_ONE_LESSONS[position + 1];
const lastInPackage = !next || next.packageId !== lesson.packageId;
const outdoors = !['home'].includes(adventure.place) && lesson.packageId !== 'G01-14';
const placeLabels = {
  home: es ? 'EN CASA' : 'AT HOME', yard: es ? 'EN EL PATIO' : 'IN THE YARD',
  playground: es ? 'EN LA PLAZA' : 'AT THE PLAYGROUND', garden: es ? 'EN EL JARDÍN' : 'IN THE GARDEN',
  return: lesson.packageId === 'G01-14' ? (es ? 'DE VUELTA EN CASA' : 'BACK AT HOME') : (es ? 'NOS PREPARAMOS PARA VOLVER' : 'GETTING READY TO GO HOME'),
};
---
<article class:list={['tomi-adventure story-adventure', `story-place-${adventure.place}`]} data-story-adventure data-locale={locale} data-lesson-id={lesson.id}>
  <nav class="tomi-topline" aria-label={es ? 'La aventura' : 'The adventure'}><a href={buildGradeOneLessonUrl(locale, previous.id)}>← {es ? 'Episodio anterior' : 'Previous episode'}</a><a href={buildGradeUrl(locale, 'grade-1')}>{es ? 'LA GRAN PASEADA DE TOMI' : 'TOMI’S BIG DAY OUT'}</a><span class="tomi-chapter">{String(position + 1).padStart(2,'0')} / 35</span></nav>
  <header class="tomi-heading"><div><p>{placeLabels[adventure.place]}</p><h1>{adventure.title[locale]}</h1></div><span class="tomi-skill">✦ {lesson.title[locale]}</span></header>
  <section class="card-subtle stack-sm" aria-labelledby="story-example-title">
    <h2 id="story-example-title">{es ? 'Miremos un ejemplo' : 'Let’s try an example'}</h2>
    <p>{lesson.story[locale]}</p>
    <ol>{lesson.steps.map(step => <li>{step[locale]}</li>)}</ol>
    <p>{es ? 'Ahora te toca. Mirá la escena de abajo y probá con los objetos.' : 'Now it’s your turn. Look at the scene below and try it with the objects.'}</p>
  </section>
  <div class="tomi-game">
    <div class:list={['story-stage', { 'story-stage-outdoors': outdoors }]}>
      {outdoors ? <svg class="story-landscape" viewBox="0 0 1100 450" preserveAspectRatio="xMidYMid slice" aria-hidden="true"><path fill="#e2eff0" d="M0 0h1100v450H0z"/><circle cx="970" cy="70" r="38" fill="#f4d88b"/><path d="M0 290Q250 200 500 285t600-10v175H0" fill="#b8cf9b"/><path d="M0 380q500-170 1100-30v100H0" fill="#ebd8af"/><path d="M88 345V160m-18 52 18 20 27-35" stroke="#a78459" stroke-width="17"/><circle cx="88" cy="135" r="80" fill="#91b58d"/><circle cx="48" cy="165" r="53" fill="#9abf92"/><path d="M850 295h170v18H850m20 0v42m130-42v42" stroke="#ad9366" stroke-width="12"/><path d="M865 275h140v18H865" fill="#c3a778"/></svg> : <TomiRoomBackground />}
      <div class="story-host"><TomiCharacter /><p class="story-speech" data-story-speech>{adventure.steps[0].introduction[locale]}</p></div>
      {adventure.steps.map((step, index) => <div class="story-scene-panel" data-story-scene={index} hidden={index !== 0}>
        <TomiAdventureScene step={step} locale={locale} lessonId={lesson.id} stepIndex={index}/>
        <div class="story-prize" data-story-prize hidden><span aria-hidden="true">{step.symbol}</span><p>{step.reward[locale]}</p></div>
      </div>)}
      <div class="story-checkpoints" aria-label={es ? 'Pasos del episodio' : 'Episode steps'}><span data-story-checkpoint="0">1</span><span aria-hidden="true">—</span><span data-story-checkpoint="1">2</span></div>
    </div>
    <section class="tomi-task">
      {lesson.checks.map((check,index) => <div data-story-question={index} hidden={index !== 0} data-answer={check.answer} data-intro={adventure.steps[index].introduction[locale]}>
        <p class="tomi-eyebrow">{es ? 'PASO' : 'STEP'} {index+1} / 2</p>
        <h2 tabindex="-1" data-story-question-heading>{check.prompt[locale]}</h2>
        <div class="tomi-methods story-answer-options" role="group" aria-label={check.prompt[locale]}>{check.options.map((option,i) => <button type="button" data-story-answer={i}>{option[locale]}</button>)}</div>
        <p class="story-hint" data-story-hint hidden>{hints[index][locale]}</p>
        <p class="story-hint" data-story-explanation hidden>{check.explanation[locale]}</p>
      </div>)}
      <p class="tomi-feedback" data-story-feedback role="status" aria-live="polite"></p>
      <div class="tomi-controls"><button type="button" class="tomi-help" data-story-help>☀ {es ? 'Una pista' : 'A little hint'}</button><button type="button" class="tomi-help" data-story-replay>{es ? 'Empezar de nuevo' : 'Start again'}</button><button type="button" class="tomi-continue" data-story-next hidden>{es ? 'Seguir →' : 'Continue →'}</button><a class="tomi-continue" data-story-finish hidden href={next ? buildGradeOneLessonUrl(locale,next.id) : '#story-finale'}>{next ? (es ? 'Siguiente episodio →' : 'Next episode →') : (es ? 'Ver el álbum del día →' : 'See the day’s album →')}</a></div>
    </section>
  </div>
  <div class="tomi-bottom"><span>♡ {es ? 'Sin apuro. Cada intento ayuda.' : 'Take your time. Every try helps.'}</span><span>{lesson.objective[locale]}</span></div>
  <details class="tomi-adult"><summary>{es ? 'Para acompañar: una actividad antes de jugar' : 'For a grown-up: a warm-up before playing'}</summary><p>{lesson.warmup[locale]}</p><p>{lesson.misconception[locale]}</p></details>
  <details class="tomi-adult"><summary>{es ? 'Dibujá, mostrá y explicá con un adulto' : 'Draw, show, and explain with a grown-up'}</summary><p>{lesson.exit[locale]}</p><p>{es ? 'Revisen juntos el dibujo, la respuesta y la explicación. Esta actividad no se califica automáticamente. Los episodios se pueden repetir; no guardan progreso ni otorgan puntos de dominio.' : 'Review the drawing, answer, and explanation together. This activity is not graded automatically. Episodes can be replayed; they do not save progress or award mastery points.'}</p></details>
  {lastInPackage && <details class="tomi-adult molds-review" id="package-check"><summary>{es ? 'Más práctica: cinco preguntas nuevas' : 'More practice: five new questions'}</summary><GradeOneChecks locale={locale} checks={GRADE_ONE_ASSESSMENTS[lesson.packageId]} id={`${lesson.packageId}-story-check`} assessment/><p>{es ? 'Practicá también con otros objetos dentro de una o dos semanas.' : 'Also practice with different objects in one or two weeks.'}</p></details>}
  {!next && <section class="story-finale" id="story-finale" data-story-finale hidden tabindex="-1"><p class="tomi-eyebrow">{es ? 'EL ÁLBUM DE TOMI' : 'TOMI’S ALBUM'}</p><h2>{es ? '¡De vuelta en casa!' : 'Back at home!'}</h2><div class="story-album">{[['⌂','Nos preparamos|Getting ready'],['👋','Los amigos|Our friends'],['⚽','Los juegos|Our games'],['●','La semilla plantada|The planted seed'],['📷','La foto del grupo|Our group photo'],['📖','Nuestros recuerdos|Our memories']].map(([icon,label]) => <div><span aria-hidden="true">{icon}</span><p>{label.split('|')[es?0:1]}</p></div>)}</div><h3>{es ? 'Mostremos nuestro día a la familia' : 'Let’s show our day to the family'}</h3><p>{GRADE_ONE_PROJECT.introduction[locale]}</p><ol>{GRADE_ONE_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es ? 'Cómo acompañar el proyecto' : 'How to support the project'}</summary><ul>{GRADE_ONE_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details><a class="btn btn-outline" href={buildGradeUrl(locale,'grade-1')}>{es ? 'Volver al recorrido de 1.º grado' : 'Back to the Grade 1 learning path'}</a></section>}
  <noscript><p>{es ? 'Activá JavaScript para jugar. El ejemplo guiado y las actividades con un adulto siguen disponibles.' : 'Enable JavaScript to play. The worked example and grown-up activities remain available.'}</p></noscript>
</article>
<script>import '../../scripts/tomiStoryAdventure';</script>
