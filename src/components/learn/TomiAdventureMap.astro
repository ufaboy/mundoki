---
import type { Locale } from '../../math/core/types';
import { GRADE_ONE_LESSONS, GRADE_ONE_PACKAGES, GRADE_ONE_PROJECT } from '../../content/grade1';
import { buildCatalogUrl, buildGradeOneLessonUrl } from '../../i18n/routes';
import TomiCharacter from './TomiCharacter.astro';
const { locale } = Astro.props as { locale: Locale };
const es = locale === 'es-AR';
const labels = [
 ['🚗','El autito|The toy car'], ['🎒','La mochila|The backpack'], ['⭐','Los moldes|The molds'],
 ['🖍️','Las tizas|The chalk'], ['★','Un regalo|A little gift'], ['📦','La caja de figuritas|The sticker box'],
 ['🪣','Listos para jugar|Ready to play'], ['📒','La libreta|The notebook'], ['☎','Llamamos a los amigos|Calling our friends'],
 ['👋','¡Hola, amigos!|Hello, friends!'], ['⚑','Pasamos la bandera|Pass the flag'],
 ['🐦','Un pájaro más|One more bird'], ['🚗','Una pequeña ciudad|A tiny town'], ['👟','Salto a salto|Hop, hop, hop'],
 ['🚧','Abrimos el camino|Clear the road'], ['★','Las figuritas que faltan|Missing stickers'], ['⚽','Buscamos la pelota|Find the ball'],
 ['🧺','Dos canastas|Two baskets'], ['🔟','Llenamos el tablero|Fill the board'], ['📦','Llenamos la caja|Fill the box'],
 ['⚑','La guirnalda|The garland'], ['🐸','La rana saltarina|The hopping frog'], ['♫','¡A bailar!|Let’s dance!'],
 ['🥛','Un poco de agua|A drink of water'], ['🌳','El camino al jardín|The garden path'], ['△','Nuestro cartel|Our sign'],
 ['🎲','Torres y pelotas|Towers and balls'], ['🎀','La cinta del regalo|The gift ribbon'], ['🌉','Un pequeño puente|A little bridge'],
 ['🌱','Plantamos una semilla|Plant a seed'], ['📅','¿Cuándo volvemos?|When do we return?'],
 ['🧩','Guardamos los juguetes|Tidy the toys'], ['📷','Una foto juntos|A photo together'], ['📖','El álbum del día|Our day’s album'], ['🏠','¡De vuelta en casa!|Back at home!'],
];
const places = [
 {id:'home',icon:'🏡',name:'Nos preparamos|Getting ready',range:[0,9],line:'Buscá tus cosas. ¡Nos vamos!|Find your things. Let’s go!'},
 {id:'friends',icon:'👋',name:'Con los amigos|Meet our friends',range:[9,11],line:'Todos juntos, empieza la aventura.|Together, the adventure begins.'},
 {id:'park',icon:'🛝',name:'¡A jugar!|Let’s play!',range:[11,23],line:'Saltos, pelotas y una ciudad de juguete.|Hops, balls, and a tiny toy town.'},
 {id:'garden',icon:'🌳',name:'Exploramos el jardín|Explore the garden',range:[23,31],line:'Seguí el camino y plantá una semilla.|Follow the path and plant a seed.'},
 {id:'return',icon:'🏠',name:'Volvemos a casa|Back home',range:[31,35],line:'Una foto y muchos recuerdos.|A photo and lots of memories.'},
];
const local = (s:string) => s.split('|')[es ? 0 : 1];
---
<div class="trip-map" data-trip-map>
 <nav class="trip-top"><a href={buildCatalogUrl(locale)}>← {es ? 'Todos los grados' : 'All grades'}</a><span>{es ? '1.º grado' : 'Grade 1'}</span><a href="#trip-grownups">{es ? 'Para familias' : 'For grown-ups'}</a></nav>
 <header class="trip-hero">
  <div class="trip-hero-copy"><p class="trip-eyebrow">{es ? 'MATEMÁTICA PARA JUGAR' : 'MATH TO PLAY WITH'}</p><h1>{es ? 'Un día con Tomi' : 'A day with Tomi'}</h1><p>{es ? 'Ayudá a Tomi a salir, jugar y volver a casa.' : 'Help Tomi get ready, play, and find his way home.'}</p><a class="trip-start" href={buildGradeOneLessonUrl(locale,GRADE_ONE_LESSONS[0].id)}><span aria-hidden="true">▶</span> {es ? '¡Vamos! Empezar' : 'Let’s go! Start'} <span aria-hidden="true">→</span></a><a class="trip-choose" href="#trip-stops">{es ? 'O elegí un juego abajo ↓' : 'Or pick a game below ↓'}</a></div>
  <div class="trip-hero-art" aria-hidden="true"><svg viewBox="0 0 440 330"><circle cx="350" cy="62" r="35" fill="#f2cc70"/><path d="M0 240Q140 160 275 235T440 210V330H0" fill="#b9d3a2"/><path d="M25 330Q280 260 395 330" fill="none" stroke="#f8e5b3" stroke-width="55"/><path d="M40 135 115 70l75 65v115H40z" fill="#efd6a6"/><path d="m28 137 87-77 87 77" fill="none" stroke="#be8166" stroke-width="17" stroke-linecap="round"/><rect x="99" y="182" width="35" height="68" rx="14" fill="#8a9b72"/><rect x="58" y="151" width="28" height="31" rx="5" fill="#fdf7dd"/><path d="M366 240V130" stroke="#b09162" stroke-width="14"/><circle cx="368" cy="126" r="49" fill="#8caf7b"/><circle cx="339" cy="145" r="30" fill="#a2c18e"/></svg><TomiCharacter/><span class="trip-hello">{es ? '¡Hola! ¿Jugamos?' : 'Hi! Let’s play!'}</span></div>
 </header>
 <div class="trip-how"><span><b>1</b> {es ? 'Elegí un juego' : 'Pick a game'}</span><span><b>2</b> {es ? 'Resolvé y ayudá' : 'Solve and help'}</span><span><b>3</b> {es ? '¡Seguí a Tomi!' : 'Follow Tomi!'}</span></div>
 <section id="trip-stops" class="trip-stops" aria-labelledby="trip-stops-title"><div class="trip-section-title"><h2 id="trip-stops-title">{es ? 'Tu aventura' : 'Your adventure'}</h2><span>{es ? '35 juegos · todos disponibles' : '35 games · all ready to play'}</span></div>
  {places.map((place,index) => <details class:list={['trip-place',`trip-place-${place.id}`]} open={index===0} id={`trip-${place.id}`}>
   <summary><span class="trip-place-icon" aria-hidden="true">{place.icon}</span><span class="trip-place-heading"><span class="trip-eyebrow">{es ? 'PARADA' : 'STOP'} {index+1} · {es ? 'JUEGOS' : 'GAMES'} {place.range[0]+1}–{place.range[1]}</span><strong>{local(place.name)}</strong></span><span class="trip-expand"><span class="trip-open-label">{es ? 'Abrir' : 'Open'}</span><span class="trip-close-label">{es ? 'Cerrar' : 'Close'}</span><span class="trip-chevron" aria-hidden="true">⌄</span></span></summary>
   <div class="trip-place-body"><p>{local(place.line)}</p><ol class="trip-games" start={place.range[0]+1}>{GRADE_ONE_LESSONS.slice(...place.range as [number,number]).map((lesson,offset) => {
    const n = place.range[0]+offset;
    return <li id={GRADE_ONE_LESSONS[n-1]?.packageId !== lesson.packageId ? lesson.packageId.toLowerCase() : undefined}><a class="trip-game" data-trip-lesson={lesson.id} href={buildGradeOneLessonUrl(locale,lesson.id)}><span class="trip-game-number">{n+1}</span><span class="trip-game-icon" aria-hidden="true">{labels[n][0]}</span><strong>{local(labels[n][1])}</strong><span class="trip-game-play">{es ? 'Jugar' : 'Play'} <span aria-hidden="true">→</span></span></a></li>;
   })}</ol></div>
  </details>)}
 </section>
 <details class="trip-grownups" id="trip-grownups"><summary>{es ? 'Para familias: qué aprendemos' : 'For grown-ups: what we learn'}</summary><div class="trip-grownups-body"><p>{es ? '35 episodios, con dos preguntas por episodio. Contamos, comparamos, sumamos y restamos; exploramos formas, medidas y datos. Pueden elegir cualquier juego y repetirlo.' : '35 episodes with two questions each. Count, compare, add, and subtract; explore shapes, measurement, and data. Choose any game and replay it.'}</p><p>{es ? 'Las respuestas de esta aventura no se guardan. Al final de cada unidad hay cinco preguntas adicionales. Los dibujos y explicaciones se revisan conversando con un adulto.' : 'Adventure answers are not saved. Each unit ends with five additional questions. Review drawings and explanations together with a grown-up.'}</p><ul>{GRADE_ONE_PACKAGES.map(pack=><li><a href={buildGradeOneLessonUrl(locale,GRADE_ONE_LESSONS.find(l=>l.packageId===pack.id)!.id)}>{pack.title[locale]}</a></li>)}</ul><section id="project"><h2>{es ? 'Proyecto en familia' : 'Family project'}</h2><p>{GRADE_ONE_PROJECT.introduction[locale]}</p><ol>{GRADE_ONE_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es ? 'Cómo acompañar' : 'How to help'}</summary><ul>{GRADE_ONE_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>
 // Preserve package and project deep links, including targets inside closed chapters.
 function revealTripAnchor() {
  const id = decodeURIComponent(location.hash.slice(1));
  if (!id) return;
  const target = document.getElementById(id);
  if (!target?.closest('[data-trip-map]')) return;
  let parent: HTMLElement | null = target;
  while (parent) { if (parent instanceof HTMLDetailsElement) parent.open = true; parent = parent.parentElement; }
  requestAnimationFrame(() => target.scrollIntoView({block:'start'}));
 }
 revealTripAnchor();
 window.addEventListener('hashchange',revealTripAnchor);
</script>
