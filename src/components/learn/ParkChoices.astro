---
import type {Locale} from '../../math/core/types';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<details class="city-notebook park-choices"><summary>{es?'Personalizá tu parque':'Make the park yours'}</summary><div><label>{es?'Nombre de la parque':'Park name'} <input data-park-name maxlength="24" autocomplete="off" placeholder={es?'Mi parque':'My park'}/></label><div class="park-colors" role="group" aria-label={es?'Color del parque':'Park color'}>{(['teal','coral','gold'] as const).map((color,i)=><button type="button" data-park-color={color} aria-pressed="false">{(es?['Turquesa','Coral','Dorado']:['Teal','Coral','Gold'])[i]}</button>)}</div><div class="park-colors" role="group" aria-label={es?'Emblema del equipo':'Team emblem'}>{(['star','wave','anchor'] as const).map((emblem,i)=><button type="button" data-park-emblem={emblem} aria-pressed="false">{['★','≈','⚓'][i]} {(es?['Estrella','Ola','Ancla']:['Star','Wave','Anchor'])[i]}</button>)}</div></div></details>
