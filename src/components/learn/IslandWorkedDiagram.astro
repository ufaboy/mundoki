---
import type { Locale } from '../../math/core/types';
const { locale, lessonId } = Astro.props as { locale: Locale; lessonId: string };
const es = locale === 'es-AR';
const sides = [
 {name: es?'Equilátero':'Equilateral', detail:es?'Tres lados iguales':'Three equal sides', points:'20,125 140,125 80,21.08'},
 {name: es?'Isósceles':'Isosceles', detail:es?'Al menos dos lados iguales':'At least two equal sides', points:'35,125 125,125 80,25'},
 {name: es?'Escaleno':'Scalene', detail:es?'Tres lados distintos':'Three different sides', points:'20,125 140,125 45,35'},
];
const angles = [
 {name:es?'Acutángulo':'Acute', detail:es?'Tres ángulos menores que 90°':'Three angles smaller than 90°', points:'20,125 140,125 80,21.08'},
 {name:es?'Rectángulo':'Right', detail:es?'Un ángulo de 90°':'One angle of 90°', points:'25,25 25,125 135,125'},
 {name:es?'Obtusángulo':'Obtuse', detail:es?'Un ángulo mayor que 90°':'One angle larger than 90°', points:'15,125 145,125 55,90'},
];
---
{lessonId==='G04-11-L01' && <div class="island-worked-diagrams">
 {[{title:es?'1. Compará los lados':'1. Compare the sides',items:sides},{title:es?'2. Compará los ángulos':'2. Compare the angles',items:angles}].map(group=><section><h3>{group.title}</h3><div class="island-triangle-cards">{group.items.map(item=><figure><svg viewBox="0 0 160 150" role="img" aria-label={`${item.name}: ${item.detail}`}><polygon points={item.points} fill="#dceee5" stroke="#276c73" stroke-width="3"/>{item.name===(es?'Rectángulo':'Right')&&<path d="M25 111H39V125" fill="none" stroke="#276c73" stroke-width="2"/>}</svg><figcaption><strong>{item.name}</strong><br/>{item.detail}</figcaption></figure>)}</div></section>)}
 <p>{es?'Un mismo triángulo recibe un nombre por sus lados y otro por sus ángulos. Con nuestra definición, un equilátero también es isósceles.':'The same triangle gets one name for its sides and another for its angles. With our definition, an equilateral triangle is also isosceles.'}</p>
 </div>}
{lessonId==='G04-11-L02' && <figure class="island-worked-diagram">
 <svg viewBox="0 0 440 260" role="img" aria-label={es?'Base AB de 6 cm. Dos arcos de radio 4 cm se cruzan en C. AC y BC miden 4 cm.':'Base AB is 6 cm. Two arcs of radius 4 cm cross at C. AC and BC are each 4 cm.'}>
 <path d="M100 200L220 94.17L340 200Z" fill="#dceee5" stroke="#276c73" stroke-width="3"/>
 <path d="M260 200A160 160 0 0 0 100 40M180 200A160 160 0 0 1 340 40" fill="none" stroke="#a55c35" stroke-width="2" stroke-dasharray="6 4"/>
 <g fill="#276c73">{[[100,200],[340,200],[220,94.17]].map(([x,y])=><circle cx={x} cy={y} r="4"/>)}</g>
 <g text-anchor="middle" font-size="18" fill="currentColor"><text x="85" y="220">A</text><text x="355" y="220">B</text><text x="220" y="80">C</text><text x="220" y="230">6 cm</text><text x="145" y="140">4 cm</text><text x="295" y="140">4 cm</text></g>
 </svg><figcaption>{es?'A y B son los extremos de la base. C es un punto donde se cruzan los arcos. Usá una regla para las medidas en papel; el tamaño en pantalla puede cambiar.':'A and B are the endpoints of the base. C is a point where the arcs cross. Use a ruler for measurements on paper; the size on screen can change.'}</figcaption>
 </figure>}
{lessonId==='G04-13-L03' && <figure class="island-worked-diagram" data-island-worked-chart>
 <figcaption>{es?'Lugar elegido por doce chicos del aeroclub':'Place chosen by twelve aeroclub kids'}</figcaption>
 <svg viewBox="0 0 440 300" role="img" aria-label={es?'Votos: Iguazú 6, glaciar 4, ballenas 2. El eje vertical empieza en cero y avanza de dos en dos.':'Votes: Iguazú 6, glacier 4, whales 2. The vertical axis starts at zero and increases by twos.'}>
 <text x="15" y="25" font-size="18" fill="currentColor">{es?'Votos':'Votes'}</text>
 {[0,2,4,6].map(value=><g><path d={`M60 ${240-value*30}H410`} stroke="#b6c8c2"/><text x="48" y={246-value*30} text-anchor="end" font-size="18" fill="currentColor">{value}</text></g>)}
 {[6,4,2].map((value,i)=><g><rect x={90+i*110} y={240-value*30} width="55" height={value*30} fill="#378d8b"/><text x={117.5+i*110} y={230-value*30} text-anchor="middle" font-size="18" fill="currentColor">{value}</text><text x={117.5+i*110} y="265" text-anchor="middle" font-size="17" fill="currentColor">{(es?['Iguazú','Glaciar','Ballenas']:['Iguazú','Glacier','Whales'])[i]}</text></g>)}
 <path d="M60 40V240H410" fill="none" stroke="currentColor" stroke-width="2"/><text x="240" y="293" text-anchor="middle" font-size="18" fill="currentColor">{es?'Lugares':'Places'}</text>
 </svg>
 </figure>}
