---
// Grade 3 scene: the family's house, built from 82 pieces (one per correct
// answer, see houseStory.ts). Piece n is visible while n <= progress and,
// when it has `until`, progress < until (building materials are used up,
// the moving truck leaves). The page script updates progress live.
interface Props {
  /** Pieces already built (0–82). */
  progress?: number;
}
import { housePieceVisible } from '../../scripts/houseState';
const { progress = 0 } = Astro.props;
const piece = (n: number, until?: number) => ({
  class: housePieceVisible(n, progress, until) ? 'house-piece' : 'house-piece is-hidden',
  'data-house-piece': n,
  'data-house-until': until,
});
// Foundation slab: 12 segments under the house.
const slab = Array.from({ length: 12 }, (_, i) => ({ n: 7 + i, x: 290 + i * (340 / 12) }));
// Walls: 12 rows of bricks from the floor up to y = 142.
const rows = Array.from({ length: 12 }, (_, i) => ({ n: 19 + i, y: 252 - i * 10.83, offset: i % 2 ? 14 : 0 }));
// Roof: 6 slices between the eaves (285–635) and the ridge at x = 460.
const roofTop = (x: number) => 142 - 80 * (1 - Math.abs(x - 460) / 175);
const roof = Array.from({ length: 6 }, (_, i) => {
  const x0 = 285 + i * (350 / 6), x1 = x0 + 350 / 6;
  return { n: 31 + i, points: `${x0},142 ${x0},${roofTop(x0)} ${x1},${roofTop(x1)} ${x1},142` };
});
const windows = [{ n: 49, x: 318 }, { n: 50, x: 380 }, { n: 51, x: 508 }, { n: 52, x: 570 }];
---
<div class="city-stage house-stage" data-city-stage data-house-progress={progress}>
  <svg class="city-world house-world" viewBox="0 0 900 360" role="img" aria-hidden="true">
    <rect width="900" height="360" fill="#e4eef0" />
    <circle cx="790" cy="62" r="30" fill="#f1d58c" />
    <path d="M0 230q190-40 380 0t520-10v140H0z" fill="#d6e2bf" />
    <rect y="282" width="900" height="78" fill="#c9d8a8" />
    <path d="M0 330h900" stroke="#d8cdb0" stroke-width="22" />
    <path d="M0 330h900" stroke="#efe6cc" stroke-width="3" stroke-dasharray="18 16" />
    <path d="M285 280h350" stroke="#b9ad8f" stroke-width="3" stroke-dasharray="6 6" opacity=".7" />

    <!-- Chapter 1: bricks and tiles on the lot (used up once the walls are done). -->
    {[[30, 252], [88, 252], [146, 252], [30, 222], [88, 222], [204, 252]].map(([x, y], i) => (
      <g {...piece(1 + i, 31)}>
        <rect x={x} y={y} width="52" height="30" rx="2" fill={i === 5 ? '#b9b2a3' : '#c4714f'} />
        <path d={`M${x} ${y + 10}h52M${x} ${y + 20}h52M${x + 17} ${y}v10M${x + 35} ${y + 10}v10M${x + 17} ${y + 20}v10`} stroke="#f2e2cf" stroke-width="2" />
      </g>
    ))}

    <!-- Chapter 2: foundation slab. -->
    {slab.map(({ n, x }) => <rect {...piece(n)} x={x} y="262" width={340 / 12 + 0.5} height="18" fill="#a7a69d" />)}
    <g {...piece(18)}><circle cx="604" cy="271" r="2.5" fill="#86857c" /><circle cx="611" cy="268" r="2.5" fill="#86857c" /><circle cx="618" cy="271" r="2.5" fill="#86857c" /></g>

    <!-- Chapter 3: brick walls, row by row. -->
    {rows.map(({ n, y, offset }) => (
      <g {...piece(n)}>
        <rect x="300" y={y} width="320" height="11" fill="var(--city-paint,#ce9879)" />
        <path d={`M300 ${y}h320` + Array.from({ length: 11 }, (_, k) => `M${300 + offset + k * 29} ${y}v11`).join('')} stroke="#ffffff" stroke-opacity=".45" stroke-width="1.5" />
      </g>
    ))}

    <!-- Chapter 4: roof sheets. -->
    {roof.map(({ n, points }) => <polygon {...piece(n)} points={points} fill="#8f5d46" stroke="#a96f52" stroke-width="2" />)}

    <!-- Chapter 5: water, light, and finishes. -->
    <g {...piece(37)}><rect x="530" y="70" width="40" height="34" rx="6" fill="#7ea2b4" /><path d="M536 104v16M564 104v16" stroke="#6b7c80" stroke-width="4" /></g>
    <path {...piece(38)} d="M626 150v130" stroke="#8aa0a4" stroke-width="6" fill="none" />
    <g {...piece(39)}><path d="M710 282V128M690 140h40" stroke="#8a7458" stroke-width="7" /></g>
    <path {...piece(40)} d="M690 141q-30 20-68 26" stroke="#4f5a55" stroke-width="2.5" fill="none" />
    <g {...piece(41)}><rect x="420" y="190" width="8" height="12" rx="2" fill="#f5d77a" /><path d="M424 186v4" stroke="#6b6b5e" stroke-width="2" /></g>
    <path {...piece(42)} d="M285 143h350" stroke="#6f7a7c" stroke-width="5" />
    <rect {...piece(43)} x="380" y="74" width="22" height="40" fill="#a35f45" />
    <g {...piece(44)}><path d="M296 236h-10v14" stroke="#7b8f93" stroke-width="5" fill="none" /><circle cx="286" cy="254" r="4" fill="#7ea2b4" /></g>
    {[0, 1, 2, 3].map((k) => <rect {...piece(45 + k)} x={444 - k * 4} y={284 + k * 11} width={36 + k * 8} height="8" rx="3" fill="#d7c9a8" />)}

    <!-- Chapter 6: windows, door, mailbox, packed boxes. -->
    {windows.map(({ n, x }) => (
      <g {...piece(n)}>
        <rect x={x} y="172" width="38" height="40" rx="3" fill="#cfe6ee" stroke="#f6f1e2" stroke-width="5" />
        <path d={`M${x + 19} 172v40M${x} 192h38`} stroke="#f6f1e2" stroke-width="3" />
      </g>
    ))}
    <polygon {...piece(53)} points="446,124 474,124 460,100" fill="#cfe6ee" stroke="#f6f1e2" stroke-width="4" />
    <g {...piece(54)}><rect x="438" y="206" width="44" height="56" rx="4" fill="#6c8b78" /><circle cx="474" cy="236" r="3" fill="#f1d58c" /></g>
    <rect {...piece(55)} x="430" y="258" width="60" height="6" rx="2" fill="#bfb7a2" />
    <g {...piece(56)}><path d="M262 282v-38" stroke="#7d6a52" stroke-width="5" /><rect x="248" y="226" width="28" height="20" rx="6" fill="#5f7d8e" /></g>
    <rect {...piece(57)} x="252" y="232" width="20" height="8" rx="1.5" fill="#f1d58c" />
    {[[650, 256], [682, 256], [666, 230]].map(([x, y], i) => (
      <g {...piece(58 + i, 72)}><rect x={x} y={y} width="30" height="26" fill="#c9a26e" /><path d={`M${x + 15} ${y}v26`} stroke="#ead6ae" stroke-width="4" /></g>
    ))}

    <!-- Chapter 7: moving day. -->
    <g {...piece(61, 73)}>
      <rect x="730" y="196" width="112" height="70" rx="6" fill="#e9e1cc" stroke="#c7bc9e" stroke-width="3" />
      <path d="M842 216h30l18 24v26h-48z" fill="#7f9c8a" /><path d="M848 222h20l12 16h-32z" fill="#dcecef" />
      <circle cx="760" cy="270" r="13" fill="#4f5a55" /><circle cx="862" cy="270" r="13" fill="#4f5a55" />
    </g>
    {windows.map(({ x }, i) => <path {...piece(62 + i)} d={`M${x + 3} 175q8 18 0 34M${x + 35} 175q-8 18 0 34`} stroke="#d77f74" stroke-width="5" fill="none" />)}
    <rect {...piece(66)} x="440" y="264" width="40" height="5" rx="2" fill="#b0705a" />
    <g {...piece(67)}><path d="M410 262l4-14h14l4 14z" fill="#b5674c" /><circle cx="421" cy="242" r="8" fill="#7fae6b" /></g>
    <g {...piece(68)}><path d="M488 262l4-14h14l4 14z" fill="#b5674c" /><circle cx="499" cy="242" r="8" fill="#e3a3b6" /></g>
    <g {...piece(69)}><rect x="120" y="252" width="44" height="30" fill="#c79a6c" /><path d="M114 254l28-22 28 22z" fill="#8f5d46" /><path d="M134 282v-16a8 8 0 0 1 16 0v16z" fill="#5d4a3a" /></g>
    <g {...piece(70)}><ellipse cx="196" cy="274" rx="16" ry="9" fill="#d29a5c" /><circle cx="212" cy="264" r="7" fill="#d29a5c" /><path d="M215 258l4-5" stroke="#a8743f" stroke-width="3" /><path d="M181 270q-8-6-6-12" stroke="#d29a5c" stroke-width="3" fill="none" /></g>
    <g {...piece(71)}>{windows.map(({ x }) => <rect x={x + 6} y="178" width="26" height="28" fill="#f7e19a" opacity=".55" />)}</g>
    <path {...piece(72)} d="M391 70q-10-12 2-22t2-24" stroke="#d4d6d2" stroke-width="7" fill="none" stroke-linecap="round" />

    <!-- Chapter 8: the housewarming party. -->
    {[0, 1, 2].map((k) => (
      <g {...piece(73 + k)}>
        <path d={`M${300 + k * 107} 150q53 22 107 0`} stroke="#8a9a7c" stroke-width="2" fill="none" />
        {[0, 1, 2, 3].map((f) => <path d={`M${312 + k * 107 + f * 24} ${156 + (f === 0 || f === 3 ? 0 : 5)}l10 0-5 12z`} fill={['#d77f74', '#f1d58c', '#7ea2b4', '#9fbf86'][(f + k) % 4]} />)}
      </g>
    ))}
    <g {...piece(76)}><path d="M780 282v-56" stroke="#8a6a48" stroke-width="9" /><circle cx="780" cy="212" r="34" fill="#7fae6b" />{[[766, 200], [792, 206], [776, 226], [796, 222]].map(([x, y]) => <circle cx={x} cy={y} r="5" fill="#f2d25b" />)}</g>
    <g {...piece(77)}><rect x="650" y="252" width="80" height="8" rx="2" fill="#b98a5c" /><path d="M658 260v22M722 260v22" stroke="#9c7249" stroke-width="5" />{[664, 680, 696, 712].map((x) => <path d={`M${x} 252q6-10 12 0z`} fill="#e3b46b" />)}</g>
    <g {...piece(78)}>{[[560, 92, '#d77f74'], [584, 82, '#7ea2b4'], [606, 96, '#f1d58c']].map(([x, y, c]) => <><path d={`M${x} ${Number(y) + 16}q4 30-6 60`} stroke="#9a9a8a" stroke-width="1.5" fill="none" /><ellipse cx={x} cy={y} rx="11" ry="14" fill={String(c)} /></>)}</g>
    {[[560, '#7ea2b4', '#d9a77f'], [596, '#d77f74', '#a87150'], [632, '#9fbf86', '#ecc29b']].map(([x, shirt, skin], i) => (
      <g {...piece(79 + i)}><circle cx={x} cy="246" r="9" fill={String(skin)} /><path d={`M${Number(x) - 11} 282v-24q11-8 22 0v24z`} fill={String(shirt)} /></g>
    ))}
    <g {...piece(82)}>{[[320, 120, '#d77f74'], [360, 96, '#f1d58c'], [540, 120, '#7ea2b4'], [600, 104, '#9fbf86'], [420, 60, '#d77f74'], [500, 58, '#7ea2b4'], [700, 110, '#f1d58c']].map(([x, y, c]) => <rect x={x} y={y} width="7" height="11" rx="1" fill={String(c)} transform={`rotate(25 ${x} ${y})`} />)}</g>
  </svg>
</div>
