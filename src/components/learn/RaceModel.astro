---
// Challenge data shown under some Grade 6 race challenges. The numbers must
// match the check prompts in src/content/grade6/*.ts.
import type {Locale} from '../../math/core/types';
const {locale,lessonId,question}=Astro.props as {locale:Locale;lessonId:string;question:number};const es=locale==='es-AR';
const place=lessonId==='G06-01-L01'&&question===0;
const roman=lessonId==='G06-01-L02';
const signals=lessonId==='G06-03-L03'&&question===0;
const area=lessonId==='G06-09-L01'&&question===1?{w:5,h:3,cut:0}:lessonId==='G06-09-L02'&&question===0?{w:7,h:5,cut:2}:lessonId==='G06-09-L03'&&question===0?{w:5,h:5,cut:0}:null;
const percent=lessonId==='G06-08-L01'?(question===0?40:75):null;
const mean=lessonId==='G06-12-L01'&&question===0?[1,3,8]:lessonId==='G06-12-L02'&&question===0?[0,4,4,8]:lessonId==='G06-12-L03'&&question===0?[2,2,2,10]:null;
const inverse=lessonId==='G06-07-L01';
const scale=lessonId==='G06-10-L01'&&question===0?{factor:'50',length:'1'}:lessonId==='G06-10-L02'&&question===0?{factor:es?'10.000':'10,000',length:'3'}:null;
---
{(place||roman||signals||area||percent!==null||mean||inverse||scale)&&<figure class="race-model" data-race-model data-solved="false"><figcaption>{es?'Datos del desafío':'Challenge data'}</figcaption>
{place&&<div class="race-place">{[3,0,6,0,4].map((n,i)=><span><small>{(es?['Fichas de 10.000','Fichas de 1.000','Fichas de 100','Fichas de 10','Fichas de 1']:['10,000-chips','1,000-chips','100-chips','10-chips','1-chips'])[i]}</small><b>{n}</b></span>)}</div>}
{roman&&<p class="race-numerals">{question===0?'X + X + V':'IV = V − I · VI = V + I'}</p>}
{signals&&<><p>{es?'Batería: lista cada 6 vueltas. Sensor de rebufo: listo cada 8 vueltas.':'Battery: ready every 6 laps. Slipstream sensor: ready every 8 laps.'}</p><div class="race-signal-list">{[6,8].map(n=><div><strong>{n}</strong>{Array.from({length:4},(_,i)=><span class:list={{'race-common':n*(i+1)===24}}>{n*(i+1)}</span>)}</div>)}</div></>}
{area&&<><svg viewBox={`0 0 ${area.w*35+70} ${area.h*35+65}`} role="img" aria-label={es?`Rectángulo ${area.w} por ${area.h} metros${area.cut?', con esquina de 2 por 2 para quitar':''}`:`Rectangle ${area.w} by ${area.h} meters${area.cut?', with a 2 by 2 corner to remove':''}`}><text x="45" y="23">{area.w} m</text><text x="4" y="55">{area.h} m</text>{Array.from({length:area.w*area.h},(_,i)=><rect x={40+(i%area.w)*35} y={35+Math.floor(i/area.w)*35} width="35" height="35" fill={area.cut&&i%area.w>=area.w-area.cut&&Math.floor(i/area.w)<area.cut?'#e5b38b':'#c9d6dc'} stroke="#4a5866"/>)}</svg><p>{es?'Cada casilla representa 1 m².':'Each cell represents 1 m².'} {area.cut>0&&(es?'La esquina naranja es la del armario.':'The orange corner is the cabinet’s.')}</p></>}
{percent!==null&&<><div class="race-hundred" aria-label={`${percent}/100`}>{Array.from({length:100},(_,i)=><span class:list={{shaded:i<percent}}/>)}</div><p>{es?'La cuadrícula completa representa un entero.':'The complete grid represents one whole.'}</p></>}
{mean&&<><div class="race-records">{mean.map(n=><span>{n}</span>)}</div><div class="race-piles" aria-hidden="true">{mean.map(n=><div><span class="race-before" style={`height:${n*12}px`}/><span class="race-after" style={`height:${mean.reduce((a,b)=>a+b,0)/mean.length*12}px`}/></div>)}</div><p>{es?'Al resolver, las barras se equilibran sin cambiar el total. Los datos originales siguen arriba.':'Solving balances the bars without changing the total. The original data remain above.'}</p></>}
{inverse&&<><p>{es?'Trabajo total: 24 horas de un mecánico. Mismo ritmo, trabajo repartible y sin esperas.':'Total work: 24 hours of one mechanic. Equal rates, divisible work, no waiting.'}</p><div class="race-records"><span>2 × 12 = 24</span><span>3 × ? = 24</span><span>4 × 6 = 24</span></div></>}
{scale&&<div class="race-records"><span>{es?'Escala':'Scale'} 1:{scale.factor}</span><span>{scale.length} cm × {scale.factor} = ? cm</span></div>}
</figure>}
