---
import type {Locale} from '../../math/core/types';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<details class="city-notebook island-choices"><summary>{es?'Personalizá tu avión':'Make the plane yours'}</summary><div><label>{es?'Nombre de la tripulación':'Crew name'} <input data-island-name maxlength="24" autocomplete="off" placeholder={es?'Bitácora de vuelo':'Flight logbook'}/></label><div class="island-colors" role="group" aria-label={es?'Color de La Golondrina':'Color of La Golondrina'}>{(['teal','coral','gold'] as const).map((color,i)=><button type="button" data-island-color={color} aria-pressed="false">{(es?['Turquesa','Coral','Dorado']:['Teal','Coral','Gold'])[i]}</button>)}</div></div></details>
