---
import type {Locale} from '../../math/core/types';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<details class="city-notebook moon-choices"><summary>{es?'Personalizá tu expedición':'Make the expedition yours'}</summary><div><label>{es?'Nombre de la expedición':'Expedition name'} <input data-moon-name maxlength="24" autocomplete="off" placeholder={es?'Mi expedición':'My expedition'}/></label><div class="moon-colors" role="group" aria-label={es?'Color del cohete':'Rocket color'}>{(['teal','coral','gold'] as const).map((color,i)=><button type="button" data-moon-color={color} aria-pressed="false">{(es?['Turquesa','Coral','Dorado']:['Teal','Coral','Gold'])[i]}</button>)}</div><div class="moon-colors" role="group" aria-label={es?'Emblema del equipo':'Team emblem'}>{(['star','moon','planet'] as const).map((emblem,i)=><button type="button" data-moon-emblem={emblem} aria-pressed="false">{['★','☾','♄'][i]} {(es?['Estrella','Luna','Planeta']:['Star','Moon','Planet'])[i]}</button>)}</div></div></details>
