---
import type { Locale } from '../../math/core/types';
import { buildGradeOneLessonUrl } from '../../i18n/routes';
import TomiCharacter from './TomiCharacter.astro';
const { locale } = Astro.props as { locale: Locale };
const es = locale === 'es-AR';
const toys = es ? ['Balde', 'Palita', 'Molde de estrella'] : ['Bucket', 'Shovel', 'Star mold'];
---
<article class="tomi-adventure tomi-backpack" data-backpack-adventure data-locale={locale}>
  <nav class="tomi-topline" aria-label={es ? 'La aventura' : 'The adventure'}><a href={buildGradeOneLessonUrl(locale, 'G01-01-L01')}>← {es ? 'El autito de Tomi' : 'Tomi’s toy car'}</a><span>{es ? 'LA GRAN PASEADA DE TOMI' : 'TOMI’S BIG DAY OUT'}</span><span class="tomi-chapter">02 / 35</span></nav>
  <header class="tomi-heading"><div><p>{es ? 'CAPÍTULO 1 · EN CASA' : 'CHAPTER 1 · AT HOME'}</p><h1>{es ? 'Una mochila para jugar' : 'A backpack for play'}</h1></div><span class="tomi-skill">✦ {es ? 'Descubrimos el cero' : 'Discovering zero'}</span></header>
  <div class="tomi-game">
    <div class="tomi-room backpack-room" role="group" aria-label={es ? 'Tomi prepara un bolsillo vacío y tres juguetes para la arena.' : 'Tomi prepares an empty pocket and three sand toys.'}>
      <svg class="tomi-room-art" viewBox="0 0 1100 430" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <defs><pattern id="backpack-wall" width="36" height="36" patternUnits="userSpaceOnUse"><circle cx="18" cy="18" r="1.3" fill="#d4dbc8"/></pattern></defs>
        <path fill="#edf1dd" d="M0 0h1100v430H0z"/><path fill="url(#backpack-wall)" d="M0 0h1100v320H0z"/><path fill="#e8c99e" d="M0 320h1100v110H0z"/><path stroke="#fcf7e9" stroke-width="12" d="M0 320h1100"/>
        <rect x="45" y="50" width="150" height="185" rx="65" fill="#fff9e8"/><rect x="57" y="62" width="126" height="161" rx="55" fill="#b5dfe4"/><circle cx="147" cy="106" r="23" fill="#fff1aa"/><path d="M57 180q30-35 65-10t61 0v53H57" fill="#a1bd86"/><path stroke="#fff9e8" stroke-width="8" d="M120 65v160M58 145h125"/>
        <ellipse cx="560" cy="376" rx="175" ry="24" fill="#b5bd91" opacity=".45"/><path d="M900 65h130m-100 0v35m70-35v35" stroke="#b2936f" stroke-width="8" stroke-linecap="round"/><path d="m919 100 18-14 18 14v30h-36z" fill="#e3b254"/>
      </svg>
      <TomiCharacter />
      <div class="tomi-speech" data-pack-speech>{es ? '¡El autito ya está listo! Ahora preparemos los juguetes para la arena.' : 'The toy car is ready! Now let’s pack our sand toys.'}</div>
      <div class="backpack-bag" data-pack-bag>
        <svg viewBox="0 0 240 280" aria-hidden="true"><path d="M85 47V30q35-32 70 0v17" fill="none" stroke="#57705c" stroke-width="15"/><path d="M32 95q-25 75 0 140m176-140q25 75 0 140" fill="none" stroke="#698574" stroke-width="18"/><rect x="32" y="40" width="176" height="224" rx="49" fill="#88a58b" stroke="#607e68" stroke-width="4"/><path d="M50 100q70-45 140 0" fill="none" stroke="#58755f" stroke-width="5"/><rect x="103" y="64" width="34" height="26" rx="7" fill="#f4d488"/><path d="m116 74 5 5 8-9" fill="none" stroke="#8b7b4f" stroke-width="3"/></svg>
        <div class="backpack-pocket" data-pack-pocket><span class="backpack-zero" data-pack-zero hidden>0</span><span class="backpack-pocket-caption" data-pack-caption>{es ? 'Mirá adentro' : 'Look inside'}</span></div>
        <span class="backpack-label">{es ? 'El bolsillo para la arena' : 'The sand-toy pocket'}</span>
      </div>
      <div class="backpack-toys" data-pack-toys role="group" aria-label={es ? 'Tres juguetes fuera del bolsillo' : 'Three toys outside the pocket'}>
        {toys.map((name, i) => <button class="backpack-toy" type="button" data-pack-toy={i} aria-label={name} aria-pressed="false" disabled><span class="backpack-number" aria-hidden="true"></span><svg viewBox="0 0 100 100" aria-hidden="true">
          {i === 0 && <g><path d="M24 45q0-57 52 0" fill="none" stroke="#b67450" stroke-width="6"/><path d="m17 40 12 49h42l12-49z" fill="#dc926b"/><ellipse cx="50" cy="40" rx="33" ry="9" fill="#f5bc91"/><ellipse cx="50" cy="40" rx="25" ry="5" fill="#ab6c4c"/><path d="M29 56h42" stroke="#f1b78a" stroke-width="4"/></g>}
          {i === 1 && <g transform="rotate(20 50 50)"><rect x="41" y="26" width="18" height="47" rx="5" fill="#dcb76c"/><path d="M35 66h30v16q-15 25-30 0z" fill="#7eaaac"/><rect x="35" y="6" width="30" height="27" rx="10" fill="none" stroke="#6a9295" stroke-width="8"/></g>}
          {i === 2 && <g><path d="m50 12 12 25 28 4-20 20 5 28-25-13-25 13 5-28-20-20 28-4z" fill="#e2b552" stroke="#c4963d" stroke-width="3"/><path d="m50 28 8 17 19 3-14 13 3 18-16-9-16 9 3-18-14-13 19-3z" fill="#f3cd73"/></g>}
        </svg><span>{name}</span></button>)}
      </div>
      <div class="tomi-room-label">⌂ {es ? 'Nos preparamos para salir' : 'Getting ready to go'}</div>
    </div>
    <section class="tomi-task" aria-labelledby="backpack-question">
      <div class="tomi-task-heading"><span class="tomi-step" data-pack-step>1</span><div><p class="tomi-eyebrow" data-pack-eyebrow>{es ? 'MIRÁ EL BOLSILLO' : 'LOOK INSIDE THE POCKET'}</p><h2 id="backpack-question" data-pack-question>{es ? '¿Cuántos juguetes hay dentro del bolsillo?' : 'How many toys are inside the pocket?'}</h2></div></div>
      <p class="tomi-instruction" data-pack-instruction>{es ? 'Los juguetes están afuera. Mirá solamente dentro del bolsillo.' : 'The toys are outside. Look only inside the pocket.'}</p>
      <div class="tomi-answers" data-pack-empty-answers>{[0,1,3].map(n => <button type="button" data-pack-empty={n}>{n}</button>)}</div>
      <div class="tomi-answers" data-pack-total-answers hidden>{[2,3,4].map(n => <button type="button" data-pack-total={n}>{n}</button>)}</div>
      <p class="tomi-feedback" data-pack-feedback role="status" aria-live="polite"></p>
      <div class="tomi-controls"><button type="button" class="tomi-help" data-pack-help>☀ {es ? 'Una pista' : 'A little hint'}</button><button type="button" class="tomi-help" data-pack-reset>{es ? 'Empezar de nuevo' : 'Start again'}</button><button type="button" class="tomi-continue" data-pack-next hidden>{es ? 'Preparar los juguetes →' : 'Prepare the toys →'}</button><a class="tomi-continue" href={buildGradeOneLessonUrl(locale, 'G01-01-L03')} data-pack-finish hidden>{es ? 'Hacer lugar en la mesa →' : 'Make room on the table →'}</a></div>
    </section>
  </div>
  <div class="tomi-bottom"><span>♡ {es ? 'Sin apuro. Cada intento ayuda.' : 'Take your time. Every try helps.'}</span><span>{es ? 'Nuestra misión: guardar tres juguetes.' : 'Our mission: pack three toys.'}</span></div>
  <details class="tomi-adult"><summary>{es ? 'Para acompañar en casa' : 'For a grown-up'}</summary><p>{es ? 'Cero describe una colección vacía. El último número del conteo indica el total. Mostrá un recipiente vacío y otro con dos objetos y pedí que diga sus cantidades. Esta escena no guarda progreso ni otorga puntos de dominio.' : 'Zero describes an empty collection. The last counting number gives the total. Show an empty container and another with two objects and ask your child to name their quantities. This scene does not save progress or award mastery points.'}</p></details>
  <noscript><p>{es ? 'Activá JavaScript para jugar. Con un adulto, compará el bolsillo vacío con los tres juguetes de afuera.' : 'Enable JavaScript to play. With a grown-up, compare the empty pocket with the three toys outside.'}</p></noscript>
</article>
<script>import '../../scripts/tomiBackpackAdventure';</script>
