---
import type {Locale} from '../../math/core/types';
import {PLANE_CHAPTERS,PLANE_MISSIONS} from '../../content/grade4/planeAdventure';
import {GRADE_FOUR_LESSONS,GRADE_FOUR_PROJECT} from '../../content/grade4';
import {buildCatalogUrl,buildSchoolLessonUrl} from '../../i18n/routes';
import PlaneScene from './PlaneScene.astro';
import IslandChoices from './IslandChoices.astro';
// Grade 4 map: the plane story (docs/grade-4-plane-scenario.md). Component and
// script names keep the older "island" prefix; the content is the plane story.
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<div class="city-adventure city-map island-adventure" data-island-root data-island-map data-locale={locale}>
<nav class="city-top"><a href={buildCatalogUrl(locale)}>← {es?'Todos los grados':'All grades'}</a><span>{es?'4.º GRADO':'GRADE 4'}</span><a href="#island-families">{es?'Para familias':'For families'}</a></nav>
<header class="city-map-hero"><div><p class="city-kicker">{es?'UN AVIÓN PARA RECORRER LA ARGENTINA':'A PLANE TO TOUR ARGENTINA'}</p><h1>La Golondrina</h1><p>{es?'Arreglá un avión viejo con Nina y volá del Obelisco a Iguazú, Humahuaca, el Aconcagua, el Perito Moreno, Ushuaia y Valdés.':'Rebuild an old plane with Nina and fly from the Obelisco to Iguazú, Humahuaca, the Aconcagua, Perito Moreno, Ushuaia, and Valdés.'}</p><a class="city-primary" href={buildSchoolLessonUrl(locale,'grade-4',PLANE_MISSIONS[0].id)}>{es?'¡Al hangar!':'To the hangar!'} →</a><a class="city-pick" href="#island-missions">{es?'Elegir una misión ↓':'Choose a mission ↓'}</a></div><div class="city-map-preview"><span>{es?'Tu próxima aventura':'Your next adventure'}</span><PlaneScene scene={{kind:'hangar',stage:4}} locale={locale} preview/></div></header>
<IslandChoices locale={locale}/>
<section id="island-missions"><div class="city-map-section"><h2 data-island-name-display>{es?'Bitácora de vuelo':'Flight logbook'}</h2><span>{PLANE_MISSIONS.length} {es?'misiones · todas disponibles':'missions · all available'}</span></div>
{PLANE_CHAPTERS.map((chapter,i)=><details class="city-district" id={chapter.id} open={i===0}><summary><span class="city-district-icon" aria-hidden="true">{chapter.icon}</span><span><span class="city-kicker">{es?'ETAPA':'CHAPTER'} {i+1}</span><strong>{chapter.title[locale]}</strong></span><span class="city-district-arrow" aria-hidden="true">⌄</span></summary><ol class="city-mission-list" start={PLANE_MISSIONS.indexOf(chapter.missions[0])+1}>{chapter.missions.map(mission=><li><a data-island-mission-link={mission.id} href={buildSchoolLessonUrl(locale,'grade-4',mission.id)}><span class="city-mission-number">{PLANE_MISSIONS.indexOf(mission)+1}</span><strong>{mission.title[locale]}</strong><span class="city-mission-play">{es?'Jugar':'Play'} →</span></a></li>)}</ol></details>)}
</section>
<aside class="city-map-finale"><span aria-hidden="true">✈️ 🗺️ 🎉</span><div><h2>{es?'¡Volvé para el festival!':'Be back for the festival!'}</h2><p>{es?'La última misión abre el festival del aeroclub.':'The last mission opens the aeroclub festival.'}</p></div></aside>
<details class="city-notebook" id="island-families"><summary>{es?'Para familias: qué aprendemos':'For families: what we learn'}</summary><div><p>{es?'Números grandes, operaciones, fracciones, decimales, medidas, geometría y datos. Cada desafío es una decisión de la historia: arreglar el avión, planear el viaje o preparar el festival.':'Large numbers, operations, fractions, decimals, measurement, geometry, and data. Every challenge is a decision in the story: fixing the plane, planning the trip, or preparing the festival.'}</p><p>{es?'Todas las misiones están disponibles. Las escenas representan etapas de la historia, no un historial guardado. Las respuestas no se guardan ni otorgan puntos de dominio. Solo el nombre y el color se recuerdan en este navegador.':'All missions are available. Scenes show story stages, not saved completion history. Answers are not saved and do not award mastery points. Only the name and color are remembered in this browser.'}</p><ul>{PLANE_CHAPTERS.flatMap(chapter=>chapter.packages).map(packageId=>{const first=PLANE_MISSIONS.find(m=>m.packageId===packageId)!;return <li><a href={buildSchoolLessonUrl(locale,'grade-4',first.id)}>{GRADE_FOUR_LESSONS.find(l=>l.packageId===packageId)!.objective[locale]}</a></li>;})}</ul><section id="project"><h2>{GRADE_FOUR_PROJECT.title[locale]}</h2><p>{GRADE_FOUR_PROJECT.introduction[locale]}</p><ol>{GRADE_FOUR_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es?'Cómo acompañar':'How to help'}</summary><ul>{GRADE_FOUR_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>import '../../scripts/islandAdventure';</script>
