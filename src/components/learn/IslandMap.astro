---
import type {Locale} from '../../math/core/types';
import {ISLAND_CHAPTERS,ISLAND_MISSIONS} from '../../content/grade4/islandAdventure';
import {GRADE_FOUR_LESSONS,GRADE_FOUR_PROJECT} from '../../content/grade4';
import {buildCatalogUrl,buildSchoolLessonUrl} from '../../i18n/routes';
import IslandScene from './IslandScene.astro';
import IslandChoices from './IslandChoices.astro';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<div class="city-adventure city-map island-adventure" data-island-root data-island-map data-locale={locale}>
<nav class="city-top"><a href={buildCatalogUrl(locale)}>← {es?'Todos los grados':'All grades'}</a><span>{es?'4.º GRADO':'GRADE 4'}</span><a href="#island-families">{es?'Para familias':'For families'}</a></nav>
<header class="city-map-hero"><div><p class="city-kicker">{es?'UNA EXPEDICIÓN LLENA DE IDEAS':'AN EXPEDITION FULL OF IDEAS'}</p><h1>{es?'La isla de los inventores':'Island of Inventors'}</h1><p>{es?'Construí tu base. Inventá, explorá y prepará una gran muestra.':'Build your base. Invent, explore, and prepare a grand exhibition.'}</p><a class="city-primary" href={buildSchoolLessonUrl(locale,'grade-4',ISLAND_MISSIONS[0].id)}>{es?'¡Preparar el barco!':'Prepare the ship!'} →</a><a class="city-pick" href="#island-missions">{es?'Elegir una misión ↓':'Choose a mission ↓'}</a></div><div class="city-map-preview"><span>{es?'Tu próxima aventura':'Your next adventure'}</span><IslandScene kind="ship" preview/></div></header>
<IslandChoices locale={locale}/>
<section id="island-missions"><div class="city-map-section"><h2 data-island-name-display>{es?'Mi expedición':'My expedition'}</h2><span>{ISLAND_MISSIONS.length} {es?'misiones · todas disponibles':'missions · all available'}</span></div>
{ISLAND_CHAPTERS.map((chapter,i)=><details class="city-district" id={chapter.id.toLowerCase()} open={i===0}><summary><span class="city-district-icon" aria-hidden="true">{chapter.icon}</span><span><span class="city-kicker">{es?'ETAPA':'CHAPTER'} {i+1}</span><strong>{chapter.title[locale]}</strong></span><span class="city-district-arrow" aria-hidden="true">⌄</span></summary><ol class="city-mission-list" start={ISLAND_MISSIONS.indexOf(chapter.missions[0])+1}>{chapter.missions.map(mission=><li><a data-island-mission-link={mission.id} href={buildSchoolLessonUrl(locale,'grade-4',mission.id)}><span class="city-mission-number">{ISLAND_MISSIONS.indexOf(mission)+1}</span><strong>{mission.title[locale]}</strong><span class="city-mission-play">{es?'Jugar':'Play'} →</span></a></li>)}</ol></details>)}
</section>
<aside class="city-map-finale"><span aria-hidden="true">🏝 🔭 🎉</span><div><h2>{es?'¡Invitá a la ciudad!':'Invite the city!'}</h2><p>{es?'La última misión abre nuestra muestra de inventos.':'The last mission opens our invention exhibition.'}</p></div></aside>
<details class="city-notebook" id="island-families"><summary>{es?'Para familias: qué aprendemos':'For families: what we learn'}</summary><div><p>{es?'Números grandes, operaciones, fracciones, decimales, medidas, geometría y datos. Cada misión conserva los ejemplos, modelos y explicaciones del curso.':'Large numbers, operations, fractions, decimals, measurement, geometry, and data. Every mission keeps the course examples, models, and explanations.'}</p><p>{es?'Todas las misiones están disponibles. Las escenas representan etapas de la historia, no un historial guardado. Las respuestas no se guardan ni otorgan puntos de dominio. Solo el nombre y el color se recuerdan en este navegador.':'All missions are available. Scenes show story stages, not saved completion history. Answers are not saved and do not award mastery points. Only the name and color are remembered in this browser.'}</p><ul>{ISLAND_CHAPTERS.map(chapter=><li><a href={buildSchoolLessonUrl(locale,'grade-4',chapter.missions[0].id)}>{GRADE_FOUR_LESSONS.find(l=>l.packageId===chapter.id)!.objective[locale]}</a></li>)}</ul><section id="project"><h2>{GRADE_FOUR_PROJECT.title[locale]}</h2><p>{GRADE_FOUR_PROJECT.introduction[locale]}</p><ol>{GRADE_FOUR_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es?'Cómo acompañar':'How to help'}</summary><ul>{GRADE_FOUR_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>import '../../scripts/islandAdventure';</script>
