---
import type {IslandScene} from '../../content/grade4/islandAdventure';
const {kind='base',preview=false}=Astro.props as {kind?:IslandScene;preview?:boolean};
---
<div class="island-stage" data-island-stage data-phase={preview?'complete':'start'} data-kind={kind} aria-hidden="true">
<svg viewBox="0 0 900 380" xmlns="http://www.w3.org/2000/svg">
 <rect width="900" height="380" rx="28" fill="#d9f0ed"/>
 <circle cx="760" cy="65" r="35" fill="#f5ce68"/><path d="M0 225 Q150 200 300 230 T600 225 T900 230 V380 H0Z" fill="#6eafb5"/>
 <path d="M170 270 Q200 155 350 180 Q500 110 610 190 Q730 205 780 300 Q450 365 170 300" fill="#dfca98"/>
 <path d="M210 256 Q285 180 360 205 Q480 150 600 212 L715 285 Q450 322 210 280" fill="#9fb98b"/>
 <g fill="#527961"><path d="M230 210l22-65 22 65z"/><path d="M640 215l26-80 26 80z"/><path d="M690 250l20-60 20 60z"/></g>
 <path d="M230 305 Q400 267 640 300" fill="none" stroke="#f9e5b4" stroke-width="17" stroke-linecap="round"/>
 {kind==='ship' && <g class="island-ship"><path d="M65 292 H310 L278 338 H100Z" fill="#355e6a"/><path d="M174 168 V292" stroke="#355e6a" stroke-width="8"/><path d="M182 174 L182 267 L264 267Z" fill="#fff6dc"/><g class="island-built" fill="#e5a36e" stroke="#8c6047" stroke-width="3"><rect x="108" y="258" width="44" height="34" rx="4"/><rect x="158" y="254" width="44" height="38" rx="4"/></g></g>}
 {kind==='base' && <g><path d="M330 290 V195 H550 V290" fill="none" stroke="#82624a" stroke-width="12"/><g class="island-built"><rect x="335" y="200" width="210" height="90" fill="#f3d29a"/><rect x="425" y="230" width="45" height="60" fill="var(--island-paint,#378d8b)"/><rect x="360" y="220" width="40" height="34" fill="#c9ece9"/></g><path class="island-done" d="M310 200 L440 120 L570 200Z" fill="var(--island-paint,#378d8b)"/></g>}
 {kind==='solar' && <g><path d="M340 285v-60m155 60v-60" stroke="#526b71" stroke-width="12"/><g class="island-built"><path d="M310 160 H525 L505 245 H290Z" fill="#396a8b" stroke="#e4f4ee" stroke-width="7"/><path d="M382 160l-20 85m90-85l-20 85m-132-43h215" stroke="#d2e4e8" stroke-width="3"/></g><path d="M510 240 Q595 260 600 190" fill="none" stroke="#526b71" stroke-width="6"/><rect x="575" y="173" width="52" height="85" rx="18" fill="#f2e7c6" stroke="#526b71" stroke-width="5"/><g class="island-done"><circle cx="601" cy="197" r="29" fill="#ffe07c"/><path d="M601 147v-15m37 40 13-10m-86 10-13-10" stroke="#e3aa35" stroke-width="5"/></g></g>}
 {kind==='rover' && <g class="island-rover"><path d="M300 260v-45h60l30-40h70l30 40h50v45z" fill="var(--island-paint,#378d8b)" stroke="#355961" stroke-width="5"/><path d="M395 183h59l23 32h-82z" fill="#e2f6ee"/><g class="island-built" fill="#354e57" stroke="#f3d29a" stroke-width="8"><circle cx="350" cy="265" r="28"/><circle cx="488" cy="265" r="28"/></g><path d="M420 175v-42l40 12-40 12" fill="#f2c761" stroke="#355961" stroke-width="4"/></g>}
 {kind==='lighthouse' && <g><path d="M390 290l20-137h65l20 137z" fill="#fff1cf" stroke="#597678" stroke-width="4"/><path d="M405 200h75l6 40h-87z" fill="var(--island-paint,#378d8b)"/><g class="island-built"><rect x="400" y="120" width="85" height="40" rx="6" fill="#426673"/><path d="M442 120v-40m-27 15 27-15 28 15" fill="none" stroke="#426673" stroke-width="7"/></g><path class="island-done island-beam" d="M480 135L805 58V227Z" fill="#ffe992" opacity=".65"/></g>}
 {kind==='bridge' && <g><path d="M340 235Q450 265 545 240L570 315H325Z" fill="#6eafb5"/><g class="island-built" fill="none" stroke="#98684b" stroke-width="8"><path d="M300 284l65-64 65 64 65-64 65 64M300 284h260"/></g><path class="island-done" d="M295 215H565" stroke="#f7deac" stroke-width="16"/><g class="island-explorer"><circle cx="280" cy="165" r="14" fill="#dba27a"/><path d="M280 181v28m0-16-18 12m18-12 18 12m-18 4-12 15m12-15 12 15" stroke="#365e6a" stroke-width="9" stroke-linecap="round"/></g></g>}
 {kind==='drone' && <g class="island-drone"><g class="island-built"><path d="M395 230l45-25 50 25v48l-50 25-45-25z" fill="var(--island-paint,#378d8b)" stroke="#355961" stroke-width="4"/><path d="M395 230l45 25 50-25m-50 25v48" fill="none" stroke="#e0efdd" stroke-width="3"/></g><g class="island-done" stroke="#355961" stroke-width="7" fill="#d7e9df"><path d="M398 238l-45-30m132 30 45-30"/><ellipse cx="350" cy="206" rx="47" ry="9"/><ellipse cx="535" cy="206" rx="47" ry="9"/></g></g>}
 {kind==='exhibition' && <g><g class="island-built"><path d="M285 185H600v50H285Z" fill="var(--island-paint,#378d8b)"/><path d="M300 235v55m285-55v55" stroke="#81664d" stroke-width="10"/><path d="M315 185l25-40 25 40m40 0v-45h50v45m45 0 25-40 25 40" fill="#edc577" stroke="#426673" stroke-width="4"/></g><g class="island-done"><path d="M260 112Q445 175 635 112" fill="none" stroke="#426673" stroke-width="3"/>{[295,355,415,475,535,595].map((x,i)=><path d={`M${x} ${130+Math.sin(i)*10}l22 7-15 25z`} fill={i%2?'#dd917a':'#edc577'}/>)}{[320,405,490,575].map((x,i)=><g><circle cx={x} cy="280" r="12" fill="#d5a07a"/><path d={`M${x} 296v30m0-20-14 9m14-9 14 9`} stroke={i%2?'#a45f4e':'#365e6a'} stroke-width="10" stroke-linecap="round"/></g>)}</g></g>}
</svg></div>
