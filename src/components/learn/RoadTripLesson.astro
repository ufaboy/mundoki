---
import type { Locale } from '../../math/core/types';
import { GRADE_TWO_LESSONS, GRADE_TWO_PROJECT } from '../../content/grade2';
import { getGradeTwoHints } from '../../content/grade2/hints';
import { GRADE_TWO_ASSESSMENTS } from '../../content/grade2/assessments';
import { ROAD_MISSIONS, ROAD_CHAPTERS, roadSceneState } from '../../content/grade2/roadTrip';
import { buildGradeUrl, buildSchoolLessonUrl } from '../../i18n/routes';
import RoadTripStage from './RoadTripStage.astro';
import GradeOneChecks from './GradeOneChecks.astro';
import GradeTwoLab from './GradeTwoLab.astro';
const { locale, lessonId } = Astro.props as { locale:Locale; lessonId:string };
const es=locale==='es-AR';
const index=GRADE_TWO_LESSONS.findIndex(l=>l.id===lessonId);
const lesson=GRADE_TWO_LESSONS[index], mission=ROAD_MISSIONS[index];
if (!lesson || mission.id!==lessonId) throw new Error(`Missing road mission: ${lessonId}`);
const hints=getGradeTwoHints(lessonId);
const next=GRADE_TWO_LESSONS[index+1];
const chapter=ROAD_CHAPTERS.find(c=>index>=c.start && index<c.end)!;
const initial=roadSceneState(index,0);
const lastInPackage=!next || next.packageId!==lesson.packageId;
---
<article class="road-trip road-lesson" data-road-lesson data-locale={locale} data-mission-index={index}>
 <nav class="road-top"><a href={`${buildGradeUrl(locale,'grade-2')}#road-${chapter.id}`}>← {es?'Mapa del viaje':'Trip map'}</a><span>{es?'MISIÓN':'MISSION'} {index+1} / 36</span></nav>
 <header class="road-heading"><p class="road-eyebrow">{chapter.icon} {chapter.title[locale]}</p><h1>{mission.title[locale]}</h1><p>{mission.introduction[locale]}</p></header>
 <RoadTripStage locale={locale} index={index}/>
 <div class="road-dashboard"><div class="road-colors" role="group" aria-label={es?'Color del auto':'Car color'}><span>{es?'Tu color':'Your color'}</span>{[['gold',es?'Dorado':'Gold'],['blue',es?'Azul':'Blue'],['coral',es?'Coral':'Coral']].map(([value,label],i)=><button type="button" data-road-color={value} aria-label={label} aria-pressed={i===0?'true':'false'} class={`road-color-${value}`}><span aria-hidden="true">✓</span></button>)}</div><p>{initial.driving?(es?'Cada respuesta nos lleva más lejos.':'Each answer takes us farther.'):(es?'Cada respuesta cambia la escena.':'Each answer changes the scene.')}</p></div>
 {index>=32 && <div class="road-vehicle-picker" data-road-garage><p>{es?'Tu garaje: el auto pequeño se queda con vos.':'Your garage: your little car stays with you.'}</p><div role="group" aria-label={es?'Elegir vehículo':'Choose a vehicle'}><button type="button" data-road-vehicle="car" aria-pressed="true">🚙 {es?'Mi auto':'My car'}</button><button type="button" data-road-vehicle="van" aria-pressed="false" disabled={!initial.vanAvailable}>🚐 {es?'La camioneta':'The van'}</button></div><p class="text-sm" data-road-garage-status>{initial.vanAvailable?(es?'Los dos están disponibles.':'Both are available.'):(es?'Completá esta misión para recibir la camioneta.':'Complete this mission to receive the van.')}</p></div>}
 <section class="road-workbook" aria-label={es?'Ejemplo paso a paso':'Step-by-step example'}><h2>{es?'Miremos un ejemplo':'Let’s try an example'}</h2><div class="road-workbook-body"><h2>{lesson.title[locale]}</h2><p>{lesson.story[locale]}</p><figure class="road-example" data-scene><div class="road-example-items" data-scene-items>{lesson.scene.items.map((item,i)=><button type="button" data-scene-item aria-pressed="false" aria-label={`${es?'Tarjeta':'Card'} ${i+1}: ${item}`}>{item}</button>)}</div><figcaption>{lesson.scene.caption[locale]}</figcaption><button type="button" class="road-secondary" data-scene-reset>{es?'Borrar marcas':'Clear marks'}</button></figure><ol>{lesson.steps.map(step=><li>{step[locale]}</li>)}</ol><p>{lesson.misconception[locale]}</p><GradeTwoLab locale={locale} packageId={lesson.packageId}/></div></section>
 <section class="road-challenge">
  <p>{es?'Ahora te toca. Leé la pregunta y probá.':'Now it’s your turn. Read the question and try it.'}</p>
  {lesson.packageId === 'G02-10' && <figure class="road-question-map"><figcaption>{es?'Plano para estos desafíos. ★: salida. ■: lugar bloqueado. La bandera o la escuela es la meta. Un paso por casilla, sin diagonales.':'Map for these challenges. ★: start. ■: blocked square. The flag or school is the goal. Move one square at a time, with no diagonal moves.'}</figcaption><table aria-label={es?'Plano del recorrido':'Route map'}><tbody>{lesson.scene.items.slice(0,3).map(row=><tr>{row.split(' ').map(cell=><td>{cell}</td>)}</tr>)}</tbody></table></figure>}
  {lesson.checks.map((check,i)=><div data-road-question={i} data-answer={check.answer} data-reward={mission.rewards[i][locale]} hidden={i!==0}><p class="road-eyebrow">{es?'DESAFÍO':'CHALLENGE'} {i+1} / {lesson.checks.length}</p><h2 tabindex="-1" data-road-question-title>{check.prompt[locale]}</h2>
   {index===0 && <div class="road-place-model"><p>{es?'Tocá una cifra para ver cuánto vale.':'Tap a digit to see its value.'}</p><div class="road-place-columns">{(i===0?[4,6,1]:[2,2,2]).map((digit,j)=>{
    const unit=[100,10,1][j];
    const label=(es?['Centenas','Decenas','Unidades']:['Hundreds','Tens','Ones'])[j];
    return <button type="button" data-road-place-value={`${digit} × ${unit} = ${digit*unit}`} aria-pressed="false" aria-label={`${label}: ${digit}`}><span>{label}</span><strong>{digit}</strong><span class="road-place-blocks" aria-hidden="true">{Array.from({length:digit},()=> <i>{unit}</i>)}</span></button>;
   })}</div><p class="road-place-value" data-road-place-result role="status" aria-live="polite"></p></div>}
   <div class="road-options" role="group" aria-label={check.prompt[locale]}>{check.options.map((option,j)=><button type="button" data-road-answer={j}>{option[locale]}</button>)}</div><p class="road-hint" data-road-hint hidden>{hints[i][locale]}</p><p class="road-hint" data-road-explanation hidden>{check.explanation[locale]}</p></div>)}
  <p class="road-feedback" data-road-feedback role="status" aria-live="polite"></p>
  <div class="road-controls"><button type="button" class="road-secondary" data-road-help>{es?'Una pista':'A hint'}</button><button type="button" class="road-secondary" data-road-reset>{es?'Volver a jugar':'Play again'}</button><button type="button" class="road-primary" data-road-next hidden>{es?'Siguiente desafío':'Next challenge'} →</button><a class="road-primary" data-road-finish hidden href={next?buildSchoolLessonUrl(locale,'grade-2',next.id):'#road-postcard'}>{next?(es?'Siguiente misión':'Next mission'):(es?'Ver mi postal':'See my postcard')} →</a></div>
 </section>
 {lastInPackage && <details class="road-workbook" id="package-check"><summary>{es?'Una prueba más: cinco preguntas':'One more test: five questions'}</summary><div class="road-workbook-body"><GradeOneChecks locale={locale} checks={GRADE_TWO_ASSESSMENTS[lesson.packageId]} id={`${lesson.packageId}-road-check`} assessment/></div></details>}
 <details class="road-workbook"><summary>{es?'Para explorar con un adulto':'Explore with a grown-up'}</summary><div class="road-workbook-body"><p>{lesson.warmup[locale]}</p><p>{lesson.exit[locale]}</p><p>{es?'Revisen juntos el dibujo y la explicación. La aventura se puede repetir; las respuestas no se guardan ni suman puntos de dominio. Al abrir una misión, el auto muestra la etapa de esa historia.':'Review the drawing and explanation together. Replay any adventure; answers are not saved and do not award mastery points. Each mission opens with the car at that story’s stage.'}</p></div></details>
 {!next && <section class="road-postcard" id="road-postcard" data-road-postcard hidden><p class="road-eyebrow">{es?'RECUERDO DEL VIAJE':'A MEMORY OF OUR TRIP'}</p><span class="road-postcard-icon" aria-hidden="true">🚙 ⛴ 🚐 🏫</span><h2>{es?'¡Llegamos al mar!':'We made it to the sea!'}</h2><p>{es?'Un auto reparado, una travesía en ferry y dos vehículos en nuestro garaje.':'A car repaired, a ferry crossing, and two vehicles in our garage.'}</p><a class="road-primary" href={buildGradeUrl(locale,'grade-2')}>{es?'Elegir otra misión':'Choose another mission'} →</a><details><summary>{es?'Proyecto en familia':'Family project'}</summary><p>{GRADE_TWO_PROJECT.introduction[locale]}</p><ol>{GRADE_TWO_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><ul>{GRADE_TWO_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section>}
 <noscript><p>{es?'Activá JavaScript para construir y viajar. El cuaderno del taller se puede leer sin activarlo.':'Enable JavaScript to build and travel. You can read the workshop notebook without it.'}</p></noscript>
</article>
<script>import '../../scripts/roadTrip';</script>

<style>
 .road-question-map { margin: 0 0 1.5rem; }
 .road-question-map table { border-collapse: collapse; margin: .75rem auto; }
 .road-question-map td { border: 2px solid currentColor; width: 3rem; height: 3rem; text-align: center; font-size: 1.5rem; }
</style>
