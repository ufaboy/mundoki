---
import type { Locale } from '../../math/core/types';
import { GRADE_SEVEN_LESSONS, GRADE_SEVEN_PROJECT } from '../../content/grade7';
import { GRADE_SEVEN_ASSESSMENTS } from '../../content/grade7/assessments';
import { PARK_MISSIONS, PARK_CHAPTERS, nextParkMission } from '../../content/grade7/parkAdventure';
import { buildGradeUrl, buildSchoolLessonUrl } from '../../i18n/routes';
import ParkModel from './ParkModel.astro';
import ParkScene from './ParkScene.astro';
import ParkChoices from './ParkChoices.astro';
import GradeOneChecks from './GradeOneChecks.astro';
import GradeSevenLab from './GradeSevenLab.astro';
import GradeSixLab from './GradeSixLab.astro';
import UpperPrimaryLab from './UpperPrimaryLab.astro';
const {locale,lessonId}=Astro.props as {locale:Locale;lessonId:string};
const es=locale==='es-AR';
const index=GRADE_SEVEN_LESSONS.findIndex(l=>l.id===lessonId);
const lesson=GRADE_SEVEN_LESSONS[index],mission=PARK_MISSIONS[index];
if(!lesson||mission.id!==lesson.id)throw new Error(`Missing park mission: ${lessonId}`);
const chapter=PARK_CHAPTERS.find(c=>c.id===lesson.packageId)!;
const next=nextParkMission(lesson.id);
const sourceNext=GRADE_SEVEN_LESSONS[index+1];
const lastInPackage=!sourceNext||sourceNext.packageId!==lesson.packageId;
---
<article class="city-adventure city-lesson park-adventure" data-park-root data-park-lesson data-park-index={index} data-locale={locale}>
 <nav class="city-top"><a href={`${buildGradeUrl(locale,'grade-7')}#${lesson.packageId.toLowerCase()}`}>← {es?'Mapa de la misión':'Park map'}</a><span>{es?'MISIÓN':'MISSION'} {index+1} / {GRADE_SEVEN_LESSONS.length}</span></nav>
 <header class="city-heading"><p class="city-kicker">{chapter.icon} {chapter.title[locale]}</p><h1>{mission.title[locale]}</h1><p>{mission.introduction[locale]}</p>{chapter.optional&&<p class="park-optional">{es?'Taller opcional · podés volver al mapa y seguir la aventura.':'Optional workshop · return to the map to continue the adventure.'}</p>}</header>
 <div class="city-scene-frame"><div class="city-scene-top"><span data-park-emblem-display aria-hidden="true">★</span><span data-park-name-display>{es?'Mi parque':'My park'}</span><div aria-label={es?'Pasos de esta misión':'Mission steps'}>{lesson.checks.map((_,i)=><span data-park-badge={i}>{i+1}</span>)}</div></div><ParkScene kind={mission.scene}/><p class="park-scene-caption">{es?'Escena de la historia · los datos del desafío están abajo.':'Story scene · challenge data are below.'}</p><p class="city-reward" data-park-reward role="status" aria-live="polite" hidden></p></div>
 <ParkChoices locale={locale}/>
 <section class="city-challenge">
 {lesson.checks.map((check,i)=><div data-park-question={i} hidden={i!==0} data-answer={check.answer} data-reward={mission.rewards[i][locale]}><p class="city-kicker">{es?'DESAFÍO':'CHALLENGE'} {i+1} / {lesson.checks.length}</p><h2 tabindex="-1" data-park-question-title>{check.prompt[locale]}</h2>
 {(/anterior|original|este patrón|estas cajas|la caja|franja de lectura|representa w|corresponde a P|verificás P/.test(check.prompt['es-AR']))&&<p class="park-context">{lesson.story[locale]}</p>}
 <ParkModel locale={locale} lessonId={lesson.id} question={i}/>
 <div class="city-answer-options" role="group" aria-label={check.prompt[locale]}>{check.options.map((option,j)=><button type="button" data-park-answer={j}>{option[locale]}</button>)}</div><p class="city-hint" data-park-hint hidden>{check.explanation[locale]}</p></div>)}
 <p class="city-feedback" data-park-feedback role="status" aria-live="polite"></p><div class="city-controls"><button type="button" class="city-secondary" data-park-help>{es?'Una pista':'A hint'}</button><button type="button" class="city-secondary" data-park-reset>{es?'Volver a jugar':'Play again'}</button><button type="button" class="city-primary" data-park-next hidden>{es?'Siguiente desafío':'Next challenge'} →</button><a class="city-primary" data-park-finish hidden href={next?buildSchoolLessonUrl(locale,'grade-7',next.id):'#park-celebration'}>{next?(es?'Siguiente misión':'Next mission'):(es?'¡Misión cumplida!':'Mission accomplished!')} →</a></div>
 </section>
 <details class="city-notebook"><summary>{es?'¿Cómo se hace? Abrí el cuaderno de ideas':'How does it work? Open the idea notebook'}</summary><div><h2>{lesson.title[locale]}</h2><p>{lesson.story[locale]}</p><h3>{es?'Ejemplo guiado (otros datos)':'Worked example (different data)'}</h3><figure class="city-example" data-scene><div>{lesson.scene.items.map((item,i)=><button type="button" data-scene-item aria-pressed="false" aria-label={`${es?'Tarjeta':'Card'} ${i+1}: ${item}`}>{item}</button>)}</div><figcaption>{lesson.scene.caption[locale]}</figcaption><button type="button" class="city-secondary" data-scene-reset>{es?'Borrar marcas':'Clear marks'}</button></figure><ol>{lesson.steps.map(step=><li>{step[locale]}</li>)}</ol><p>{lesson.misconception[locale]}</p><GradeSevenLab locale={locale} packageId={lesson.packageId}/>{lesson.packageId==='G07-03'&&<GradeSixLab locale={locale} packageId="G06-06"/>}{lesson.packageId==='G07-09'&&<GradeSixLab locale={locale} packageId="G06-12"/>}<UpperPrimaryLab locale={locale} packageId={lesson.packageId}/></div></details>
 {lastInPackage && <details class="city-notebook" id="package-check"><summary>{es?'Un desafío extra: cinco preguntas':'An extra challenge: five questions'}</summary><div><GradeOneChecks locale={locale} checks={GRADE_SEVEN_ASSESSMENTS[lesson.packageId]} id={`${lesson.packageId}-park-check`} assessment/></div></details>}
 <details class="city-notebook"><summary>{es?'Para explorar con un adulto':'Explore with a grown-up'}</summary><div><p>{lesson.warmup[locale]}</p><p>{lesson.exit[locale]}</p><p>{es?'Revisen juntos el dibujo y la explicación. Cada misión muestra una etapa de la historia; las respuestas no se guardan ni otorgan puntos de dominio. El nombre, el color y el emblema del parque se guardan solo en este navegador.':'Review the drawing and explanation together. Each mission shows a stage of the story; answers are not saved and do not award mastery points. The park name, color, and emblem are saved only in this browser.'}</p></div></details>
 {!next && <section class="city-celebration" id="park-celebration" data-park-celebration hidden><p class="city-kicker">{es?'LA FERIA ESTÁ ABIERTA':'THE FAIR IS OPEN'}</p><h2>{es?'¡Bienvenidos al Parque del Futuro!':'Welcome to the Park of the Future!'}</h2><ParkScene kind="opening" preview/><p>{es?'Tomi y sus amigos, los inventores de la isla, los astronautas y los investigadores del océano comparten sus descubrimientos. ¡Tu equipo convirtió el viejo complejo en una feria para todos!':'Tomi and friends, island inventors, astronauts, and ocean researchers share their discoveries. Your team turned the old complex into a fair for everyone!'}</p><a class="city-primary" href={buildGradeUrl(locale,'grade-7')}>{es?'Volver al mapa':'Back to the mission map'} →</a><details class="city-notebook"><summary>{es?'Proyecto en familia: la feria de fin de primaria':'Family project: the primary school fair'}</summary><div><p>{GRADE_SEVEN_PROJECT.introduction[locale]}</p><ol>{GRADE_SEVEN_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><ul>{GRADE_SEVEN_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></div></details></section>}
 <noscript><p>{es?'Activá JavaScript para construir. Podés leer los ejemplos del cuaderno sin activarlo.':'Enable JavaScript to build. You can read the notebook examples without it.'}</p></noscript>
</article>
<script>import '../../scripts/parkAdventure';</script>
