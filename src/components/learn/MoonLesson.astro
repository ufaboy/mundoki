---
import type { Locale } from '../../math/core/types';
import { GRADE_FIVE_LESSONS, GRADE_FIVE_PROJECT } from '../../content/grade5';
import { GRADE_FIVE_ASSESSMENTS } from '../../content/grade5/assessments';
import { MOON_MISSIONS, MOON_CHAPTERS } from '../../content/grade5/moonAdventure';
import { buildGradeUrl, buildSchoolLessonUrl } from '../../i18n/routes';
import MoonModel from './MoonModel.astro';
import MoonScene from './MoonScene.astro';
import MoonChoices from './MoonChoices.astro';
import GradeOneChecks from './GradeOneChecks.astro';
import GradeFiveLab from './GradeFiveLab.astro';
import UpperPrimaryLab from './UpperPrimaryLab.astro';
const {locale,lessonId}=Astro.props as {locale:Locale;lessonId:string};
const es=locale==='es-AR';
const index=GRADE_FIVE_LESSONS.findIndex(l=>l.id===lessonId);
const lesson=GRADE_FIVE_LESSONS[index],mission=MOON_MISSIONS[index];
if(!lesson||mission.id!==lesson.id)throw new Error(`Missing moon mission: ${lessonId}`);
const chapter=MOON_CHAPTERS.find(c=>c.id===lesson.packageId)!;
const next=GRADE_FIVE_LESSONS[index+1];
const lastInPackage=!next||next.packageId!==lesson.packageId;
---
<article class="city-adventure city-lesson moon-adventure" data-moon-root data-moon-lesson data-moon-index={index} data-locale={locale}>
 <nav class="city-top"><a href={`${buildGradeUrl(locale,'grade-5')}#${lesson.packageId.toLowerCase()}`}>← {es?'Mapa de la misión':'Moon map'}</a><span>{es?'MISIÓN':'MISSION'} {index+1} / {GRADE_FIVE_LESSONS.length}</span></nav>
 <header class="city-heading"><p class="city-kicker">{chapter.icon} {chapter.title[locale]}</p><h1>{mission.title[locale]}</h1><p>{mission.introduction[locale]}</p></header>
 <div class="city-scene-frame"><div class="city-scene-top"><span data-moon-emblem-display aria-hidden="true">★</span><span data-moon-name-display>{es?'Mi expedición':'My expedition'}</span><div aria-label={es?'Pasos de esta misión':'Mission steps'}>{lesson.checks.map((_,i)=><span data-moon-badge={i}>{i+1}</span>)}</div></div><MoonScene kind={mission.scene}/><p class="moon-scene-caption">{es?'Escena de la historia · los datos del desafío están abajo.':'Story scene · challenge data are below.'}</p><p class="city-reward" data-moon-reward role="status" aria-live="polite" hidden></p></div>
 <MoonChoices locale={locale}/>
 <section class="city-challenge">
 {lesson.checks.map((check,i)=><div data-moon-question={i} hidden={i!==0} data-answer={check.answer} data-reward={mission.rewards[i][locale]}><p class="city-kicker">{es?'DESAFÍO':'CHALLENGE'} {i+1} / {lesson.checks.length}</p><h2 tabindex="-1" data-moon-question-title>{check.prompt[locale]}</h2>
 <MoonModel locale={locale} lessonId={lesson.id} question={i}/>
 <div class="city-answer-options" role="group" aria-label={check.prompt[locale]}>{check.options.map((option,j)=><button type="button" data-moon-answer={j}>{option[locale]}</button>)}</div><p class="city-hint" data-moon-hint hidden>{check.explanation[locale]}</p></div>)}
 <p class="city-feedback" data-moon-feedback role="status" aria-live="polite"></p><div class="city-controls"><button type="button" class="city-secondary" data-moon-help>{es?'Una pista':'A hint'}</button><button type="button" class="city-secondary" data-moon-reset>{es?'Volver a jugar':'Play again'}</button><button type="button" class="city-primary" data-moon-next hidden>{es?'Siguiente desafío':'Next challenge'} →</button><a class="city-primary" data-moon-finish hidden href={next?buildSchoolLessonUrl(locale,'grade-5',next.id):'#moon-celebration'}>{next?(es?'Siguiente misión':'Next mission'):(es?'¡Misión cumplida!':'Mission accomplished!')} →</a></div>
 </section>
 <details class="city-notebook"><summary>{es?'¿Cómo se hace? Abrí el cuaderno de ideas':'How does it work? Open the idea notebook'}</summary><div><h2>{lesson.title[locale]}</h2><p>{lesson.story[locale]}</p><h3>{es?'Ejemplo guiado (otros datos)':'Worked example (different data)'}</h3><figure class="city-example" data-scene><div>{lesson.scene.items.map((item,i)=><button type="button" data-scene-item aria-pressed="false" aria-label={`${es?'Tarjeta':'Card'} ${i+1}: ${item}`}>{item}</button>)}</div><figcaption>{lesson.scene.caption[locale]}</figcaption><button type="button" class="city-secondary" data-scene-reset>{es?'Borrar marcas':'Clear marks'}</button></figure><ol>{lesson.steps.map(step=><li>{step[locale]}</li>)}</ol><p>{lesson.misconception[locale]}</p><GradeFiveLab locale={locale} packageId={lesson.packageId}/><UpperPrimaryLab locale={locale} packageId={lesson.packageId}/></div></details>
 {lastInPackage && <details class="city-notebook" id="package-check"><summary>{es?'Un desafío extra: cinco preguntas':'An extra challenge: five questions'}</summary><div><GradeOneChecks locale={locale} checks={GRADE_FIVE_ASSESSMENTS[lesson.packageId]} id={`${lesson.packageId}-moon-check`} assessment/></div></details>}
 <details class="city-notebook"><summary>{es?'Para explorar con un adulto':'Explore with a grown-up'}</summary><div><p>{lesson.warmup[locale]}</p><p>{lesson.exit[locale]}</p><p>{es?'Revisen juntos el dibujo y la explicación. Cada misión muestra una etapa de la historia; las respuestas no se guardan ni otorgan puntos de dominio. El nombre, el color y el emblema de la expedición se guardan solo en este navegador.':'Review the drawing and explanation together. Each mission shows a stage of the story; answers are not saved and do not award mastery points. The expedition name, color, and emblem are saved only in this browser.'}</p></div></details>
 {!next && <section class="city-celebration" id="moon-celebration" data-moon-celebration hidden><p class="city-kicker">{es?'DE VUELTA EN LA TIERRA':'BACK ON EARTH'}</p><h2>{es?'¡Bienvenido a casa, equipo!':'Welcome home, team!'}</h2><MoonScene kind="home" preview/><p>{es?'Construimos un cohete, exploramos la Luna y compartimos nuestros descubrimientos. Ahora preparemos la bienvenida del equipo.':'We built a rocket, explored the Moon, and shared our discoveries. Now let’s prepare the team’s welcome.'}</p><a class="city-primary" href={buildGradeUrl(locale,'grade-5')}>{es?'Volver al mapa':'Back to the mission map'} →</a><details class="city-notebook"><summary>{es?'Proyecto en familia: bienvenida al equipo':'Family project: welcome the team'}</summary><div><p>{GRADE_FIVE_PROJECT.introduction[locale]}</p><ol>{GRADE_FIVE_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><ul>{GRADE_FIVE_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></div></details></section>}
 <noscript><p>{es?'Activá JavaScript para construir. Podés leer los ejemplos del cuaderno sin activarlo.':'Enable JavaScript to build. You can read the notebook examples without it.'}</p></noscript>
</article>
<script>import '../../scripts/moonAdventure';</script>
