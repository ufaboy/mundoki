---
import type { Locale } from '../../math/core/types';
import { GRADE_FOUR_LESSONS, GRADE_FOUR_PROJECT } from '../../content/grade4';
import { GRADE_FOUR_ASSESSMENTS } from '../../content/grade4/assessments';
import { PLANE_MISSIONS, PLANE_CHAPTERS } from '../../content/grade4/planeAdventure';
import { buildGradeUrl, buildSchoolLessonUrl } from '../../i18n/routes';
import { getGradeFourHints } from '../../content/grade4/hints';
import IslandWorkedDiagram from './IslandWorkedDiagram.astro';
import IslandModel from './IslandModel.astro';
import PlaneScene from './PlaneScene.astro';
import HeroText from '../shared/HeroText.astro';
import IslandChoices from './IslandChoices.astro';
import GradeOneChecks from './GradeOneChecks.astro';
import UpperPrimaryLab from './UpperPrimaryLab.astro';
const {locale,lessonId}=Astro.props as {locale:Locale;lessonId:string};
const es=locale==='es-AR';
const index=GRADE_FOUR_LESSONS.findIndex(l=>l.id===lessonId);
const lesson=GRADE_FOUR_LESSONS[index],mission=PLANE_MISSIONS[index];
if(!lesson||mission.id!==lesson.id)throw new Error(`Missing plane mission: ${lessonId}`);
const hints=getGradeFourHints(lesson.id);
const chapter=PLANE_CHAPTERS.find(c=>c.id===mission.chapterId)!;
const next=GRADE_FOUR_LESSONS[index+1];
const lastInPackage=!next||next.packageId!==lesson.packageId;
---
<article class="city-adventure city-lesson island-adventure" data-island-root data-island-lesson data-island-index={index} data-locale={locale}>
 <nav class="city-top"><a href={`${buildGradeUrl(locale,'grade-4')}#${chapter.id}`}>← {es?'Mapa del viaje':'Trip map'}</a><span>{es?'MISIÓN':'MISSION'} {index+1} / {GRADE_FOUR_LESSONS.length}</span></nav>
 <header class="city-heading"><p class="city-kicker">{chapter.icon} {chapter.title[locale]}</p><h1>{mission.title[locale]}</h1><p><HeroText text={mission.introduction[locale]}/></p></header>
 <div class="city-scene-frame"><div class="city-scene-top"><span data-island-name-display>{es?'Bitácora de vuelo':'Flight logbook'}</span><div aria-label={es?'Pasos de esta misión':'Mission steps'}>{lesson.checks.map((_,i)=><span data-island-badge={i}>{i+1}</span>)}</div></div><PlaneScene scene={mission.scene} locale={locale}/><p class="island-scene-caption">{es?'Escena de la historia · los datos del desafío están abajo.':'Story scene · challenge data are below.'}</p><p class="city-reward" data-island-reward role="status" aria-live="polite" hidden></p></div>
 <IslandChoices locale={locale}/>
 <section class="city-notebook island-worked-example" aria-label={es?'Ejemplo paso a paso':'Step-by-step example'}><p class="city-example-heading">{es?'Miremos un ejemplo':'Let’s try an example'}</p><div><h2>{lesson.title[locale]}</h2><p>{lesson.story[locale]}</p><h3>{es?'Ejemplo guiado (otros datos)':'Worked example (different data)'}</h3>{lesson.id!=='G04-13-L03' && <figure class="city-example" data-scene><div>{lesson.scene.items.map((item,i)=><button type="button" data-scene-item aria-pressed="false" aria-label={`${es?'Tarjeta':'Card'} ${i+1}: ${item}`}>{item}</button>)}</div><figcaption>{lesson.scene.caption[locale]}</figcaption><button type="button" class="city-secondary" data-scene-reset>{es?'Borrar marcas':'Clear marks'}</button></figure>}<ol>{lesson.steps.map(step=><li>{step[locale]}</li>)}</ol><IslandWorkedDiagram locale={locale} lessonId={lesson.id}/><p>{lesson.misconception[locale]}</p><UpperPrimaryLab locale={locale} packageId={lesson.packageId}/></div></section>
 <section class="city-challenge">
 <p>{es?'Ahora te toca. Leé la pregunta y probá.':'Now it’s your turn. Read the question and try it.'}</p>
 {lesson.checks.map((check,i)=><div data-island-question={i} hidden={i!==0} data-answer={check.answer}><div data-island-reward-source hidden><HeroText text={mission.rewards[i][locale]}/></div><p class="city-kicker">{es?'DESAFÍO':'CHALLENGE'} {i+1} / {lesson.checks.length}</p><h2 tabindex="-1" data-island-question-title>{check.prompt[locale]}</h2>
 <IslandModel locale={locale} lessonId={lesson.id} question={i}/>
 <div class="city-answer-options" role="group" aria-label={check.prompt[locale]}>{check.options.map((option,j)=><button type="button" data-island-answer={j}>{option[locale]}</button>)}</div><p class="city-hint" data-island-hint hidden>{hints[i][locale]}</p><p class="city-hint" data-island-explanation hidden>{check.explanation[locale]}</p></div>)}
 <p class="city-feedback" data-island-feedback role="status" aria-live="polite"></p><div class="city-controls"><button type="button" class="city-secondary" data-island-help>{es?'Una pista':'A hint'}</button><button type="button" class="city-secondary" data-island-reset>{es?'Volver a jugar':'Play again'}</button><button type="button" class="city-primary" data-island-next hidden>{es?'Siguiente desafío':'Next challenge'} →</button><a class="city-primary" data-island-finish hidden href={next?buildSchoolLessonUrl(locale,'grade-4',next.id):'#island-celebration'}>{next?(es?'Siguiente misión':'Next mission'):(es?'¡Abrir el festival!':'Open the festival!')} →</a></div>
 </section>
 {lastInPackage && <details class="city-notebook" id="package-check"><summary>{es?'Un desafío extra: cinco preguntas':'An extra challenge: five questions'}</summary><div><GradeOneChecks locale={locale} checks={GRADE_FOUR_ASSESSMENTS[lesson.packageId]} id={`${lesson.packageId}-city-check`} assessment/></div></details>}
 <details class="city-notebook"><summary>{es?'Para explorar con un adulto':'Explore with a grown-up'}</summary><div><p>{lesson.warmup[locale]}</p><p>{lesson.exit[locale]}</p><p>{es?'Revisen juntos el dibujo y la explicación. Cada misión muestra una etapa de la historia; las respuestas no se guardan ni otorgan puntos de dominio. El nombre de la tripulación y el color del avión se guardan solo en este navegador.':'Review the drawing and explanation together. Each mission shows a stage of the story; answers are not saved and do not award mastery points. The crew name and plane color are saved only in this browser.'}</p></div></details>
 {!next && <section class="city-celebration" id="island-celebration" data-island-celebration hidden><p class="city-kicker">{es?'EL FESTIVAL DEL AEROCLUB':'THE AEROCLUB FESTIVAL'}</p><h2>{es?'¡La Golondrina volvió a casa!':'La Golondrina is home again!'}</h2><PlaneScene scene={{kind:'festival',stage:2}} locale={locale} preview/><p><HeroText text={es?'La Golondrina brilla frente al hangar, con el tapiz de Doña Elva en la cabina y el ala con sus parches. Los chicos se sientan en la cabina, en tierra, y siguen la ruta en el mapa: Obelisco, Iguazú, Humahuaca, Aconcagua, Perito Moreno, Ushuaia y Valdés. Nina le da a {name} la bitácora con sus 82 marcas. Rulo ya armó un nido nuevo sobre el cartel.':'La Golondrina shines in front of the hangar, with Doña Elva’s tapestry in the cockpit and the patched wing. Children sit in the cockpit, on the ground, and follow the route on the map: Obelisco, Iguazú, Humahuaca, Aconcagua, Perito Moreno, Ushuaia, and Valdés. Nina gives {name} the logbook with all 82 marks. Rulo has already built a new nest on the poster.'}/></p><a class="city-primary" href={buildGradeUrl(locale,'grade-4')}>{es?'Volver al mapa':'Back to the map'} →</a><details class="city-notebook"><summary>{es?'Proyecto en familia':'Family project'}</summary><div><p>{GRADE_FOUR_PROJECT.introduction[locale]}</p><ol>{GRADE_FOUR_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><ul>{GRADE_FOUR_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></div></details></section>}
 <noscript><p>{es?'Activá JavaScript para jugar. Podés leer los ejemplos del cuaderno sin activarlo.':'Enable JavaScript to play. You can read the notebook examples without it.'}</p></noscript>
</article>
<script>import '../../scripts/islandAdventure';</script>
