---
import { Locale, TopicId } from '../../math/core/types';

interface Props {
  topicId: TopicId;
  locale: Locale;
}

const { topicId, locale } = Astro.props;
---

<div class="card-subtle stack-md" data-interactive-diagram={topicId} data-locale={locale}>
  {topicId === 'addition-subtraction' && (
    <div class="stack-md">
      <div class="grid-2">
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Primer grupo (A)' : 'First group (A)'}</span>
            <span class="text-mono" id="add-label-a">27 (2×10 + 7)</span>
          </span>
          <input type="range" min="11" max="49" value="27" class="range-slider" id="add-input-a" />
        </label>
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Segundo grupo (B)' : 'Second group (B)'}</span>
            <span class="text-mono" id="add-label-b">15 (1×10 + 5)</span>
          </span>
          <input type="range" min="11" max="39" value="15" class="range-slider" id="add-input-b" />
        </label>
      </div>
      <svg
        id="add-svg"
        viewBox="0 0 620 190"
        style="width:100%;height:auto;background:#fff;border:1px solid var(--border-subtle);border-radius:8px;"
        role="img"
        aria-label={locale === 'es-AR' ? 'Diagrama interactivo de decenas y unidades' : 'Interactive base-10 tens and ones diagram'}
      ></svg>
    </div>
  )}

  {topicId === 'multiplication-division' && (
    <div class="stack-md">
      <div class="grid-2">
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Filas (grupos iguales)' : 'Rows (equal groups)'}</span>
            <span class="text-mono" id="mul-label-rows">3</span>
          </span>
          <input type="range" min="1" max="6" value="3" class="range-slider" id="mul-input-rows" />
        </label>
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Columnas (por fila)' : 'Columns (per row)'}</span>
            <span class="text-mono" id="mul-label-cols">4</span>
          </span>
          <input type="range" min="1" max="8" value="4" class="range-slider" id="mul-input-cols" />
        </label>
      </div>
      <svg
        id="mul-svg"
        viewBox="0 0 600 215"
        style="width:100%;height:auto;background:#fff;border:1px solid var(--border-subtle);border-radius:8px;"
        role="img"
        aria-label="3 × 4 = 12"
      ></svg>
    </div>
  )}

  {topicId === 'fractions' && (
    <div class="stack-md">
      <div class="grid-3">
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Numerador (partes pintadas)' : 'Numerator (shaded parts)'}</span>
            <span class="text-mono" id="frac-label-num">1</span>
          </span>
          <input type="range" min="1" max="4" value="1" class="range-slider" id="frac-input-num" />
        </label>
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Denominador (total partes)' : 'Denominator (equal parts)'}</span>
            <span class="text-mono" id="frac-label-den">4</span>
          </span>
          <input type="range" min="2" max="8" value="4" class="range-slider" id="frac-input-den" />
        </label>
        <div class="form-group" style="display:flex;align-items:flex-end;">
          <button type="button" class="btn btn-outline btn-sm" id="frac-btn-split" style="width:100%;">
            {locale === 'es-AR' ? 'Partir cada trozo ×2 (Equivalente)' : 'Split each slice ×2 (Equivalent)'}
          </button>
        </div>
      </div>
      <svg
        id="frac-svg"
        viewBox="0 0 620 195"
        style="width:100%;height:auto;background:#fff;border:1px solid var(--border-subtle);border-radius:8px;"
        role="img"
        aria-label="1/4"
      ></svg>
    </div>
  )}

  {topicId === 'negative-numbers' && (
    <div class="stack-md">
      <div class="grid-2">
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Posición inicial' : 'Starting position'}</span>
            <span class="text-mono" id="neg-label-start">-4</span>
          </span>
          <input type="range" min="-9" max="5" value="-4" class="range-slider" id="neg-input-start" />
        </label>
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Desplazamiento (+ der / − izq)' : 'Shift (+ right / − left)'}</span>
            <span class="text-mono" id="neg-label-delta">+7</span>
          </span>
          <input type="range" min="-6" max="9" value="7" class="range-slider" id="neg-input-delta" />
        </label>
      </div>
      <svg
        id="neg-svg"
        viewBox="0 0 620 175"
        style="width:100%;height:auto;background:#fff;border:1px solid var(--border-subtle);border-radius:8px;"
        role="img"
        aria-label="-4 + 7 = 3"
      ></svg>
    </div>
  )}

  {topicId === 'percentages-proportions' && (
    <div class="stack-md">
      <div class="grid-2">
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Porcentaje (%)' : 'Percentage (%)'}</span>
            <span class="text-mono" id="pct-label-val">25% (25/100)</span>
          </span>
          <input type="range" min="5" max="100" step="5" value="25" class="range-slider" id="pct-input-val" />
        </label>
        <label class="form-group">
          <span class="form-label">
            <span>{locale === 'es-AR' ? 'Cantidad Total (100%)' : 'Total Quantity (100%)'}</span>
            <span class="text-mono" id="pct-label-total">80</span>
          </span>
          <input type="range" min="20" max="200" step="20" value="80" class="range-slider" id="pct-input-total" />
        </label>
      </div>
      <svg
        id="pct-svg"
        viewBox="0 0 620 170"
        style="width:100%;height:auto;background:#fff;border:1px solid var(--border-subtle);border-radius:8px;"
        role="img"
        aria-label="25% of 80 = 20"
      ></svg>
    </div>
  )}
</div>

<script>
  import { initInteractiveDiagrams } from '../../scripts/learnInteractive';
  initInteractiveDiagrams();
</script>
