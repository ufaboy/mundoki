---
import type { Locale } from '../../math/core/types';
import { buildGradeOneLessonUrl } from '../../i18n/routes';
import TomiRoomBackground from './TomiRoomBackground.astro';
import TomiCharacter from './TomiCharacter.astro';
import GradeOneChecks from './GradeOneChecks.astro';
import { GRADE_ONE_ASSESSMENTS } from '../../content/grade1/assessments';
const { locale } = Astro.props as { locale: Locale };
const es = locale === 'es-AR';
const names = es ? ['Círculo', 'Estrella', 'Corazón', 'Cuadrado'] : ['Circle', 'Star', 'Heart', 'Square'];
---
<article class="tomi-adventure tomi-molds" data-molds-adventure data-locale={locale}>
  <nav class="tomi-topline" aria-label={es ? 'La aventura' : 'The adventure'}><a href={buildGradeOneLessonUrl(locale, 'G01-01-L02')}>← {es ? 'La mochila de Tomi' : 'Tomi’s backpack'}</a><span>{es ? 'LA GRAN PASEADA DE TOMI' : 'TOMI’S BIG DAY OUT'}</span><span class="tomi-chapter">03 / 35</span></nav>
  <header class="tomi-heading"><div><p>{es ? 'CAPÍTULO 1 · EN CASA' : 'CHAPTER 1 · AT HOME'}</p><h1>{es ? '¡Hagamos lugar!' : 'Let’s make room!'}</h1></div><span class="tomi-skill">✦ {es ? 'Mover no es agregar' : 'Moving is not adding'}</span></header>
  <div class="tomi-game">
    <div class="tomi-room molds-room" role="group" aria-label={es ? 'Tomi, cuatro moldes sobre una mesa y un cucharón de juguete detrás.' : 'Tomi, four molds on a table, and a toy scoop behind them.'}>
      <TomiRoomBackground />
      <TomiCharacter />
      <div class="tomi-speech" data-mold-speech>{es ? 'El cucharón quedó detrás de los moldes. ¡Separemos los cuatro para alcanzarlo!' : 'The scoop is behind the molds. Let’s spread the four molds out to reach it!'}</div>
      <div class="molds-table">
        <svg class="molds-scoop" viewBox="0 0 120 100" aria-hidden="true"><path d="M25 70 85 25" stroke="#b48d56" stroke-width="14" stroke-linecap="round"/><ellipse cx="90" cy="22" rx="24" ry="16" transform="rotate(-35 90 22)" fill="#739b9d"/><ellipse cx="90" cy="22" rx="15" ry="9" transform="rotate(-35 90 22)" fill="#a1c2be"/></svg>
        <div class="molds-row" role="group" aria-label={es ? 'Cuatro moldes para contar' : 'Four molds to count'}>
          {names.map((name, i) => <button type="button" class="mold-piece" data-mold-piece={i} aria-label={name} aria-pressed="false"><span class="mold-mark" aria-hidden="true">✓</span><svg viewBox="0 0 100 100" aria-hidden="true">
            {i === 0 && <><circle cx="50" cy="50" r="35" fill="#dc9270" stroke="#bc7959" stroke-width="4"/><circle cx="50" cy="50" r="25" fill="#f0b793"/></>}
            {i === 1 && <><path d="m50 8 13 27 30 5-22 21 5 30-26-14-26 14 5-30L7 40l30-5z" fill="#e1b14e" stroke="#c0943c" stroke-width="3"/><path d="m50 24 9 20 20 3-15 14 4 20-18-10-18 10 4-20-15-14 20-3z" fill="#f2ce76"/></>}
            {i === 2 && <path d="M50 85 17 52C-9 20 32 0 50 29 68 0 109 20 83 52z" fill="#c98c8c" stroke="#aa7276" stroke-width="4"/>}
            {i === 3 && <><rect x="16" y="16" width="68" height="68" rx="14" fill="#85a6a2" stroke="#648984" stroke-width="4"/><rect x="27" y="27" width="46" height="46" rx="7" fill="#b2cbc0"/></>}
          </svg><span class="mold-name">{name}</span></button>)}
        </div>
        <span class="molds-table-edge" aria-hidden="true"></span>
      </div>
      <div class="molds-arrange"><button type="button" data-mold-arrange>{es ? '↔ Separar los moldes' : '↔ Spread the molds out'}</button><span data-mold-layout>{es ? 'Juntos' : 'Close together'}</span></div>
      <div class="tomi-room-label">⌂ {es ? 'Un lugar para cada cosa' : 'A place for everything'}</div>
    </div>
    <section class="tomi-task" aria-labelledby="molds-question">
      <div class="tomi-task-heading"><span class="tomi-step" data-mold-step>1</span><div><p class="tomi-eyebrow" data-mold-eyebrow>{es ? 'MOVÉ, CONTÁ Y COMPARÁ' : 'MOVE, COUNT, AND COMPARE'}</p><h2 id="molds-question" data-mold-question>{es ? 'Separá los moldes. ¿Cuántos hay ahora?' : 'Spread the molds out. How many are there now?'}</h2></div></div>
      <p class="tomi-instruction" data-mold-instruction>{es ? 'Primero separalos con el botón. Podés tocar cada molde para contarlo.' : 'First use the button to spread them out. You can tap each mold to count it.'}</p>
      <div class="tomi-answers" data-mold-answers>{[4,8].map(n => <button type="button" data-mold-answer={n} disabled>{n}</button>)}</div>
      <div class="tomi-methods" data-mold-reasons hidden><button type="button" data-mold-reason="space">{es ? 'Porque la fila ocupa más lugar' : 'Because the row takes up more space'}</button><button type="button" data-mold-reason="same">{es ? 'Porque no agregamos ni sacamos moldes' : 'Because we did not add or remove any molds'}</button></div>
      <p class="tomi-feedback" data-mold-feedback role="status" aria-live="polite"></p>
      <div class="tomi-controls"><button type="button" class="tomi-help" data-mold-help>☀ {es ? 'Una pista' : 'A little hint'}</button><button type="button" class="tomi-help" data-mold-reset>{es ? 'Empezar de nuevo' : 'Start again'}</button><button type="button" class="tomi-continue" data-mold-next hidden>{es ? '¿Por qué? →' : 'Why? →'}</button><a class="tomi-continue" href={buildGradeOneLessonUrl(locale, 'G01-02-L01')} data-mold-finish hidden>{es ? 'Preparar las tizas →' : 'Get the chalk ready →'}</a></div>
    </section>
  </div>
  <div class="tomi-bottom"><span>♡ {es ? 'Sin apuro. Cada intento ayuda.' : 'Take your time. Every try helps.'}</span><span>{es ? 'Nuestra misión: alcanzar el cucharón.' : 'Our mission: reach the scoop.'}</span></div>
  <details class="tomi-adult"><summary>{es ? 'Para acompañar en casa' : 'For a grown-up'}</summary><p>{es ? 'Separar objetos no cambia su cantidad. Poné siete objetos en una fila y después en dos filas. Pedí que explique qué cambió y qué quedó igual. Esta escena no guarda progreso ni otorga puntos de dominio.' : 'Spreading objects out does not change their number. Put seven objects in one row, then in two rows. Ask what changed and what stayed the same. This scene does not save progress or award mastery points.'}</p></details>
  <details class="tomi-adult molds-review" id="package-check"><summary>{es ? 'Más práctica: contar objetos' : 'More practice: counting objects'}</summary><GradeOneChecks locale={locale} checks={GRADE_ONE_ASSESSMENTS['G01-01']} id="G01-01-check" assessment /></details>
  <noscript><p>{es ? 'Activá JavaScript para mover los moldes. También podés separar cuatro objetos reales y contarlos con un adulto.' : 'Enable JavaScript to move the molds. You can also spread out four real objects and count them with a grown-up.'}</p></noscript>
</article>
<script>import '../../scripts/tomiMoldsAdventure';</script>
