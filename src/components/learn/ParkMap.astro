---
import type {Locale} from '../../math/core/types';
import {PARK_CHAPTERS,PARK_MISSIONS} from '../../content/grade7/parkAdventure';
import {GRADE_SEVEN_LESSONS,GRADE_SEVEN_PROJECT} from '../../content/grade7';
import {buildCatalogUrl,buildSchoolLessonUrl} from '../../i18n/routes';
import ParkScene from './ParkScene.astro';
import ParkChoices from './ParkChoices.astro';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<div class="city-adventure city-map park-adventure" data-park-root data-park-map data-locale={locale}>
<nav class="city-top"><a href={buildCatalogUrl(locale)}>← {es?'Todos los grados':'All grades'}</a><span>{es?'7.º GRADO':'GRADE 7'}</span><a href="#park-families">{es?'Para familias':'For families'}</a></nav>
<header class="city-map-hero"><div><p class="city-kicker">{es?'DISEÑÁ · CONSTRUÍ · COMPROBÁ':'DESIGN · BUILD · CHECK'}</p><h1>{es?'Parque del Futuro':'Park of the Future'}</h1><p>{es?'Transformá un viejo complejo en un parque de ciencias y aventuras.':'Turn an old complex into a science and adventure park.'}</p><a class="city-primary" href={buildSchoolLessonUrl(locale,'grade-7',PARK_MISSIONS[0].id)}>{es?'¡Recibir las llaves!':'Get the keys!'} →</a><a class="city-pick" href="#park-missions">{es?'Elegir una misión ↓':'Choose a mission ↓'}</a></div><div class="city-map-preview"><span>{es?'Tu próxima aventura':'Your next adventure'}</span><ParkScene kind="opening" preview/></div></header>
<ParkChoices locale={locale}/>
<section id="park-missions"><div class="city-map-section"><h2 data-park-name-display>{es?'Mi parque':'My park'}</h2><span>{PARK_MISSIONS.length} {es?'misiones · todas disponibles':'missions · all available'}</span></div>
{PARK_CHAPTERS.map((chapter,i)=><details class="city-district" id={chapter.id.toLowerCase()} open={i===0}><summary><span class="city-district-icon" aria-hidden="true">{chapter.icon}</span><span><span class="city-kicker">{chapter.optional?(es?'TALLER OPCIONAL':'OPTIONAL WORKSHOP'):(es?'ETAPA':'CHAPTER')} {i+1}</span><strong>{chapter.title[locale]}</strong></span><span class="city-district-arrow" aria-hidden="true">⌄</span></summary><ol class="city-mission-list" start={PARK_MISSIONS.indexOf(chapter.missions[0])+1}>{chapter.missions.map(mission=><li><a data-park-mission-link={mission.id} href={buildSchoolLessonUrl(locale,'grade-7',mission.id)}><span class="city-mission-number">{PARK_MISSIONS.indexOf(mission)+1}</span><strong>{mission.title[locale]}</strong><span class="city-mission-play">{es?'Jugar':'Play'} →</span></a></li>)}</ol></details>)}
</section>
<aside class="city-map-finale"><span aria-hidden="true">🏗 🌿 🎉</span><div><h2>{es?'¡Una feria para todos!':'A fair for everyone!'}</h2><p>{es?'Abrí el parque y celebrá el final de la primaria con una feria.':'Open the park and celebrate the end of primary school with a fair.'}</p></div></aside>
<details class="city-notebook" id="park-families"><summary>{es?'Para familias: qué aprendemos':'For families: what we learn'}</summary><div><p>{es?'Argumentos, números racionales, proporciones, patrones, geometría y datos. Los talleres de fórmulas y azar son opcionales. Cada misión conserva los ejemplos, modelos y explicaciones del curso.':'Arguments, rational numbers, proportions, patterns, geometry, and data. Formula and chance workshops are optional. Every mission keeps the course examples, models, and explanations.'}</p><p>{es?'Todas las misiones están disponibles. Las escenas representan etapas de la historia, no un historial guardado. Las respuestas no se guardan ni otorgan puntos de dominio. Solo el nombre, el color y el emblema se recuerdan en este navegador.':'All missions are available. Scenes show story stages, not saved completion history. Answers are not saved and do not award mastery points. Only the name, color, and emblem are remembered in this browser.'}</p><ul>{PARK_CHAPTERS.map(chapter=><li><a href={buildSchoolLessonUrl(locale,'grade-7',chapter.missions[0].id)}>{GRADE_SEVEN_LESSONS.find(l=>l.packageId===chapter.id)!.objective[locale]}</a></li>)}</ul><section id="project"><h2>{GRADE_SEVEN_PROJECT.title[locale]}</h2><p>{GRADE_SEVEN_PROJECT.introduction[locale]}</p><ol>{GRADE_SEVEN_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es?'Cómo acompañar':'How to help'}</summary><ul>{GRADE_SEVEN_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>import '../../scripts/parkAdventure';</script>
