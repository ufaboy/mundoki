---
import type { Locale } from '../../math/core/types';
const { locale, lessonId } = Astro.props as { locale: Locale; lessonId: string };
const es = locale === 'es-AR';
---
{lessonId === 'G06-05-L02' && <div class="ocean-worked-diagrams">
 <figure><figcaption>{es?'1. Multiplicar: tomar la mitad de 3/4 L':'1. Multiply: take half of 3/4 L'}</figcaption>
 <svg viewBox="0 0 360 130" role="img" aria-label={es?'Un litro dividido en ocho partes. Tres cuartos ocupan seis partes; su mitad ocupa tres.':'One liter split into eight parts. Three quarters fill six parts; half of that fills three.'}>
 {[0,1].map(row => <g>{Array.from({length:8},(_,i)=><rect x={20+i*40} y={12+row*60} width="40" height="28" fill={i<(row===0?6:3)?'#267c78':'#fff'} stroke="#263c49"/>)}<text x="20" y={56+row*60}>{row===0?'3/4 L = 6/8 L':'1/2 × 3/4 L = 3/8 L'}</text></g>)}
 </svg></figure>
 <figure><figcaption>{es?'2. Dividir: contar vasos de 1/4 L en 3/4 L':'2. Divide: count 1/4 L cups in 3/4 L'}</figcaption>
 <svg viewBox="0 0 360 130" role="img" aria-label={es?'Tres vasos, cada uno con un cuarto de litro, contienen tres cuartos de litro en total.':'Three cups, each holding one quarter liter, contain three quarters of a liter altogether.'}>
 {[0,1,2].map(i=><g><rect x={20+i*110} y="15" width="90" height="55" rx="5" fill="#d9eeec" stroke="#263c49"/><text x={65+i*110} y="48" text-anchor="middle">1/4 L</text></g>)}
 <text x="20" y="108">3/4 ÷ 1/4 = 3 {es?'vasos':'cups'}</text></svg></figure>
 </div>}
{lessonId === 'G06-11-L03' && <figure>
 <figcaption>{es?'Los mismos datos: A = 50 y B = 55. Mirá dónde empieza cada eje.':'The same data: A = 50 and B = 55. Look at where each axis starts.'}</figcaption>
 <div class="ocean-worked-diagrams">{[0,49].map(base=><svg viewBox="0 0 300 260" role="img" aria-label={es?`Barras de 50 y 55 con eje desde ${base}.`:`Bars for 50 and 55 with an axis starting at ${base}.`}>
 <text x="150" y="24" text-anchor="middle">{es?'Eje desde':'Axis from'} {base}</text>
 {(base===0?[0,10,20,30,40,50,60]:[49,50,51,52,53,54,55]).map(v=>{const y=210-(v-base)*(base===0?2.5:25);return <g><path d={`M 50 ${y} H 270`} stroke="#c0cbd0"/><text x="42" y={y+5} text-anchor="end">{v}</text></g>;})}
 {[50,55].map((v,i)=><g><rect x={85+i*100} y={210-(v-base)*(base===0?2.5:25)} width="50" height={(v-base)*(base===0?2.5:25)} fill={i===0?'#267c78':'#79572f'}/><text x={110+i*100} y={202-(v-base)*(base===0?2.5:25)} text-anchor="middle">{v}</text><text x={110+i*100} y="234" text-anchor="middle">{i===0?'A':'B'}</text></g>)}
 <path d="M 50 45 V 210 H 270" stroke="#263c49" fill="none"/>
 {base===49&&<><path d="M 45 215 l 10 5 l -10 5 l 10 5" fill="none" stroke="#263c49"/><text x="150" y="255" text-anchor="middle">{es?'Se omite de 0 a 49':'0 to 49 is omitted'}</text></>}
 </svg>)}</div>
 <p>{es?'Izquierda: cada intervalo vale 10. Derecha: cada intervalo vale 1 y se omite de 0 a 49. Las barras visibles de la derecha miden 1 y 6 unidades, pero los datos siguen siendo 50 y 55. La diferencia sigue siendo 5.':'Left: each interval is 10. Right: each interval is 1, and 0 to 49 is omitted. The visible bars on the right measure 1 and 6 units, but the values are still 50 and 55. The difference is still 5.'}</p>
 </figure>}
<style>
.ocean-worked-diagrams{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1rem;margin:1rem 0}
figure{margin:1rem 0}figcaption{font-weight:700}svg{width:100%;height:auto;background:#fff;border-radius:8px}text{font:15px sans-serif;fill:#20313d}
</style>
