---
import type {Locale} from '../../math/core/types';
import {MOON_CHAPTERS,MOON_MISSIONS} from '../../content/grade5/moonAdventure';
import {GRADE_FIVE_PACKAGES,GRADE_FIVE_LESSONS,GRADE_FIVE_PROJECT} from '../../content/grade5';
import HeroText from '../shared/HeroText.astro';
import {buildCatalogUrl,buildSchoolLessonUrl} from '../../i18n/routes';
import MoonScene from './MoonScene.astro';
import MoonChoices from './MoonChoices.astro';
const {locale}=Astro.props as {locale:Locale};const es=locale==='es-AR';
---
<div class="city-adventure city-map moon-adventure" data-moon-root data-moon-map data-locale={locale}>
<nav class="city-top"><a href={buildCatalogUrl(locale)}>← {es?'Todos los grados':'All grades'}</a><span>{es?'5.º GRADO':'GRADE 5'}</span><a href="#moon-families">{es?'Para familias':'For families'}</a></nav>
<header class="city-map-hero"><div><p class="city-kicker">{es?'DE LA TIERRA A FOBOS Y DE VUELTA':'FROM EARTH TO PHOBOS AND BACK'}</p><h1>{es?'Misión Cóndor':'The Cóndor Mission'}</h1><p><HeroText text={es?'{name} construye una nave en Base Patagonia, vuela a la Luna, a Marte y a su luna Fobos, y vuelve a casa. Cada respuesta correcta suma una pieza o un tramo del viaje.':'{name} builds a spaceship at Base Patagonia, flies to the Moon, to Mars and its moon Phobos, and comes home. Every correct answer adds a part or a step of the trip.'}/></p><a class="city-primary" href={buildSchoolLessonUrl(locale,'grade-5',MOON_MISSIONS[0].id)}>{es?'¡Abrir el hangar!':'Open the hangar!'} →</a><a class="city-pick" href="#moon-missions">{es?'Elegir una misión ↓':'Choose a mission ↓'}</a></div><div class="city-map-preview"><span>{es?'Tu próxima aventura':'Your next adventure'}</span><MoonScene kind="flight" preview/></div></header>
<MoonChoices locale={locale}/>
<section id="moon-missions"><div class="city-map-section"><h2 data-moon-name-display>{es?'Misión Cóndor':'Cóndor mission'}</h2><span>{MOON_MISSIONS.length} {es?'misiones · todas disponibles':'missions · all available'}</span></div>
{MOON_CHAPTERS.map((chapter,i)=><details class="city-district" id={chapter.id} open={i===0}><summary><span class="city-district-icon" aria-hidden="true">{chapter.icon}</span><span><span class="city-kicker">{es?'ETAPA':'CHAPTER'} {i+1}</span><strong>{chapter.title[locale]}</strong></span><span class="city-district-arrow" aria-hidden="true">⌄</span></summary><p class="moon-chapter-opening">{chapter.opening[locale]}</p><ol class="city-mission-list" start={MOON_MISSIONS.indexOf(chapter.missions[0])+1}>{chapter.missions.map(mission=><li><a data-moon-mission-link={mission.id} href={buildSchoolLessonUrl(locale,'grade-5',mission.id)}><span class="city-mission-number">{MOON_MISSIONS.indexOf(mission)+1}</span><strong>{mission.title[locale]}</strong><span class="city-mission-play">{es?'Jugar':'Play'} →</span></a></li>)}</ol></details>)}
</section>
<aside class="city-map-finale"><span aria-hidden="true">🚀 🌕 🌎</span><div><h2>{es?'¡La Tierra nos espera!':'Earth is waiting!'}</h2><p>{es?'La aventura termina con el regreso del equipo y una bienvenida.':'The adventure ends with the team returning home to a welcome celebration.'}</p></div></aside>
<details class="city-notebook" id="moon-families"><summary>{es?'Para familias: qué aprendemos':'For families: what we learn'}</summary><div><p>{es?'Cálculo con números naturales, fracciones, decimales, medidas, figuras y datos (5.º grado de la primaria de CABA). Cada desafío es un paso de la misión: la respuesta decide qué pasa en la nave.':'Whole-number calculation, fractions, decimals, measurement, shapes, and data (CABA primary, 5th grade). Every challenge is a step of the mission: the answer decides what happens to the ship.'}</p><p>{es?'Todas las misiones están disponibles. Las escenas representan etapas de la historia, no un historial guardado. Las respuestas no se guardan ni otorgan puntos de dominio. Solo el nombre, el color y el emblema se recuerdan en este navegador.':'All missions are available. Scenes show story stages, not saved completion history. Answers are not saved and do not award mastery points. Only the name, color, and emblem are remembered in this browser.'}</p><ul>{GRADE_FIVE_PACKAGES.map(p=><li><a href={buildSchoolLessonUrl(locale,'grade-5',GRADE_FIVE_LESSONS.find(l=>l.packageId===p.id)!.id)}>{p.title[locale]}</a></li>)}</ul><section id="project"><h2>{GRADE_FIVE_PROJECT.title[locale]}</h2><p>{GRADE_FIVE_PROJECT.introduction[locale]}</p><ol>{GRADE_FIVE_PROJECT.tasks.map(task=><li>{task[locale]}</li>)}</ol><details><summary>{es?'Cómo acompañar':'How to help'}</summary><ul>{GRADE_FIVE_PROJECT.rubric.map(item=><li>{item[locale]}</li>)}</ul></details></section></div></details>
</div>
<script>import '../../scripts/moonAdventure';</script>
<style>.moon-chapter-opening{margin:0 1rem .75rem;line-height:1.5}</style>
