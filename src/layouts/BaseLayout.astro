---
// Legacy layout (global.css). Pages move to AppLayout one by one; until then
// they share the same header, menu and footer through SiteHeader / SiteFooter.
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import DesignHead from '../components/shared/DesignHead.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import { Locale } from '../math/core/types';
import { t } from '../i18n/translations';
import type { SiteNavId } from '../i18n/routes';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  activeNav?: SiteNavId;
  switchLocaleHref?: string;
}

const {
  locale = 'es-AR',
  title,
  description = locale === 'en-US'
    ? 'Mundoki — Visual-first mathematics learning and space adventure platform for Primary and Secondary School.'
    : 'Mundoki — Plataforma de matemática visual y aventura espacial para Escuela Primaria y Secundaria.',
  activeNav = 'home',
  switchLocaleHref,
} = Astro.props;
---

<!doctype html>
<html lang={locale} class="mk-legacy">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | Mundoki</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} | Mundoki`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <DesignHead />
  </head>
  <body>
    <a href="#main-content" class="mk-skip">{t(locale, 'skipToContent')}</a>
    <SiteHeader locale={locale} activeNav={activeNav} />

    <main id="main-content" class="main-container">
      <slot />
    </main>

    <SiteFooter locale={locale} switchLocaleHref={switchLocaleHref} />
  </body>
</html>
